re lleva `self`\\n# como primer parámetro (`self` representa al propio objeto de la clase).\\nclass TestCargarDatos:\\n    \\\"\\\"\\\"Tests de la función cargar_homicidios_raw().\\\"\\\"\\\"\\n\\n    def test_csv_existe(self):\\n        \\\"\\\"\\\"Verifica que el archivo CSV fuente existe.\\\"\\\"\\\"\\n        # `assert condicion, \\\"mensaje\\\"` → comprueba que `condicion` sea True.\\n        # Si es False, detiene la prueba y muestra el mensaje de error.\\n        assert ARCHIVO_HOMICIDIOS_CSV.exists(), (\\n            f\\\"No se encontró el CSV fuente: {ARCHIVO_HOMICIDIOS_CSV}\\\"\\n        )\\n\\n    def test_carga_exitosa(self):\\n        \\\"\\\"\\\"Verifica que la\n<truncated 3936 bytes>","Overwrite":"true","Path":"\"D:\\\\Tesis\\\\tests\\\\test_ingesta.py\""}},{"name":"write_file","args":{"Content":"\"\\\"\\\"\\\"\\ntest_normalizar_texto.py — Tests para la Fase 2: Limpieza y Normalización Textual.\\n\\nVerifica que:\\n1. La función normalizar_texto() elimine correctamente tildes, eñes y diéresis.\\n2. La función normalizar_columna() opere sobre pd.Series completas.\\n3. El pipeline normalizar_todas_columnas() procese las 13 columnas.\\n4. La auditoría de caracteres detecte problemas antes y confirme limpieza después.\\n\\\"\\\"\\\"\\nimport pytest\\nimport pandas as pd\\n\\nfrom src.utils.texto import (\\n    normalizar_texto,\\n    normalizar_columna,\\n    contiene_caracteres_especiales,\\n    PATRON_CARACTERES_ESPECIALES,\\n)\\nfrom src.ingesta.config import COLUMNAS_TEXTO_NORMALIZAR\\nfrom src.limpieza.normalizar_texto import normalizar_todas_columnas\\nfrom src.reportes.auditoria_caracteres import auditar_caracteres_especiales\\n\\n\\n# =========================================================================\\n# TESTS UNITARIOS: normalizar_texto() — Función escalar\\n# =========================================================================\\n# Un \\\"test unitario\\\" prueba UNA sola pieza pequeña de código (una función)\\n# de manera aislada, co