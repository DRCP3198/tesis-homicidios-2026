ue almacenan las rutas de las carpetas en tu disco duro (D:) \r\n26: # para no tener que escribir toda la ruta cada vez que abramos un archivo.\r\n27: repositorio <- \"D:/R/preprocesamiento_dat\n<truncated 37640 bytes>\ncundario de auditoría horaria de registros informáticos.\r\n593:     AUX_MINUTO_SISTEMA   = X209          # Campo secundario de auditoría de minutos de sistemas internos.\r\n594:   )\r\n595: \r\n596: ### 2. Bloque de escritura seguro y actualización del repositorio\r\n597: setwd(repositorio)\r\n598: \r\n599: archivo_csv <- \"homi_Final_Continental_Etiquetado.csv\"\r\n600: archivo_rds <- \"homi_Final_Continental_Etiquetado.rds\"\r\n601: \r\n602: # Eliminar versiones viejas bloqueadas si existen\r\n603: # tryCatch() es un escudo contra errores. Si el archivo CSV está abierto por un usuario en Microsoft Excel, \r\n604: # Excel bloquea el disco duro e impide que R lo modifique. tryCatch evita que el programa colapse por completo \r\n605: # emitiendo una alerta amigable en la consola en lugar de un mensaje de error fatal.\r\n606: if (file.exists(archivo_csv)) {\r\n607:   tryCatch(file.remove(archivo_csv), error = function(e) {\r\n608:     print(\"Nota: Si el CSV está abierto en Excel, ciérralo para actualizar los cambios.\")\r\n609:   })\r\n610: }\r\n611: \r\n612: # Grabado final de la información procesada\r\n613: # Guardamos los archivos definitivos completamente pulidos, renombrados y limpios para el consumo de los usuarios finales.\r\n614: write.csv(homi_Analisis_Final, archivo_csv, row.names = FALSE)\r\n615: saveRDS(homi_Analisis_Final, file = archivo_rds)\r\n616: \r\n617: print(\"=========================================================================\")\r\n618: print(\"   ¡PASO 13 COMPLETADO: BASE DE DATOS MAESTRA GENERADA EXITOSAMENTE!   \")\r\n619: print(\"=========================================================================\")\r\n620: print(paste(\"-> Registros consolidados exportados:\", nrow(homi_Analisis_Final)))\r\n621: print(paste(\"-> Columnas limpias seleccionadas:\", ncol(homi_Analisis_Final)))\r\n622: print(\"=========================================================================\")\r\n623: \r\n624: # Comandos de control final para diagnosticar la salud y completitud de la base final limpia.\r\n625: summary(homi_Analisis_Final)\r\n626: str(homi_Analisis_Final)\r\n627: \r","truncated_fields":["content"]}
