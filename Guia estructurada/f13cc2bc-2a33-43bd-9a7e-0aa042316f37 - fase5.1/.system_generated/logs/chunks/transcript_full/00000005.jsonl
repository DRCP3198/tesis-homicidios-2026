==================\n# ARCHIVOS DE SALIDA INTERMEDIA\n# =========================================================================\n# Cada fase guarda su resultado en un archivo .parquet dentro de data/interim/.\n# Parquet es un formato binario, comprimido y que respeta los tipos de datos\n# (reemplaza al .rds de R). Es mucho más rápido de leer que un CSV.\nINTERIM_RENOMBRADO = INTERIM_DIR / \"homi_renombrado.parquet\"        # Salida Fase 1\nINTERIM_NORMALIZADO = INTERIM_DIR / \"homi_normalizado.parquet\"      # Salida Fase 2\nINTERIM_FILTRADO = INTERIM_DIR / \"homi_filtrado_2024.parquet\"       # Salida Fase 3\nINTERIM_GEO_CORRECTOS = INTERIM_DIR / \"geo_correctos.parquet\"       # Salida Fase 4\n\n# =========================================================================\n# ARCHIVOS DE SALIDA FINAL\n# =========================================================================\n# Archivos definitivos que se generarán en la Fase 5 (exportación final).\nSALIDA_CSV_FINAL = PROCESSED_DIR / \"homi_Final_Continental_Etiquetado.csv\"\nSALIDA_PARQUET_FINAL = PROCESSED_DIR / \"homi_Final_Continental_Etiquetado.parquet\"\n# .gpkg = GeoPackage: formato moderno de mapas en un solo archivo (reemplaza al .shp).\nSALIDA_GPKG_FINAL = PROCESSED_DIR / \"homi_final.gpkg\"\n","Overwrite":true,"Path":"D:\\Tesis\\src\\ingesta\\config.py"}}]}
{"step_index":157,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-06T16:30:39Z","content":"Created At: 2026-11-06T11:30:39-05:00\nCompleted At: 2026-11-06T11:30:39-05:00\nCreated file."}
{"step_index":158,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-06T16:30:39Z","input_tokens":4873,"cache_read_tokens":241956,"output_tokens":3388,"content":"Ahora [texto.py](file:///D:/Tesis/src/utils/texto.py) (las utilidades de limpieza de texto):","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\ntexto.py — Funciones utilitarias reutilizables de limpieza de strings.\n\nCentraliza las operaciones de normalización textual que se repiten\na lo largo del pipeline (strip, upper, remove accents).\n\nEquivalencia R:\n    iconv(str_to_upper(str_trim(x)), to = \"ASCII//TRANSLIT\")\n\nDependencia:\n    unidecode >= 1.3  (definida en requirements.txt)\n\n¿Por qué está en \"utils\" (utilidades)?\n    Porque estas funciones NO pertenecen a una sola fase: se usan en la\n    Fase 2 (normalizar columnas de la base de datos) y también en la\n    Fase 4 (normalizar los nombres de cantones del mapa). Tenerlas en un\n    solo lugar evita copiar y pegar código.\n\"\"\"\n# `re` = librería estándar de Python para \"expresiones regulares\" (regex).\n# Una regex es un patrón de búsqueda de texto. Ej: \"[áé]\" significa\n# \"busca una á o una é en cualquier parte del texto\".\nimport re\n\n# `pandas` es LA librería de análisis de datos en Python (equivale a dplyr/tidyverse).\n# `as pd` le pone un apodo corto: en lugar de escribir pandas.Series escribimos pd.Series.\nimport pandas as pd\n\n# `unidecode` es una librería externa (se instala con pip) que convierte\n# caracteres especiales a su versión ASCII más parecida: á→a, ñ→n, ü→u.\nfrom unidecode import unidecode\n\n\n# =========================================================================\n# FUNCIÓN ESCALAR: normaliza un string individual\n# =========================================================================\n# \"Escalar\" significa que trabaja con UN SOLO valor a la vez (un texto),\n# no con una columna entera.\n#\n# Anatomía de la definición de una función:\n#   def                 → palabra clave para DEFINIR (crear) una función.\n#   normalizar_texto    → el nombre de la función.\n#   (texto: str)        → recibe un parámetro llamado \"texto\". El \": str\" es\n#                         un \"type hint\" (pista de tipo): indica que se espera\n#                         un string (texto). Python NO lo obliga, es documentación.\n#   -> str              → indica que la función DEVUELVE un string.\ndef normalizar_texto(texto: str) -> str:\n    # Lo que va entre triple comillas al inicio de una función se llama\n    # \"docstring\": es la documentación oficial de la función. Se puede ver\n    # escribiendo help(normalizar_texto) en la consola de Python.\n    \"\"\"\n    Normaliza una cadena de texto individual:\n    1. strip() — Remueve espacios al inicio y final (≡ str_trim)\n    2. upper() — Convierte a mayúsculas (≡ str_to_upper)\n    3. unidecode() — Transliteración ASCII (≡ iconv to ASCII//TRANSLIT)\n\n    Parameters\n    ----------\n    texto : str\n        Cadena de texto a normalizar.\n\n    Returns\n    -------\n    str\n        Texto limpio: sin espacios extremos, en mayúsculas, sin tildes.\n\n    Examples\n    --------\n    >>> normalizar_texto(\"  Guayaquíl  \")\n    'GUAYAQUIL'\n    >>> normalizar_texto(\"Ñuño\")\n    'NUNO'\n    >>> normalizar_texto(\"SANTO DOMINGO DE LOS TSÁCHILAS\")\n    'SANTO DOMINGO DE LOS TSACHILAS'\n    \"\"\"\n    # Si no es string (NaN, None, int), devolvemos tal cual\n    # para que pandas lo trate como NA sin lanzar error.\n    # isinstance(valor, tipo) → devuelve True si \"valor\" es del \"tipo\" indicado.\n    # `not` invierte el resultado: \"si texto NO es un string...\".\n    if not isinstance(texto, str):\n        return texto  # `return` termina la función y devuelve ese valor.\n\n    # 1. Strip (≡ str_trim en R)\n    # elimina todos los espacios en blanco \n    # (así como tabulaciones \\t o saltos de línea \\n) \n    # que se encuentren al principio y al final\n    # Ej: \"  Quito  \" → \"Quito\"   (los espacios del medio NO se tocan)\n    texto = texto.strip()\n\n    # 2. Upper (≡ str_to_upper en R)\n    # Convierte todas las letras a MAYÚSCULAS. Ej: \"Quito\" → \"QUITO\"\n    texto = texto.upper()\n\n    # 3. Transliteración ASCII (≡ iconv(x, to=\"ASCII//TRANSLIT\") en R)\n    # unidecode convierte: á→a, é→e, ñ→n, ü→u, etc.\n    # Ej: \"GUAYAQUÍL\" → \"GUAYAQUIL\",  \"CAÑAR\" → \"CANAR\"\n    texto = unidecode(texto)\n\n    return texto  # Devolvemos el texto ya limpio.\n\n\n# =========================================================================\n# FUNCIÓN VECTORIZADA: normaliza una columna completa de pandas\n# =========================================================================\n# \"Vectorizada\" significa que trabaja sobre una columna completa de una vez,\n# en lugar de valor por valor escrito a mano con un for.\ndef normalizar_columna(serie: pd.Series) -> pd.Series: #estructura de datos unidimensional (de pandas) que funciona como una columna\n    \"\"\"\n    Aplica la normalización textual completa a una columna (pd.Series).\n\n    Cadena de transformaciones (en una sola operación vectorizada):\n        strip()  →  upper()  →  unidecode()\n\n    Equivalencia R:\n        mutate(columna = iconv(str_to_upper(str_trim(columna)),\n                               to = \"ASCII//TRANSLIT\"))\n\n    Parameters\n    ----------\n    serie : pd.Series\n        Columna de texto a normalizar. Los valores NA se preservan.\n\n    Returns\n    -------\n    pd.Series\n        Columna normalizada: mayúsculas, sin tildes, sin espacios extremos.\n\n    Examples\n    --------\n    >>> import pandas as pd\n    >>> s = pd.Series([\"  Guayaquíl  \", \"Ñuño\", None, \"QUITO\"])\n    >>> normalizar_columna(s).tolist()\n    ['GUAYAQUIL', 'NUNO', None, 'QUITO']\n    \"\"\"\n    # .map(funcion) → recorre CADA valor de la columna y le aplica la función\n    #                 indicada, devolviendo una nueva columna con los resultados.\n    #                 Es como un for automático: para cada celda, normalizar_texto(celda).\n    #                 OJO: se pasa el NOMBRE de la función sin paréntesis\n    #                 (normalizar_texto, no normalizar_texto()), porque no la\n    #                 ejecutamos nosotros: se la entregamos a .map() para que él la use.\n    # na_action=\"ignore\" → si una celda está vacía (NaN/None), NO le aplica la\n    #                      función y la deja vacía tal cual (evita errores).\n    return serie.map(normalizar_texto, na_action=\"ignore\") #agara mi serie pandas y ejecuta un map\n\n\n# =========================================================================\n# FUNCIÓN DE VERIFICACIÓN: detecta caracteres especiales residuales\n# =========================================================================\n# Patrón Regex idéntico al del código R (línea 158):\n# patron_especial <- \"[áéíóúÁÉÍÓÚñÑüÜ]\"\n#\n# Explicación del patrón:\n#   r\"...\"  → la \"r\" delante significa \"raw string\" (texto crudo): Python NO\n#             interpreta las barras invertidas \"\\\" como caracteres especiales.\n#             Es buena práctica usarla SIEMPRE en expresiones regulares.\n#   [ ... ] → en regex, los corchetes significan \"CUALQUIERA de estos caracteres\".\n#             Así, el patrón coincide si el texto tiene al menos UNA tilde, eñe o diéresis.\n#   \": str\" → type hint para indicar que esta constante es un texto.\nPATRON_CARACTERES_ESPECIALES: str = r\"[áéíóúÁÉÍÓÚñÑüÜ]\"\n\n\ndef contiene_caracteres_especiales(texto: str) -> bool:\n    \"\"\"\n    Verifica si un texto contiene tildes, eñes u otros caracteres especiales.\n\n    Equivalencia R:\n        grepl(\"[áéíóúÁÉÍÓÚñÑüÜ]\", texto)\n\n    Parameters\n    ----------\n    texto : str\n        Cadena a verificar.\n\n    Returns\n    -------\n    bool\n        True si contiene caracteres especiales.\n    \"\"\"\n    # Si el valor no es texto (ej: NaN o un número), no puede tener tildes.\n    if not isinstance(texto, str):\n        return False\n\n    # re.search(patron, texto) → busca el patrón en CUALQUIER parte del texto.\n    #   - Si lo encuentra, devuelve un objeto \"Match\" (coincidencia).\n    #   - Si no lo encuentra, devuelve None (nada).\n    # bool(...) → convierte ese resultado en True/False:\n    #   un objeto Match se convierte en True, None se convierte en False.\n    return bool(re.search(PATRON_CARACTERES_ESPECIALES, texto))\n","Overwrite":true,"Path":"D:\\Tesis\\src\\utils\\texto.py"}}]}
{"step_index":159,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-06T16:31:08Z","content":"Created At: 2026-11-06T11:31:08-05:00\nCompleted At: 2026-11-06T11:31:08-05:00\nCreated file."}
{"step_index":160,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-06T16:31:08Z","input_tokens":3516,"cache_read_tokens":246765,"output_tokens":4107,"content":"Ahora [cargar_datos.py](file:///D:/Tesis/src/ingesta/cargar_datos.py) (Fase 1):","tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\ncargar_datos.py — Módulo de ingesta y renombrado de datos.\n\nEquivale a las Fases 1-3 (líneas 1-77) del código R original:\n  - readRDS(nombre_archivo) → pd.read_csv(...)\n  - rename(nuevo = original) → df.rename(columns=MAPEO_COLUMNAS)\n\nFunciones principales:\n  - cargar_homicidios_raw(): Lee el CSV fuente, aplica tipos y renombra columnas.\n  - guardar_intermedio_renombrado(): Guarda el resultado en Parquet.\n  - cargar_intermedio_renombrado(): Vuelve a leer ese Parquet.\n\"\"\"\n# pandas: librería principal de manejo de tablas de datos (DataFrames).\nimport pandas as pd\n\n# Traemos constantes definidas en config.py (rutas y diccionario de nombres).\n# Los paréntesis permiten importar varias cosas escribiendo una por línea.\nfrom src.ingesta.config import (\n    ARCHIVO_HOMICIDIOS_CSV,    # Constante de ruta y nombre del archivo original de homicidios\n    MAPEO_COLUMNAS,            # diccionario para reetiquetado de las columnas\n    INTERIM_RENOMBRADO,        # Constante de la ruta y nombre para guardar el archivo intermedio\n)\n\n# Defino la funcion mediante \"def\", ingresa tipo string o None, y por defeto es None.abs\n# DataFrame es basicamente un tipo de dato compuesto, donde puedo manejar columnas, filas, etc \n#\n# Detalle de la firma de la función:\n#   ruta_csv: str | None  → el parámetro puede ser un texto (str) O nada (None).\n#                           La barra \"|\" significa \"o\".\n#   = None                → valor por defecto: si llamo cargar_homicidios_raw()\n#                           sin argumentos, ruta_csv valdrá None.\n#   -> pd.DataFrame       → la función devuelve una tabla de pandas.\ndef cargar_homicidios_raw(ruta_csv: str | None = None) -> pd.DataFrame:\n    \"\"\"\n    Lee el archivo CSV fuente de homicidios y renombra las columnas.\n\n    Equivalencia R:\n        homi_2010_2025_raw <- readRDS(nombre_archibo_original_rds)\n        homi_2010_2025 <- homi_2010_2025_raw %>% rename(...)\n\n    Parameters\n    ----------\n    ruta_csv : str or None\n        Ruta al archivo CSV. Si es None, usa la ruta por defecto de config.py.\n\n    Returns\n    -------\n    pd.DataFrame\n        DataFrame con las 21 columnas renombradas a nombres descriptivos.\n\n    Raises\n    ------\n    ValueError\n        Si al CSV le falta alguna de las 21 columnas esperadas.\n    \"\"\"\n    # El operador `or` devuelve el primer valor \"verdadero\":\n    #   - Si ruta_csv tiene un texto → se usa ese texto.\n    #   - Si ruta_csv es None (falso) → se usa ARCHIVO_HOMICIDIOS_CSV.\n    ruta = ruta_csv or ARCHIVO_HOMICIDIOS_CSV #Ingreso una ruta especifica o toma la constante de config.py \n\n    print(\"=\" * 60) #imprime una linea de 60 signos de igual\n    print(\"  FASE 1: INGESTA Y RENOMBRADO DE DATOS\")\n    print(\"=\" * 60) #imprime una linea de 60 signos de igual\n    print(f\"  Leyendo: {ruta}\") #Usamos f-string (la 'f' al inicio) para incrustar variables y expresiones\n\n    # ── Lectura del CSV con tipos explícitos ──\n    # Leemos TODO como string inicialmente para evitar que pandas\n    # interprete mal las coordenadas corruptas (ej: \"214589\" sin punto).\n    # La conversión de tipos se hará en fases posteriores de forma controlada.\n    #\n    # pd.read_csv(...) → lee un archivo CSV y lo convierte en un DataFrame (tabla).\n    df = pd.read_csv(\n        ruta,                # Ruta del archivo a leer.\n        dtype=str,           # Leer todo como texto (equivale a stringsAsFactors=FALSE en R)\n        encoding=\"utf-8\",    # Encoding estándar (permite leer tildes y eñes correctamente)\n        na_values=[\"\", \"NA\", \"N/A\", \"null\", \"NULL\"],  # Valores que R trata como NA\n        # ↑ Cualquier celda con alguno de estos textos se considerará \"vacía\" (NaN).\n    )\n\n    # len(df) → cuenta el número de FILAS de la tabla (equivale a nrow() en R).\n    # {valor:,} → formatea el número con separador de miles: 47739 → 47,739\n    print(f\"  Registros cargados: {len(df):,}\")\n    # df.columns → los nombres de las columnas. list(...) los convierte en lista para imprimir.\n    print(f\"  Columnas originales ({len(df.columns)}): {list(df.columns)}\")\n\n    # ── Verificar que todas las columnas esperadas existen ──\n    columnas_faltantes = set(MAPEO_COLUMNAS.keys()) - set(df.columns) #del diccionario verifico, comparando las llaves con las del csv\n    #set me sirve para comparar colecciones de datos, en este caso los nombres de las columnas\n    # en caso de no haver alguna coincidencia, lanza un error. E imprime las faltantes\n    #\n    # Detalle:\n    #   MAPEO_COLUMNAS.keys() → las claves del diccionario (\"X2\", \"X4\", ...).\n    #   set(...)              → convierte a \"conjunto\" (colección sin repetidos\n    #                           que permite operaciones matemáticas de conjuntos).\n    #   A - B                 → \"diferencia\": elementos que están en A pero NO en B.\n    #   Resultado: las columnas que esperábamos y que NO vinieron en el CSV.\n    #\n    # `if columnas_faltantes:` → un conjunto vacío se evalúa como False,\n    # y uno con elementos como True. Entra al if solo si falta alguna columna.\n    if columnas_faltantes:\n        # `raise` lanza (provoca) un error a propósito y detiene el programa.\n        # ValueError es el tipo de error para \"valor inválido\".\n        raise ValueError(\n            f\"Columnas faltantes en el CSV: {columnas_faltantes}. \"\n            f\"Columnas disponibles: {list(df.columns)}\"\n        )\n\n    # ── Renombrar columnas (equivale a dplyr::rename()) ──\n    # df.rename(columns=diccionario) → cambia el nombre de cada columna según\n    # el diccionario {nombre_viejo: nombre_nuevo}. Devuelve una tabla NUEVA,\n    # por eso la volvemos a guardar en `df`.\n    df = df.rename(columns=MAPEO_COLUMNAS) #agaro mi dataframe y le aplico el diccionario clave valor\n\n    # ── Seleccionar solo las columnas mapeadas (descartar extras si existen) ──\n    # MAPEO_COLUMNAS.values() → los valores del diccionario (\"codigo_caso\", ...).\n    columnas_finales = list(MAPEO_COLUMNAS.values()) #obtengo los valores del diccionario\n    # df[lista_de_columnas] → selecciona solo esas columnas y en ese orden\n    # (equivale a select() en R).\n    df = df[columnas_finales] #selecciono solo las columnas mapeadas\n\n    print(f\"  Columnas renombradas ({len(df.columns)}): {list(df.columns)}\")\n    print(f\"  Primeras 3 filas:\")\n    # df.head(3)        → toma las 3 primeras filas (equivale a head(df, 3) en R).\n    # .to_string(index=False) → convierte la tabla a texto para imprimir,\n    #                           sin mostrar la columna de índice (0, 1, 2...).\n    print(df.head(3).to_string(index=False))\n    print(\"=\" * 60)\n\n    return df  # Devolvemos la tabla ya renombrada.\n\n\n# `-> None` indica que la función NO devuelve nada; solo realiza una acción\n# (en este caso, guardar un archivo en disco).\ndef guardar_intermedio_renombrado(df: pd.DataFrame) -> None:\n    \"\"\"\n    Guarda el DataFrame renombrado en formato Parquet en data/interim/.\n\n    Parameters\n    ----------\n    df : pd.DataFrame\n        DataFrame con columnas ya renombradas.\n    \"\"\"\n\n    #Guarda ya renombrado bonito\n    # INTERIM_RENOMBRADO.parent → la carpeta que contiene al archivo (data/interim).\n    # .mkdir(...) → crea esa carpeta.\n    #   parents=True  → crea también las carpetas superiores si no existen.\n    #   exist_ok=True → si la carpeta ya existe, no lanza error.\n    INTERIM_RENOMBRADO.parent.mkdir(parents=True, exist_ok=True) #Si no existe la carpeta, la crea.\n    # df.to_parquet(...) → guarda la tabla en formato Parquet (equivale a saveRDS en R).\n    #   index=False      → no guarda la columna de índice numérico de las filas.\n    #   engine=\"pyarrow\" → la librería que se encarga de escribir el archivo.\n    df.to_parquet(INTERIM_RENOMBRADO, index=False, engine=\"pyarrow\") #lo guarda \n    print(f\"  Guardado intermedio: {INTERIM_RENOMBRADO}\")\n    # .stat() → obtiene información del archivo en disco.\n    # .st_size → su tamaño en bytes. Dividido para 1024 → kilobytes (KB).\n    # {valor:.1f} → muestra el número con 1 decimal.\n    print(f\"  Tamaño: {INTERIM_RENOMBRADO.stat().st_size / 1024:.1f} KB\")\n\n\ndef cargar_intermedio_renombrado() -> pd.DataFrame:\n    \"\"\"\n    Carga el archivo Parquet intermedio de datos renombrados.\n\n    Returns\n    -------\n    pd.DataFrame\n        DataFrame previamente renombrado y guardado.\n\n    Raises\n    ------\n    FileNotFoundError\n        Si el archivo intermedio todavía no ha sido generado.\n    \"\"\"\n    # .exists() → devuelve True si el archivo existe en disco.\n    # `not` lo invierte: entra al if cuando el archivo NO existe.\n    if not INTERIM_RENOMBRADO.exists(): \n        # FileNotFoundError = tipo de error estándar para \"archivo no encontrado\".\n        raise FileNotFoundError(\n            f\"No existe el archivo intermedio: {INTERIM_RENOMBRADO}. \"\n            \"Ejecuta primero cargar_homicidios_raw() y guardar_intermedio_renombrado().\"\n        )\n    # pd.read_parquet(...) → lee el archivo Parquet y lo devuelve como DataFrame\n    # (equivale a readRDS en R).\n    return pd.read_parquet(INTERIM_RENOMBRADO, engine=\"pyarrow\") #devuelvo mi tipo parquet renombrado\n","Overwrite":true,"Path":"D:\\Tesis\\src\\ingesta\\cargar_datos.py"}}]}
