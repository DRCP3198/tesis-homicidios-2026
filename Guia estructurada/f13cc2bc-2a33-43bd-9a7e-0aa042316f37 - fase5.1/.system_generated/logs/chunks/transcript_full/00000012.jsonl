{"step_index":336,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T01:22:01Z","content":"Created At: 2026-11-09T20:22:01-05:00\nCompleted At: 2026-11-09T20:22:01-05:00\nShowing lines 172-251 of 251\n172: \n173: # =========================================================================\n174: # ESQUEMA CONSOLIDADO DE 21 COLUMNAS FINALES (Fase 5)\n175: # =========================================================================\n176: # Orden oficial de las 21 columnas limpias según docs/diccionario_datos.md\n177: # y la arquitectura del proyecto (equivale al dplyr::select() de R Fase 13).\n178: COLUMNAS_FINALES_21 = [\n179:     \"codigo_caso\",           # 1.  str/string — Identificador policial codificado\n180:     \"tipo_delito\",           # 2.  category   — Tipificación legal\n181:     \"fecha_hecho\",           # 3.  datetime64 — Fecha exacta (YYYY-MM-DD)\n182:     \"anio_hecho\",            # 4.  Int64      — Año de ocurrencia (2010-2024)\n183:     \"mes_hecho\",             # 5.  category   — Mes del suceso\n184:     \"dia_semana\",            # 6.  category   — Día de la semana\n185:     \"hora_aproximada\",       # 7.  float64    — Hora decimal aproximada del evento\n186:     \"provincia\",             # 8.  category   — Nombre oficial de la provincia\n187:     \"canton\",                # 9.  category   — Nombre oficial del cantón\n188:     \"zona_tipo\",             # 10. category   — Urbano / Rural / SD\n189:     \"lugar_especifico\",      # 11. category   — Espacio de la agresión\n190:     \"tipo_arma\",             # 12. category   — Instrumento del deceso\n191:     \"motivacion_detalle\",    # 13. category   — Causa hipotética\n192:     \"causa_especifica\",      # 14. category   — Detalle fáctico del móvil\n193:     \"edad_victima\",          # 15. float64    — Edad en años (admite decimales en lactantes)\n194:     \"sexo_victima\",          # 16. category   — Género biológico\n195:     \"nacionalidad_victima\",  # 17. category