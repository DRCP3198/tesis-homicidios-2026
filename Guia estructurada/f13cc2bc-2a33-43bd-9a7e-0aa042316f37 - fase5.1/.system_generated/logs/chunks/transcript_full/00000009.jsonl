mporta las funciones de normalización de texto (strip + upper + unidecode)\\n31: # y la auditoría de caracteres especiales (tildes, eñes, diéresis).\\n32: from src.limpieza.normalizar_texto import (\\n33:     normalizar_todas_columnas,\\n34:     guardar_intermedio_normalizado,\\n35: )\\n36: from src.reportes.auditoria_caracteres import auditar_caracteres_especiales\\n37: \\n38: # ── Imports Fase 3: Filtrado temporal y geográfico ──\\n39: # Importa las funciones de filtrado por año y exclusión de Galápagos,\\n40: # así como el reporte de control que audita los conteos en cada paso.\\n41: from src.limpieza.filtros import (\\n42:     convertir_anio_a_entero,\\n43:     excluir_galapagos,\\n44:     filtrar_anio,\\n45:     guardar_insular,\\n46:     guardar_in\\n<truncated 4844 bytes>\\necto, geo_corregir_decimales = separar_por_formato(\\n146:         geo_corregir\\n147:     )\\n148: \\n149:     # Paso 4.6: Algoritmo reparador de coordenadas corruptas (4 escenarios)\\n150:     # Prueba en orden: X.XXX → 0.XXX → -X.XXX → -0.XXX y valida cada intento con sjoin.\\n151:     esc1, esc2, esc3, esc4, no_reparados = reparar_coordenadas_corruptas(\\n152:         geo_corregir_decimales, mapa\\n153:     )\\n154:     # Suma total de casos rescatados entre los 4 escenarios.\\n155:     n_reparados_total = sum(len(d) for d in [esc1, esc2, esc3, esc4])\\n156: \\n157:     # Paso 4.7: Ensamblaje y limpieza final\\n158:     # Une correctos + reparados + limbo, borra columnas auxiliares y filtra NaN.\\n159:     df_georreferenciado = ensamblar_base_final(\\n160:         geo_correctos=geo_correctos,\\n161:         reparados_esc1=esc1,\\n162:         reparados_esc2=esc2,\\n163:         reparados_esc3=esc3,\\n164:         reparados_esc4=esc4,\\n165:         limbo_formato_correcto=limbo_formato_correcto,\\n166:         no_reparados=no_reparados,\\n167:     )\\n168: \\n169:     # Paso 4.8: Exportar artefactos Parquet\\n170:     # Guarda geo_correctos.parquet (interim) y homi_georreferenciado.parq