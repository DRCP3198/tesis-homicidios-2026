on_detalle   = iconv(str_to_upper(str_trim(motivacion_detalle)), to = \"ASCII//TRANSLIT\"),\r\n109:     \r\n110:     # Limpieza de Causa Específica\r\n111:     causa_especifica     = iconv(str_to_upper(str_trim(causa_especifica)), to = \"ASCII//TRANSLIT\"),\r\n112:     \r\n113:     # Limpieza de Sexo de la Víctima\r\n114:     sexo_victima         = iconv(str_to_upper(str_trim(sexo_victima)), to = \"ASCII//TRANSLIT\"),\r\n115:     \r\n116:     # Limpieza de Nacionalidad de la Víctima\r\n117:     nacionalidad_victima = iconv(str_to_upper(str_trim(nacionalidad_victima)), to = \"ASCII//TRANSLIT\"),\r\n118:     \r\n119:     # Limpieza de Cantón\r\n120:     canton               = iconv(str_to_upper(str_trim(canton)), to = \"ASCII//TRANSLIT\"),\r\n121:     \r\n122:     # Limpieza de Mes del Hecho\r\n123:     mes_hecho            = iconv(str_to_upper(str_trim(mes_hecho)), to = \"ASCII//TRANSLIT\"),\r\n124:     \r\n125:     # Limpieza de Día de la Semana\r\n126:     dia_semana           = iconv(str_to_upper(str_trim(dia_semana)), to = \"ASCII//TRANSLIT\"),\r\n127:     \r\n128:     # Limpieza de Provincia\r\n129:     provincia            = iconv(str_to_upper(str_trim(provincia)), to = \"ASCII//TRANSLIT\")\r\n130:   )\r\n131: \r\n132: ## Exclusión estricta de registros temporales (Filtro Año <= 2024)\r\n133: homi_2010_2024 <- homi_2010_2025 %>% \r\n134:   # as.numeric() transforma el año a formato numérico puro para poder hacer comparaciones matemáticas.\r\n135:   mutate(anio_hecho = as.numeric(anio_hecho)) %>% \r\n136:   # filter() conserva únicamente las filas con años menores o iguales a 2024 (descarta 2025).\r\n137:   filter(anio_hecho <= 2024) %>% \r\n138:   # drop_na() elimina registros en caso de que existan valores vacíos (NA) en el año.\r\n139:   drop_na(anio_hecho)\r\n140: \r\n141: \r\n142: ## FILTRO CRÍTICO: Exclusión simétrica de la Región Insular (Galápagos)\r\n143: # El operador ! junto con %in% significa: \"Fíltra y quédate con todo lo que NO pertenezca a este listado\".\r\n144: # Gráficamente: El mapa de Ecuador continental es compacto, pero Galápagos está muy alejado en el Pacífico.\r\n145: # Si dejas puntos en Galápagos, al hacer el mapa final, la escala se estirará tanto que el continente se verá diminuto.\r\n146: homi_2010_2024_continental <- homi_2010_2024 %>%\r\n147:   filter(!canton %in% c(\"GALAPAGOS\", \"ISABELA\", \"SANTA CRUZ\", \"SAN CRISTOBAL\"))\r\n148: \r\n149: homi_2010_2024_insular <- homi_2010_2024 %>%\r\n150:   filter(canton %in% c(\"GALAPAGOS\", \"ISABELA\", \"SANTA CRUZ\", \"SAN CRISTOBAL\"))\r\n151: \r\n152: # =========================================================================\r\n153: # AUDITORÍA DE CARACTERES ESPECIALES (TILDES Y EÑES OCULTAS)\r\n154: # =========================================================================\r\n155: print(\"--- BUSCANDO TILDES, EÑES O CARACTERES ESPECIALES ---\")\r\n156: \r\n157: # Patrón Regex para capturar eñes (mayúsculas/minúsculas) y cualquier letra con tilde o diéresis\r\n158: patron_especial <- \"[áéíóúÁÉÍÓÚñÑüÜ]\"\r\n159: \r\n160: # Identificar cuáles columnas son de tipo texto (character)\r\n161: columnas_texto <- names(homi_2010_2024)[sapply(homi_2010_2024, is.character)]\r\n162: hallazgos <- FALSE\r\n163: \r\n164: # Bucle para revisar columna por columna\r\n165: for (col in columnas_texto) {\r\n166:   # Buscamos las filas que cumplan con el patrón especial\r\n167:   filas_con_problemas <- which(grepl(patron_especial, homi_2010_2024[[col]]))\r\n168:   \r\n169:   if (length(filas_con_problemas) > 0) {\r\n170:     hallazgos <- TRUE\r\n171:     print(paste0(\"⚠️ Columna encontrada: '\", col, \"'\"))\r\n172:     \r\n173:     # Mostramos los primeros 5 registros con problemas en esa columna\r\n174:     for (fila in head(filas_con_problemas, 5)) {\r\n175:       print(paste0(\"   - Fila [\", fila, \"]: '\", homi_2010_2024[[col]][fila], \"'\"))\r\n176:     }\r\n177:     if (length(filas_con_problemas) > 5) {\r\n178:       print(paste0(\"   ... y \", length(filas_con_problemas) - 5, \" registros más en esta columna.\"))\r\n179:     }\r\n180:     print(\"------------------------------------------------\")\r\n181:   }\r\n182: }\r\n183: \r\n184: if (!hallazgos) {\r\n185:   print(\"¡Felicidades! 🎉 No se encontraron eñes ni tildes ocultas en las columnas de texto.\")\r\n186: }\r\n187: \r\n188: \r\n189: # =========================================================================\r\n190: # FASE 4: AUDITORÍA DE CONTROL - CONTEOS INICIALES\r\n191: # =========================================================================\r\n192: ## Diagnóstico por consola del volumen de registros\r\n193: # print() escribe mensajes en la consola. paste() une textos y cálculos en una sola línea legible.\r\n194: # nrow() cuenta la cantidad de filas (registros de homicidios) que tiene el dataframe en ese instante.\r\n195: print(\"--- CONTEO TOTAL DE REGISTROS ---\")\r\n196: print(paste(\"Datos originales cargados (con 2025):\", nrow(homi_2010_2025)))\r\n197: print(paste(\"Datos procesados actuales (SOLO Continental hasta 2024):\", nrow(homi_2010_2024)))\r\n198: print(paste(\"Registros excluidos (2025 + Galápagos):\", nrow(homi_2010_2025) - nrow(homi_2010_2024)))\r\n199: \r\n200: print(\"--- VALORES ÚNICOS PROCESADOS (CANTONES) ---\")\r\n201: # unique() analiza la columna y extrae una lista sin repetidos de los cantones presentes.\r\n202: # head(..., 20) nos muestra los primeros 20 cantones en la consola para revisar visualmente que no tengan tildes ni errores.\r\n203: print(head(unique(homi_2010_2024$CANTON_HECHO), 150))\r\n204: \r\n205: # =========================================================================\r\n206: # FASE 5: PREPARACIÓN CARTOGRÁFICA DEL MAPA BASE\r\n207: # =========================================================================\r\n208: ## Cambio temporal al repositorio de mapas\r\n209: # Cambiamos de carpeta de trabajo temporalmente para leer los archivos de cartografía.\r\n210: setwd(repositorio_carto)\r\n211: \r\n212: ## Carga del archivo Shapefile cantonal\r\n213: # read_sf() lee el archivo \"nxcantones.shp\" (el mapa) y lo carga como un objeto espacial con geometrías de polígonos.\r\n214: Provincia <- read_sf(\"nxcantones.shp\")\r\n215: # st_transform() proyecta las coordenadas del mapa. El CRS 4326 corresponde a WGS84 (coordenadas geográficas estándar \r\n216: # basadas en Latitud y Longitud, usadas por los GPS mundiales).\r\n217: Provincia <- st_transform(Provincia, crs = 4326) \r\n218: \r\n219: ## Reparar geometrías inválidas (vértices duplicados, auto-intersecciones)\r\n220: # st_make_valid() corrige internamente los polígonos del mapa que tengan líneas cruzadas o nodos duplicados.\r\n221: # Gráficamente: \"Sana\" los bordes de los cantones en el mapa digital para que los algoritmos de colisión geométrica no fallen.\r\n222: Provincia <- st_make_valid(Provincia)\r\n223: \r\n224: ## Homologación del texto en la cartografía del mapa\r\n225: Provincia <- Provincia %>% \r\n226:   # Creamos una columna estandarizada en el mapa (CANTON_MAPA) limpiando la columna original del mapa (DPA_DESCAN).\r\n227:   mutate(CANTON_MAPA = iconv(str_to_upper(str_trim(DPA_DESCAN)), to = \"ASCII//TRANSLIT\")) %>% \r\n228:   # Removemos Galápagos y zonas no delimitadas del mapa base para alinearlo perfectamente con nuestra base de datos.\r\n229:   filter(DPA_DESPRO != \"GALAPAGOS\", DPA_DESPRO != \"ZONA NO DELIMITADA\")\r\n230: \r\n231: # =========================================================================\r\n232: # FASE 6: CONVERSIÓN ESPACIAL DE PUNTOS ORIGINALES\r\n233: # =========================================================================\r\n234: ## Depuración primaria de registros sin coordenadas numéricas\r\n235: homi_2010_2024_fin <- homi_2010_2024 %>%\r\n236:   # Forzamos las columnas crudas de texto \"X21\" y \"X22\" a convertirse en números decimales puros (Latitud y Longitud).\r\n237:   mutate(\r\n238:     lat.new = as.numeric(X21),\r\n239:     lon.new = as.numeric(X22)\r\n240:   ) %>% \r\n241:   # !is.na() significa \"que NO sea un valor nulo/vacío\". Eliminamos registros sin coordenadas porque es imposible mapearlos.\r\n242:   filter(!is.na(lat.new) & !is.na(lon.new))\r\n243: \r\n244: ## Creación de un Identificador Único Temporal de Control\r\n245: # Generamos una secuencia numérica del 1 hasta el total de filas. Esto le da una \"cédula de identidad\" única \r\n246: # e irrepetible a cada fila de homicidio para rastrearla a lo largo de los algoritmos de validación espacial.\r\n247: homi_2010_2024_fin$ID.temp <- 1:nrow(homi_2010_2024_fin)\r\n248: \r\n249: ## Estructuración geométrica vectorial del dataset de homicidios\r\n250: # data.frame() crea una tabla simple únicamente con los componentes del eje Y (Latitud) y eje X (Longitud).\r\n251: point_analisis <- data.frame(\r\n252:   y = homi_2010_2024_fin$lat.new,\r\n253:   x = homi_2010_2024_fin$lon.new\r\n254: )\r\n255: # st_as_sf() transforma la tabla simple de coordenadas en un objeto puramente geográfico (SF).\r\n256: # coords = c(\"x\", \"y\") define los ejes, y crs = st_crs(Provincia) le hereda el mismo sistema de proyección del mapa de cantones.\r\n257: # Gráficamente: Transforma números planos en \"puntos flotantes espaciales\" listos para interactuar con los polígonos del mapa.\r\n258: point_analisis <- st_as_sf(point_analisis, coords = c(\"x\", \"y\"), crs = st_crs(Provincia)) \r\n259: # Le inyectamos el ID de control al objeto geográfico para saber a qué delito le pertenece cada punto en el espacio.\r\n260: point_analisis$ID.temp <- homi_2010_2024_fin$ID.temp\r\n261: \r\n262: # =========================================================================\r\n263: # FASE 7: PRIMERA AUDITORÍA TOPOLÓGICA (PERTENENCIA POLIGONAL)\r\n264: # =========================================================================\r\n265: ## Indexación de cantones únicos para optimizar el bucle iterativo\r\n266: cantones.puntos <- unique(homi_2010_2024_fin$CANTON_HECHO) \r\n267: correctos <- c() # Inicializamos un vector vacío que actuará como una \"canasta\" para guardar los ID de los casos que pasen la prueba.\r\n268: \r\n269: ## Bucle de intersección espacial Cantón por Cantón\r\n270: # for() ejecutará un ciclo repetitivo desde el primer cantón hasta el último (longitud del vector).\r\n271: for(j in 1:length(cantones.puntos)) {\r\n272:   # Filtramos los homicidios que de forma escrita dicen pertenecer al cantón actual de la iteración.\r\n273:   base.canton <- homi_2010_2024_fin %>% filter(CANTON_HECHO == cantones.puntos[j])\r\n274:   # Filtramos el polígono geométrico (el dibujo en el mapa) que corresponde al mismo cantón.\r\n275:   poligono.canton <- Provincia %>% filter(CANTON_MAPA == cantones.puntos[j])\r\n276:   \r\n277:   # Si existen tanto el polígono en el mapa como registros en la base de datos de texto, entramos a evaluar:\r\n278:   if(nrow(poligono.canton) > 0 & nrow(base.canton) > 0) {\r\n279:     # Extraemos los puntos geográficos de esos casos específicos usando sus IDs de control.\r\n280:     puntos.evaluar <- point_analisis %>% filter(ID.temp %in% base.canton$ID.temp)\r\n281:     # st_intersects() evalúa colisiones espaciales. Retorna una matriz lógica (TRUE/FALSE) indicando si el punto cae dentro del polígono.\r\n282:     aux.dentro.polig <- st_intersects(puntos.evaluar, poligono.canton, sparse = FALSE)\r\n283:     # apply(..., 1, any) revisa fila por fila de la matriz y detecta los puntos que dieron TRUE (que están dentro del polígono).\r\n284:     dentro.polig <- puntos.evaluar[apply(aux.dentro.polig, 1, any), ]\r\n285:     # c() concatena (acumula) los IDs de los registros correctos dentro de nuestra canasta de control.\r\n286:     correctos <- c(correctos, dentro.polig$ID.temp)\r\n287:   }\r\n288: }\r\n289: \r\n290: ## Subdivisión: Dataset de Coordenadas Perfectas de Origen\r\n291: # Filtramos la base original quedándonos solo con los casos cuyos IDs demostraron caer dentro de su cantón real.\r\n292: geo_correctos <- homi_2010_2024_fin %>% filter(ID.temp %in% correctos)\r\n293: # Calculamos el porcentaje de efectividad de digitación inicial de la base de datos dividiendo los correctos para el total.\r\n294: print(paste0(\"Calidad de data inicial perfecta: \", round(nrow(geo_correctos)/nrow(homi_2010_2024_fin), 4)*100, \"%\"))\r\n295: \r\n296: ## Subdivisión: Dataset del Limbo de Revisión Extrema\r\n297: # Filtramos la base original con el operador !, obteniendo los registros con coordenadas corruptas o inconsistentes.\r\n298: geo.corregir.master <- homi_2010_2024_fin %>% filter(!(ID.temp %in% correctos))\r\n299: \r\n300: # =========================================================================\r\n301: # FASE 8: ALGORITMO TEXTUAL REPARADOR DE DÍGITOS DECIMALES\r\n302: # =========================================================================\r\n303: ## Desactivación de S2 para mitigar conflictos geométricos de topología esférica\r\n304: # sf_use_s2(FALSE) le ordena a R apagar el motor geométrico global de Google (S2) que asume que la Tierra es una esfera perfecta.\r\n305: # Al apagarlo, R calcula las intersecciones sobre un plano cartesiano plano bidimensional regular, evitando errores matemáticos severos.\r\n306: sf_use_s2(FALSE) \r\n307: \r\n308: ## PROTECCIÓN ESPACIAL: Separación de registros según formato de cadena\r\n309: # grepl() busca patrones de texto. Buscamos un punto decimal \"\\\\.\" en la columna de latitud.\r\n310: # Si tiene punto, es un registro con formato digital normal (pero que cayó fuera del cantón por desborde de fronteras políticas).\r\n311: limbo_formato_correcto <- geo.corregir.master %>% filter(grepl(\"\\\\.\", as.character(lat.new)))\r\n312: # Si NO tiene punto decimal, es un registro corrupto grave (ej: un número entero continuo como \"-214589\" en lugar de \"-2.14589\").\r\n313: geo.corregir.1 <- geo.corregir.master %>% filter(!grepl(\"\\\\.\", as.character(lat.new)))\r\n314: \r\n315: ## Limpieza e inicialización de cadenas numéricas corruptas\r\n316: if(nrow(geo.corregir.1) > 0) {\r\n317:   geo.corregir.1 <- geo.corregir.1 %>% \r\n318:     mutate(\r\n319:       # gsub() busca un carácter y lo destruye o reemplaza. Aquí eliminamos todos los puntos viejos y signos menos de la cadena de texto\r\n320:       # para dejar una tira limpia de números puros sobre la cual operar matemáticamente mediante reconstrucción posicional.\r\n321:       limpia.lat = gsub(\"\\\\.\", \"\", as.character(lat.new)),\r\n322:       limpia.lat = gsub(\"-\", \"\", limpia.lat),\r\n323:       limpia.lat = as.numeric(limpia.lat)\r\n324:     )\r\n325: }\r\n326: \r\n327: ## Definición de contenedores para la reclasificación por iteración\r\n328: # Creamos variables vacías para almacenar los homicidios que vayamos rescatando según el tipo de reparación decimal que requieran.\r\n329: correctos3 <- c()\r\n330: geo.corregir.1a <- data.frame()\r\n331: geo.corregir.1b <- data.frame()\r\n332: geo.corregir.1f <- data.frame()\r\n333: geo.corregir.1g <- data.frame()\r\n334: \r\n335: ## Bucle de reestructuración matemática de posiciones de caracteres\r\n336: if(nrow(geo.corregir.1) > 0) {\r\n337:   # Este bucle simula escenarios de errores comunes de digitación (falta de puntos o signos en zonas específicas del Ecuador)\r\n338:   for(i in 1:10) {\r\n339:     \r\n340:     ### Escenario de reconstrucción decimal 1: Formato \"X.XXXXXX\" (Positivo)\r\n341:     # Reconstruye el número asumiendo coordenadas al norte de la Línea Equinoccial (Ecuador Septentrional positivo).\r\n342:     if(i == 1) {\r\n343:       geo.corregir.1 <- geo.corregir.1 %>% mutate(\r\n344:         lat.1 = str_sub(limpia.lat, 1, 1), # Extrae el primer dígito numérico.\r\n345:         lat.leng = str_length(limpia.lat),  # Mide cuántos caracteres de longitud tiene la cadena limpia.\r\n346:         lat.2 = str_sub(limpia.lat, 2, lat.leng), # Extrae todo el bloque numérico restante desde la posición 2.\r\n347:         lat.final = paste0(lat.1, \".\", lat.2) # Inserta artificialmente un punto decimal en medio de ambos bloques de texto.\r\n348:       )\r\n349:       # Reconstruimos la tabla espacial efímera con el nuevo eje Y reparado textualmente y el eje X original.\r\n350:       point_analisis_c1 <- data.frame(y = as.numeric(geo.corregir.1$lat.final), x = geo.corregir.1$lon.new)   \r\n351:       if(nrow(point_analisis_c1) > 0) {\r\n352:         point_analisis_c1 <- st_as_sf(point_analisis_c1, coords = c(\"x\", \"y\"), crs = st_crs(Provincia))  \r\n353:         point_analisis_c1$ID.temp <- geo.corregir.1$ID.temp\r\n354:         cantones.c1 <- unique(geo.corregir.1$CANTON_HECHO)\r\n355:         \r\n356:         # Volvemos a probar con st_intersects si esta reparación matemática hizo que el punto aterrice dentro de su cantón.\r\n357:         for(j in 1:length(cantones.c1)) {\r\n358:           base.c1 <- geo.corregir.1 %>% filter(CANTON_HECHO == cantones.c1[j])\r\n359:           poly.c1 <- Provincia %>% filter(CANTON_MAPA == cantones.c1[j])\r\n360:           if(nrow(poly.c1) > 0 & nrow(base.c1) > 0) {\r\n361:             pts.eval <- point_analisis_c1 %>% filter(ID.temp %in% base.c1$ID.temp)\r\n362:             dentro <- pts.eval[apply(st_intersects(pts.eval, poly.c1, sparse = FALSE), 1, any), ]\r\n363:             correctos3 <- c(correctos3, dentro$ID.temp)\r\n364:           }\r\n365:         }\r\n366:         # Los casos rescatados por este escenario se guardan en \"geo.corregir.1a\".\r\n367:         geo.corregir.1a <- geo.corregir.1 %>% filter(ID.temp %in% correctos3)\r\n368:         # Los casos que siguen fallando se quedan en \"geo.corregir.1\" para ser evaluados en el siguiente escenario.\r\n369:         geo.corregir.1 <- geo.corregir.1 %>% filter(!(ID.temp %in% correctos3))\r\n370:       }\r\n371:     }\r\n372:     \r\n373:     ### Escenario de reconstrucción decimal 2: Formato \"0.XXXXXX\" (Positivo)\r\n374:     # Diseñado para coordenadas extremadamente pegadas al norte de la Línea Equinoccial que inician con cero absoluto.\r\n375:     if(i == 2) {\r\n376:       geo.corregir.1 <- geo.corregir.1 %>% mutate(\r\n377:         lat.1 = str_sub(limpia.lat, 1, 1),\r\n378:         lat.leng = str_length(limpia.lat),\r\n379:         lat.2 = str_sub(limpia.lat, 2, lat.leng),\r\n380:         lat.final = paste0(0, \".\", lat.1, lat.2) # Fuerza la inserción de un prefijo estricto \"0.\"\r\n381:       )\r\n382:       point_analisis_c2 <- data.frame(y = as.numeric(geo.corregir.1$lat.final), x = geo.corregir.1$lon.new)   \r\n383:       if(nrow(point_analisis_c2) > 0) {\r\n384:         point_analisis_c2 <- st_as_sf(point_analisis_c2, coords = c(\"x\", \"y\"), crs = st_crs(Provincia))  \r\n385:         point_analisis_c2$ID.temp <- geo.corregir.1$ID.temp\r\n386:         cantones.c2 <- unique(geo.corregir.1$CANTON_HECHO)\r\n387:         for(j in 1:length(cantones.c2)) {\r\n388:           base.c2 <- geo.corregir.1 %>% filter(CANTON_HECHO == cantones.c2[j])\r\n389:           poly.c2 <- Provincia %>% filter(CANTON_MAPA == cantones.c2[j])\r\n390:           if(nrow(poly.c2) > 0 & nrow(base.c2) > 0) {\r\n391:             pts.eval <- point_analisis_c2 %>% filter(ID.temp %in% base.c2$ID.temp)\r\n392:             dentro <- pts.eval[apply(st_intersects(pts.eval, poly.c2, sparse = FALSE), 1, any), ]\r\n393:             correctos3 <- c(correctos3, dentro$ID.temp)\r\n394:           }\r\n395:         }\r\n396:         geo.corregir.1b <- geo.corregir.1 %>% filter(ID.temp %in% correctos3)\r\n397:         geo.corregir.1 <- geo.corregir.1 %>% filter(!(ID.temp %in% correctos3))\r\n398:       }\r\n399:     }\r\n400:     \r\n401:     ### Escenario de reconstrucción decimal 6: Formato \"-X.XXXXXX\" (Negativo - Hemisferio Sur)\r\n402:     # ESCENARIO HISTÓRICAMENTE CRÍTICO PARA ECUADOR: La inmensa mayoría del territorio continental ecuatoriano \r\n403:     # (Guayaquil, Cuenca, Amazonía) está en el Hemisferio Sur, por ende, su latitud DEBE comenzar obligatoriamente con un signo MENOS.\r\n404:     if(i == 6) {\r\n405:       geo.corregir.1 <- geo.corregir.1 %>% mutate(\r\n406:         lat.1 = str_sub(limpia.lat, 1, 1),\r\n407:         lat.leng = str_length(limpia.lat),\r\n408:         lat.2 = str_sub(limpia.lat, 2, lat.leng),\r\n409:         lat.final = paste0(\"-\", lat.1, \".\", lat.2) # Inserta el signo negativo y el punto decimal correspondiente.\r\n410:       )\r\n411:       point_analisis_c6 <- data.frame(y = as.numeric(geo.corregir.1$lat.final), x = geo.corregir.1$lon.new)   \r\n412:       if(nrow(point_analisis_c6) > 0) {\r\n413:         point_analisis_c6 <- st_as_sf(point_analisis_c6, coords = c(\"x\", \"y\"), crs = st_crs(Provincia))  \r\n414:         point_analisis_c6$ID.temp <- geo.corregir.1$ID.temp\r\n415:         cantones.c6 <- unique(geo.corregir.1$CANTON_HECHO)\r\n416:         for(j in 1:length(cantones.c6)) {\r\n417:           base.c6 <- geo.corregir.1 %>% filter(CANTON_HECHO == cantones.c6[j])\r\n418:           poly.c6 <- Provincia %>% filter(CANTON_MAPA == cantones.c6[j])\r\n419:           if(nrow(poly.c6) > 0 & nrow(base.c6) > 0) {\r\n420:             pts.eval <- point_analisis_c6 %>% filter(ID.temp %in% base.c6$ID.temp)\r\n421:             dentro <- pts.eval[apply(st_intersects(pts.eval, poly.c6, sparse = FALSE), 1, any), ]\r\n422:             correctos3 <- c(correctos3, dentro$ID.temp)\r\n423:           }\r\n424:         }\r\n425:         geo.corregir.1f <- geo.corregir.1 %>% filter(ID.temp %in% correctos3)\r\n426:         geo.corregir.1 <- geo.corregir.1 %>% filter(!(ID.temp %in% correctos3))\r\n427:       }\r\n428:     }\r\n429:     \r\n430:     ### Escenario de reconstrucción decimal 7: Formato \"-0.XXXXXX\" (Negativo - Proximidad Línea Equinoccial)\r\n431:     # Orientado para las provincias y cantones inmediatamente ubicados al sur de la línea del Ecuador que inician con \"-0.\"\r\n432:     if(i == 7) {\r\n433:       geo.corregir.1 <- geo.corregir.1 %>% mutate(\r\n434:         lat.1 = str_sub(limpia.lat, 1, 1),\r\n435:         lat.leng = str_length(limpia.lat),\r\n436:         lat.2 = str_sub(limpia.lat, 2, lat.leng),\r\n437:         lat.final = paste0(\"-0.\", lat.1, lat.2) # Reconstruye inyectando la estructura de texto \"-0.\"\r\n438:       )\r\n439:       point_analisis_c7 <- data.frame(y = as.numeric(geo.corregir.1$lat.final), x = geo.corregir.1$lon.new)   \r\n440:       if(nrow(point_analisis_c7) > 0) {\r\n441:         point_analisis_c7 <- st_as_sf(point_analisis_c7, coords = c(\"x\", \"y\"), crs = st_crs(Provincia))  \r\n442:         point_analisis_c7$ID.temp <- geo.corregir.1$ID.temp\r\n443:         cantones.c7 <- unique(geo.corregir.1$CANTON_HECHO)\r\n444:         for(j in 1:length(cantones.c7)) {\r\n445:           base.c7 <- geo.corregir.1 %>% filter(CANTON_HECHO == cantones.c7[j])\r\n446:           poly.c7 <- Provincia %>% filter(CANTON_MAPA == cantones.c7[j])\r\n447:           if(nrow(poly.c7) > 0 & nrow(base.c7) > 0) {\r\n448:             pts.eval <- point_analisis_c7 %>% filter(ID.temp %in% base.c7$ID.temp)\r\n449:             dentro <- pts.eval[apply(st_intersects(pts.eval, poly.c7, sparse = FALSE), 1, any), ]\r\n450:             correctos3 <- c(correctos3, dentro$ID.temp)\r\n451:           }\r\n452:         }\r\n453:         geo.corregir.1g <- geo.corregir.1 %>% filter(ID.temp %in% correctos3)\r\n454:         geo.corregir.1 <- geo.corregir.1 %>% filter(!(ID.temp %in% correctos3))\r\n455:       }\r\n456:     }\r\n457:   }\r\n458: }\r\n459: \r\n460: # =========================================================================\r\n461: # FASE 9: ENSAMBLAJE DE BASE GEORREFERENCIADA\r\n462: # =========================================================================\r\n463: ## Concatenación de registros reparados exitosamente por bucles\r\n464: # rbind() (Row Bind) une tablas verticalmente, pegando filas debajo de otras filas. \r\n465: # Consolidamos los cuatro grupos que rescatamos con éxito gracias al formateo de texto del paso anterior.\r\n466: listo.corrcion.casos.posibles <- rbind(geo.corregir.1a, geo.corregir.1b, geo.corregir.1f, geo.corregir.1g) \r\n467: \r\n468: ## Limpieza de campos estructurales auxiliares\r\n469: if(nrow(listo.corrcion.casos.posibles) > 0) {\r\n470:   # Sobreescribimos la columna \"lat.new\" convirtiendo la cadena de texto reparada \"lat.final\" en un número decimal válido.\r\n471:   listo.corrcion.casos.posibles$lat.new <- as.numeric(listo.corrcion.casos.posibles$lat.final)\r\n472:   listo.corrcion.casos.posibles <- listo.corrcion.casos.posibles %>% \r\n473:     # any_of() identifica si existen las columnas de texto internas que usamos para trocear el número y las destruye \r\n474:     # para dejar el dataframe perfectamente limpio y homólogo a las demás bases de datos.\r\n475:     dplyr::select(-any_of(c(\"limpia.lat\", \"lat.1\", \"lat.leng\", \"lat.2\", \"lat.final\")))\r\n476: }\r\n477: \r\n478: ## Consolidación final unificada de registros espaciales válidos\r\n479: # Unimos de forma vertical los 3 pilares del procesamiento: los correctos iniciales + los reparados textualmente + el limbo analítico.\r\n480: homi_Nueva <- rbind(geo_correctos, listo.corrcion.casos.posibles, limbo_formato_correcto)\r\n481: homi_Nueva <- homi_Nueva %>% \r\n482:   mutate(lat.new = as.numeric(lat.new), lon.new = as.numeric(lon.new)) %>% \r\n483:   # Control de calidad estricto de cierre para eliminar físicamente cualquier fila remanente que se haya quedado sin coordenadas válidas.\r\n484:   filter(!is.na(lat.new) & !is.na(lon.new))\r\n485: \r\n486: # =========================================================================\r\n487: # FASE 10: ALMACENAMIENTO Y EXPORTACIÓN DE ENTREGABLES\r\n488: # =========================================================================\r\n489: ## Retorno al directorio de salida\r\n490: setwd(repositorio)\r\n491: \r\n492: ## Construcción del objeto geográfico vectorial SF\r\n493: # st_as_sf() procesa de forma definitiva la tabla unificada final, transformando las coordenadas numéricas \r\n494: # en una columna nativa espacial tipo \"GEOMETRY\" bajo la proyección global standard 4326.\r\n495: homi_Nueva_espacial <- st_as_sf(homi_Nueva, coords = c(\"lon.new\", \"lat.new\"), crs = 4326)\r\n496: \r\n497: ## Escritura física de los archivos estructurados\r\n498: # st_write() guarda físicamente las capas vectoriales en formato Shapefile de ESRI para mapear en softwares como QGIS o ArcGIS.\r\n499: # delete_layer = TRUE sobreescribe el mapa si ya existía uno previo, evitando errores de bloqueo de archivos en disco.\r\n500: st_write(homi_Nueva_espacial, \"homi_Nueva.shp\", delete_layer = TRUE, quiet = TRUE)\r\n501: # write.csv() exporta la tabla tabular en un archivo CSV plano estándar compatible con Microsoft Excel.\r\n502: write.csv(homi_Nueva, \"homi_Nueva_limpio7.csv\", row.names = FALSE)\r\n503: # saveRDS() almacena la base de datos comprimida en formato nativo de R para futuras cargas instantáneas con máxima fidelidad.\r\n504: saveRDS(homi_Nueva, file = \"homi_2010_2024_2.rds\")\r\n505: \r\n506: # =========================================================================\r\n507: # FASE 11: REPORTE ESTADÍSTICO DE CONTROL INTEGRAL\r\n508: # =========================================================================\r\n509: # Bloque puramente informativo para visualizar en consola los indicadores de rendimiento técnico de nuestro algoritmo informático.\r\n510: print(\"========================================================\")\r\n511: print(\"               REPORTE DE VERIFICACIÓN FINAL              \")\r\n512: print(\"========================================================\")\r\n513: print(paste(\"-> Homicidios procesados (2010-2024):\", nrow(homi_2010_2024)))\r\n514: print(paste(\"-> Total rescatados perfectos a la primera:\", nrow(geo_correctos)))\r\n515: print(paste(\"-> Total rescatados por algoritmo de texto:\", nrow(listo.corrcion.casos.posibles)))\r\n516: print(paste(\"-> Casos en limbo con coordenadas correctas retenidos:\", nrow(limbo_formato_correcto)))\r\n517: print(paste(\"TOTAL DE REGISTROS GEORREFERENCIADOS:\", nrow(homi_Nueva)))\r\n518: print(paste(\"Efectividad total de la base:\", round((nrow(homi_Nueva) / nrow(homi_2010_2024)) * 100, 2), \"%\"))\r\n519: print(\"========================================================\")\r\n520: \r\n521: # =========================================================================\r\n522: # FASE 12: VISUALIZACIÓN CARTOGRÁFICA DIAGNÓSTICA\r\n523: # =========================================================================\r\n524: ## Carga del mapa base referencial para el ploteo estético\r\n525: Mapa_Completo <- read_sf(file.path(repositorio_carto, \"nxcantones.shp\"))\r\n526: Mapa_Completo <- st_transform(Mapa_Completo, crs = 4326)\r\n527: \r\n528: ## Disolución de geometrías cantonales a límites provinciales ecuatorianos\r\n529: # Gráficamente: Como tu mapa base original divide al Ecuador en pequeños cantones, este bloque usa group_by() y summarize() \r\n530: # para fusionar (\"disolver\") las líneas fronterizas de los cantones pertenecientes a una misma provincia. \r\n531: # El resultado es un mapa más limpio que solo muestra los bordes externos de las 24 provincias continentales.\r\n532: Mapa_Provincias <- Mapa_Completo %>%\r\n533:   filter(DPA_DESPRO != \"GALAPAGOS\") %>% \r\n534:   group_by(DPA_DESPRO) %>%              \r\n535:   summarize(.groups = \"drop\")            \r\n536: \r\n537: ## Lectura espacial de control del producto generado\r\n538: test_mapa <- st_read(\"homi_Nueva.shp\", quiet = TRUE)\r\n539: \r\n540: ## Generación de la gráfica espacial de puntos sobre polígonos\r\n541: # ggplot() inicializa un lienzo gráfico vacío.\r\n542: ggplot() +\r\n543:   # geom_sf() dibuja objetos geográficos. Aquí grafica el fondo gris claro (\"gray96\") con líneas negras que representan las provincias.\r\n544:   geom_sf(data = Mapa_Provincias, fill = \"gray96\", color = \"black\", size = 0.4) + \r\n545:   # geom_jitter() grafica los homicidios como puntos individuales sobre las provincias. El término jitter añade un mini-desplazamiento \r\n546:   # aleatorio imperceptible invisible para que los puntos que tienen exactamente las mismas coordenadas exactas no se encimen por completo, \r\n547:   # permitiendo percibir visualmente la densidad de los crímenes (puntos de color rojo oscuro \"darkred\").\r\n548:   geom_jitter(data = test_mapa, aes(geometry = geometry), \r\n549:               stat = \"sf_coordinates\", alpha = 0.4, color = \"darkred\", size = 0.8) +\r\n550:   theme_minimal() + # Aplica un diseño estético minimalista con fondos blancos muy elegante para reportes ejecutivos.\r\n551:   labs(\r\n552:     title = \"Distribución Geográfica de Homicidios en Ecuador\",\r\n553:     subtitle = \"Límites provinciales unificados (Datos Validados Continentales 2010-2024)\",\r\n554:     x = \"Longitud\",\r\n555:     y = \"Latitud\"\r\n556:   )\r\n557: \r\n558: # str() inspecciona a fondo la estructura de almacenamiento del objeto: muestra tipos de datos (números, caracteres) y dimensiones.\r\n559: str(homi_Nueva)\r\n560: \r\n561: # =========================================================================\r\n562: # FASE 13: ETIQUETADO FINAL MAESTRO Y DEPURACIÓN ESTRUCTURAL\r\n563: # =========================================================================\r\n564: \r\n565: ### 1. Renombrado y Selección Definitiva basándonos en str(homi_Nueva)\r\n566: # dplyr::select() aquí realiza dos tareas críticas al mismo tiempo: \r\n567: # Primero, actúa como filtro estructural reteniendo solo las columnas indispensables para los usuarios finales.\r\n568: # Segundo, renombra las columnas encriptadas del proveedor (ej: \"X33\", \"X35\") a nombres descriptivos en español técnico.\r\n569: # Gráficamente: Transforma una matriz incomprensible en una base de datos gerencial lista para analistas de políticas públicas.\r\n570: homi_Analisis_Final <- homi_Nueva %>% \r\n571:   dplyr::select(\r\n572:     codigo_caso          = X2,           # Identificador policial codificado del crimen.\r\n573:     tipo_delito          = X4,           # Tipificación legal del incidente (ej: Homicidio, Asesinato).\r\n574:     fecha_hecho          = X33,          # Fecha exacta en formato estándar Año-Mes-Día.\r\n575:     anio_hecho           = anio,         # Desglose del año de ocurrencia.\r\n576:     mes_hecho            = mes,          # Mes del suceso expresado en palabras en minúsculas.\r\n577:     dia_semana           = dia,          # Día cronológico de la semana.\r\n578:     hora_aproximada      = rangoh,       # Hora promedio del evento\r\n579:     provincia_mapa       = DPA_DESPRO,   # Nombre oficial de la provincia validada geográficamente.\r\n580:     canton               = X133,         # Nombre oficial del cantón validado geográficamente.\r\n581:     zona_tipo            = X23,          # Clasificación territorial de la escena (Urbano o Rural).\r\n582:     lugar_especifico     = X28,          # Espacio público o privado de la agresión (ej: Vía Pública).\r\n583:     tipo_arma            = X35,          # Instrumento del deceso (ej: Arma de Fuego, Arma Blanca).\r\n584:     motivacion_detalle   = X39,          # Causa hipotética de la agresión según investigación (ej: Violencia Comunitaria).\r\n585:     causa_especifica     = X40,          # Detalle fáctico del móvil (ej: Riñas, Robo).\r\n586:     edad_victima         = X45,          # Edad cronológica en años de la persona fallecida.\r\n587:     sexo_victima         = X47,          # Género biológico registrado de la víctima.\r\n588:     nacionalidad_victima = X53,          # País de origen documentado del ciudadano.\r\n589:     latitud_reparada     = lat.new,      # Coordenada decimal Y final calculada, auditada y corregida.\r\n590:     longitud_reparada    = lon.new,      # Coordenada decimal X final calculada, auditada y corregida.\r\n591:     id_auditoria         = ID.temp,      # Nuestro ID de control único: Es vital guardarlo para saber el rastreo de auditoría del caso.\r\n592:     AUX_HORA_SISTEMA     = X208,         # Campo secundario de auditoría horaria de registros informáticos.\r\n593:     AUX_MINUTO_SISTEMA   = X209          # Campo secundario de auditoría de minutos de sistemas internos.\r\n594:   )\r\n595: \r\n596: ### 2. Bloque de escritura seguro y actualización del repositorio\r\n597: setwd(repositorio)\r\n598: \r\n599: archivo_csv <- \"homi_Final_Continental_Etiquetado.csv\"\r\n600: archivo_rds <- \"homi_Final_Continental_Etiquetado.rds\"\r\n601: \r\n602: # Eliminar versiones viejas bloqueadas si existen\r\n603: # tryCatch() es un escudo contra errores. Si el archivo CSV está abierto por un usuario en Microsoft Excel, \r\n604: # Excel bloquea el disco duro e impide que R lo modifique. tryCatch evita que el programa colapse por completo \r\n605: # emitiendo una alerta amigable en la consola en lugar de un mensaje de error fatal.\r\n606: if (file.exists(archivo_csv)) {\r\n607:   tryCatch(file.remove(archivo_csv), error = function(e) {\r\n608:     print(\"Nota: Si el CSV está abierto en Excel, ciérralo para actualizar los cambios.\")\r\n609:   })\r\n610: }\r\n611: \r\n612: # Grabado final de la información procesada\r\n613: # Guardamos los archivos definitivos completamente pulidos, renombrados y limpios para el consumo de los usuarios finales.\r\n614: write.csv(homi_Analisis_Final, archivo_csv, row.names = FALSE)\r\n615: saveRDS(homi_Analisis_Final, file = archivo_rds)\r\n616: \r\n617: print(\"=========================================================================\")\r\n618: print(\"   ¡PASO 13 COMPLETADO: BASE DE DATOS MAESTRA GENERADA EXITOSAMENTE!   \")\r\n619: print(\"=========================================================================\")\r\n620: print(paste(\"-> Registros consolidados exportados:\", nrow(homi_Analisis_Final)))\r\n621: print(paste(\"-> Columnas limpias seleccionadas:\", ncol(homi_Analisis_Final)))\r\n622: print(\"=========================================================================\")\r\n623: \r\n624: # Comandos de control final para diagnosticar la salud y completitud de la base final limpia.\r