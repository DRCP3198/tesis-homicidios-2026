\n107: # latitud, longitud, AUX_HORA_SISTEMA y AUX_MINUTO_SISTEMA no se tratan por el momento\r\n108: \r\n109: \r\n110: \r\n111: # =========================================================================\r\n112: # ARCHIVOS DE SALIDA INTERMEDIA\r\n113: # =========================================================================\r\n114: INTERIM_RENOMBRADO = INTERIM_DIR / \"homi_renombrado.parquet\"\r\n115: INTERIM_NORMALIZADO = INTERIM_DIR / \"homi_normalizado.parquet\"\r\n116: INTERIM_FILTRADO = INTERIM_DIR / \"homi_filtrado_2024.parquet\"\r\n117: INTERIM_GEO_CORRECTOS = INTERIM_DIR / \"geo_correctos.parquet\"\r\n118: \r\n119: # =========================================================================\r\n120: # ARCHIVOS DE SALIDA FINAL\r\n121: # =========================================================================\r\n122: SALIDA_CSV_FINAL = PROCESSED_DIR / \"homi_Final_Continental_Etiquetado.csv\"\r\n123: SALIDA_PARQUET_FINAL = PROCESSED_DIR / \"homi_Final_Continental_Etiquetado.parquet\"\r\n124: SALIDA_GPKG_FINAL = PROCESSED_DIR / \"homi_final.gpkg\"\r\n125: \r"}
