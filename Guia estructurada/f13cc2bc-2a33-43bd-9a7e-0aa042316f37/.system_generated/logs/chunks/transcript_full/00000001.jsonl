==\r\n26: # ESTRUCTURA DE DATOS PARA EL REPORTE\r\n27: # =========================================================================\r\n28: @dataclass\r\n29: #decorador que implementa automaticamente funciones estandar como:\r\n30: # El constructor (__init__)\r\n31: # El equivalente al toString() de Java (en Python se llama __repr__)\r\n32: # comparación (__eq__)\r\n33: # observacion todos los atributos son publicos por defectos\r\n34: class HallazgoColumna:\r\n35:     \"\"\"Almacena los hallazgos de caracteres especiales en una columna.\"\"\"\r\n36: \r\n37:     columna: str\r\n38:     total_filas_afectadas: int\r\n39:     ejemplos: list[str] = field(default_factory=list)\r\n40:     indices_filas: list[int] = field(default_factory=list)\r\n41: \r\n42: \r\n43: @dataclass\r\n44: class ReporteAuditoria:\r\n45:     \"\"\"Resultado completo de la auditoría de caracteres especiales.\"\"\"\r\n46: \r\n47:     columnas_revisadas: int\r\n48:     columnas_con_problemas: int\r\n49:     hallazgos: list[HallazgoColumna] = field(default_factory=list)\r\n50:     limpio: bool = True\r\n51: \r\n52: \r\n53: # =========================================================================\r\n54: # FUNCIÓN PRINCIPAL DE AUDITORÍA\r\n55: # =========================================================================\r\n56: def auditar_caracteres_especiales(\r\n57:     df: pd.DataFrame,\r\n58:     columnas: list[str] | None = None,\r\n59:     max_ejemplos: int = 5,\r\n60: ) -> ReporteAuditoria:\r\n61:     \"\"\"\r\n62:     Verifica que no existan tildes, eñes o diéresis en las columnas de texto.\r\n63: \r\n64:     Equivalencia R (líneas 153-186):\r\n65:         patron_especial <- \"[áéíóúÁÉÍÓÚñÑüÜ]\"\r\n66:         for (col in columnas_texto) {\r\n67:             filas_con_problemas <- which(grepl(patron_especial, homi[[col]]))\r\n68:             if (length(filas_con_problemas) > 0) { ... }\r\n69:         }\r\n70: \r\n71:     Parameters\r\n72:     ----------\r\n73:     df : pd.DataFrame\r\n74:         DataFrame a auditar (idealmente después de la normalización).\r\n75:     columnas : list[str] or None\r\n76:         Lista de columnas a revisar. Si es None, usa las 13 de config.py.\r\n77:     max_ejemplos : int\r\n78:         Número máximo de valores problemáticos a mostrar por columna.\r\n79: \r\n80:     Returns\r\n81:     -------\r\n82:     ReporteAuditoria\r\n83:         Objeto con los hallazgos detallados. Si `reporte.limpio` es True,\r\n84:         no se encontraron caracteres especiales.\r\n85:     \"\"\"\r\n86:     if columnas is None:\r\n87:         columnas = COLUMNAS_TEXTO_NORMALIZAR\r\n88: \r\n89:     # Verificar que las columnas existen\r\n90:     columnas_faltantes = set(columnas) - set(df.columns)\r\n91:     if columnas_faltantes:\r\n92:         raise KeyError(\r\n93:             f\"Columnas no encontradas en el DataFrame: {columnas_faltantes}\"\r\n94:         )\r\n95: \r\n96:     print(\"=\" * 60)\r\n97:     print(\"  AUDITORÍA DE CARACTERES ESPECIALES (TILDES Y EÑES)\")\r\n98:     print(\"=\" * 60)\r\n99:     print(f\"  Patrón Regex: {PATRON_CARACTERES_ESPECIALES}\")\r\n100:     print(f\"  Columnas a revisar: {len(columnas)}\")\r\n101:     print(\"-\" * 60)\r\n102: \r\n103:     reporte = ReporteAuditoria(\r\n104:         columnas_revisadas=len(columnas),\r\n105:         columnas_con_problemas=0,\r\n106:     )\r\n107: \r\n108:     patron_compilado = re.compile(PATRON_CARACTERES_ESPECIALES)\r\n109: \r\n110:     for col in columnas:\r\n111:         # Equivalente R: grepl(patron_especial, homi_2010_2024[[col]])\r\n112:         # .str.contains() devuelve True/False por fila (NaN para NA)\r\n113:         mascara = df[col].dropna().apply(\r\n114:             lambda x: bool(patron_compilado.search(str(x)))\r\n115:         )\r\n116: \r\n117:         # Obtener los índices originales de las filas con problemas\r\n118:         # Equivalente R: which(grepl(...))\r\n119:         indices_problemas = mascara[mascara].index.tolist()\r\n120: \r\n121:         if len(indices_problemas) > 0:\r\n122:             reporte.limpio = False\r\n123:             reporte.columnas_con_problemas += 1\r\n124: \r\n125:             # Extraer ejemplos (equivalente R: head(filas_con_problemas, 5))\r\n126:             ejemplos = df.loc[indices_problemas[:max_ejemplos], col].tolist()\r\n127: \r\n128:             hallazgo = HallazgoColumna(\r\n129:                 columna=col,\r\n130:                 total_filas_afectadas=len(indices_problemas),\r\n131:                 ejemplos=ejemplos,\r\n132:                 indices_filas=indices_problemas[:max_ejemplos],\r\n133:             )\r\n134:             reporte.hallazgos.append(hallazgo)\r\n135: \r\n136:             # Imprimir hallazgo (equivalente R: print(paste0(\"⚠️ Columna...\", col)))\r\n137:             print(f\"  [ALERTA] Columna: '{col}'\")\r\n138:             for idx, ejemplo in zip(\r\n139:                 indices_problemas[:max_ejemplos], ejemplos, strict=False\r\n140:             ):\r\n141:                 print(f\"      - Fila [{idx}]: '{ejemplo}'\")\r\n142:             if len(indices_problemas) > max_ejemplos:\r\n143:                 restantes = len(indices_problemas) - max_ejemplos\r\n144:                 print(f\"      ... y {restantes} registros más en esta columna.\")\r\n145:             print(\"-\" * 60)\r\n146: \r\n147:     # Mensaje final (equivalente R: if (!hallazgos) print(\"¡Felicidades!...\"))\r\n148:     if reporte.limpio:\r\n149:         print(\r\n150:             \"  [OK] No se encontraron eñes ni tildes ocultas \"\r\n151:             \"en las columnas de texto.\"\r\n152:         )\r\n153:     else:\r\n154:         print(\r\n155:             f\"  [ERROR] Se encontraron problemas en {reporte.columnas_con_problemas} \"\r\n156:             f\"de {reporte.columnas_revisadas} columnas revisadas.\"\r\n157:         )\r\n158:     print(\"=\" * 60)\r\n159: \r\n160:     return reporte\r\n161: \r"}
{"step_index":20,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-06T02:25:12Z","content":"Created At: 2026-11-05T21:25:12-05:00\nCompleted At: 2026-11-05T21:25:12-05:00\nShowing lines 1-101 of 101\n1: \"\"\"\n2: test_ingesta.py — Tests para la Fase 1: Ingesta y Renombrado.\n3: \n4: Verifica que:\n5: 1. El CSV se lee correctamente.\n6: 2. Todas las columnas se renombran según MAPEO_COLUMNAS.\n7: 3. No se pierden registros en la carga.\n8: 4. El formato Parquet intermedio se guarda y carga correctamente.\n9: \"\"\"\n10: import pytest\n11: import pandas as pd\n12: from pathlib import Path\n13: \n14: from src.ingesta.config import (\n15:     ARCHIVO_HOMICIDIOS_CSV,\n16:     MAPEO_COLUMNAS,\n17:     INTERIM_RENOMBRADO,\n18: )\n19: from src.ingesta.cargar_datos import (\n20:     cargar_homicidios_raw,\n21:     guardar_intermedio_renombrado,\n22:     cargar_intermedio_renombrado,\n23: )\n24: \n25: \n26: class TestCargarDatos:\n27:     \"\"\"Tests de la función cargar_homicidios_raw().\"\"\"\n28: \n29:     def test_csv_existe(self):\n30:         \"\"\"Verifica que el archivo CSV fuente existe.\"\"\"\n31:         assert ARCHIVO_HOMICIDIOS_CSV.exists(), (\n32:             f\"No se encontró el CSV fuente: {ARCHIVO_HOMICIDIOS_CSV}\"\n33:         )\n34: \n35:     def test_carga_exitosa(self):\n36:         \"\"\"Verifica que la carga no lance errores y devuelva un DataFrame.\"\"\"\n37:         df = cargar_homicidios_raw()\n38:         assert isinstance(df, pd.DataFrame)\n39:         assert len(df) > 0, \"El DataFrame está vacío\"\n40: \n41:     def test_columnas_renombradas(self):\n42:         \"\"\"Verifica que TODAS las columnas del mapeo estén presentes.\"\"\"\n43:         df = cargar_homicidios_raw()\n44:         columnas_esperadas = set(MAPEO_COLUMNAS.values())\n45:         columnas_obtenidas = set(df.columns)\n46:         assert columnas_esperadas == columnas_obtenidas, (\n47:             f\"Columnas faltantes: {columnas_esperadas - columnas_obtenidas}\\n\"\n48:             f\"Columnas extra: {columnas_obtenidas - columnas_esperadas}\"\n49:         )\n50: \n51:     def test_21_columnas(self):\n52:         \"\"\"Verifica que el DataFrame tenga exactamente 21 columnas.\"\"\"\n53:         df = cargar_homicidios_raw()\n54:         assert len(df.columns) == 21, f\"Se esperaban 21 columnas, se obtuvieron {len(df.columns)}\"\n55: \n56:     def test_sin_columnas_originales(self):\n57:         \"\"\"Verifica que no queden columnas con nombres originales (X2, X4, etc.).\"\"\"\n58:         df = cargar_homicidios_raw()\n59:         columnas_crudas = [c for c in df.columns if c.startswith(\"X\") and c[1:].isdigit()]\n60:         assert len(columnas_crudas) == 0, (\n61:             f\"Columnas sin renombrar encontradas: {columnas_crudas}\"\n62:         )\n63: \n64: \n65: class TestGuardarIntermedio:\n66:     \"\"\"Tests del ciclo guardar/cargar Parquet.\"\"\"\n67: \n68:     def test_guardar_y_cargar_parquet(self):\n69:         \"\"\"Verifica que el ciclo Parquet preserve los datos.\"\"\"\n70:         df_original = cargar_homicidios_raw()\n71:         guardar_intermedio_renombrado(df_original)\n72: \n73:         assert INTERIM_RENOMBRADO.exists(), \"El archivo Parquet no se creó\"\n74: \n75:         df_cargado = cargar_intermedio_renombrado()\n76:         assert df_original.shape == df_cargado.shape, (\n77:             f\"Forma original {df_original.shape} != cargada {df_cargado.shape}\"\n78:         )\n79:         assert list(df_original.columns) == list(df_cargado.columns), (\n80:             \"Las columnas no coinciden entre original y cargado\"\n81:         )\n82: \n83: \n84: class TestUtilTexto:\n85:     \"\"\"Tests para las funciones utilitarias de texto.\"\"\"\n86: \n87:     def test_normalizar_texto(self):\n88:         from src.utils.texto import normalizar_texto\n89: \n90:         assert normalizar_texto(\"  Guayaquíl  \") == \"GUAYAQUIL\"\n91:         assert normalizar_texto(\"SANTO DOMINGO DE LOS TSÁCHILAS\") == \"SANTO DOMINGO DE LOS TSACHILAS\"\n92:         assert normalizar_texto(\"Ñuño\") == \"NUNO\"\n93:         assert normalizar_texto(\"  quito  \") == \"QUITO\"\n94: \n95:     def test_contiene_caracteres_especiales(self):\n96:         from src.utils.texto import contiene_caracteres_especiales\n97: \n98:         assert contiene_caracteres_especiales(\"Guayaquíl\") is True\n99:         assert contiene_caracteres_especiales(\"GUAYAQUIL\") is False\n100:         assert contiene_caracteres_especiales(\"Ñuño\") is True\n101: "}
