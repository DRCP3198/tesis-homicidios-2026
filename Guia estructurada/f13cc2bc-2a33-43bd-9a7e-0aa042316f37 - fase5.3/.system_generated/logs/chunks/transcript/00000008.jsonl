{"step_index":461,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T16:05:20Z","content":"Created At: 2026-11-10T11:05:20-05:00\nCompleted At: 2026-11-10T11:05:20-05:00\nShowing lines 190-260 of 260\n190:     # Equivale a: Provincia <- st_transform(Provincia, crs = 4326)\n191:     # El shapefile original está en EPSG:32717 (UTM zona 17S).\n192:     # Lo convertimos a EPSG:4326 (coordenadas geográficas lat/lon).\n193:     #\n194:     # ¿Por qué? EPSG:32717 mide en METROS (ej. x=500000, y=9750000), pero\n195:     # nuestras coordenadas de homicidios están en GRADOS (ej. -2.18, -79.88).\n196:     # Para poder comparar puntos con polígonos, ambos deben estar en el mismo\n197:     # sistema. .to_crs() recalcula todas las coordenadas del mapa a grados.\n198:     mapa = mapa.to_crs(epsg=CRS_OBJETIVO)\n199:     print(f\"  CRS reproyectado: {mapa.crs}\")\n200: \n201:     # ── Paso 4.1c: Reparación de geometrías inválidas ──\n202:     # Equivale a: Provincia <- st_make_valid(Provincia)\n203:     # Corrige auto-intersecciones, vértices duplicados, etc.\n204:     #\n205:     # mapa.is_valid → columna True/False: True si el polígono está bien dibujado.\n206:     # ~ invierte (True↔False) → ahora True significa \"inválido\".\n207:     # .sum() → cuenta cuántos True hay → número de polígonos inválidos.\n208:     n_invalidas_antes = (~mapa.is_valid).sum()\n209:     # mapa.make_valid() → devuelve las geometrías corregidas.\n210:     # Las asignamos de vuelta a la columna de geometría del mapa.\n211:     mapa.geometry = mapa.make_valid() #agara los poligonos y corrige si hay inconsistencias\n212:     n_invalidas_despues = (~mapa.is_valid).sum()  # Debería ser 0 tras la reparación.\n213:     print(f\"  Geometrías reparadas: {n_invalidas_antes} (antes) → {n_invalidas_despues} (despues)\")\n214: \n215:     # ── Paso 4.2a: Crear columna CANTON_MAPA normalizada ──\n216:     # Equivale a: mutate(CANTON_MAPA = iconv(str_to_upper(str_trim(DPA_DESCAN)),\n217:     #                                        to = \"ASCII//TRANSLIT\"))\n218:     # Aplica reparación de bytes corruptos ('Ð' → 'N' en RUMIÐAHUI / LOGRO\n<truncated 407 bytes>\n] = reparar_codificacion_shapefile(mapa)\n226:     # .nunique() → número de cantones distintos.\n227:     print(f\"  Cantones en mapa (total): {mapa['CANTON_MAPA'].nunique()}\")\n228: \n229:     # ── Paso 4.2b: Excluir Galápagos y Zona No Delimitada ──\n230:     # Equivale a: filter(DPA_DESPRO != \"GALAPAGOS\",\n231:     #                    DPA_DESPRO != \"ZONA NO DELIMITADA\")\n232:     # Necesitamos normalizar DPA_DESPRO también para la comparación.\n233:     # (Ej: en el shapefile viene \"CAÑAR\" con Ñ; normalizado queda \"CANAR\").\n234:     #\n235:     # Creamos una columna TEMPORAL \"_PROV_NORM\" (el \"_\" inicial es una\n236:     # convención para indicar que es auxiliar/interna).\n237:     mapa[\"_PROV_NORM\"] = mapa[\"DPA_DESPRO\"].map(normalizar_texto)\n238:     n_antes = len(mapa)\n239:     # .isin(lista) → True si la provincia está en la lista a excluir.\n240:     # ~ invierte → nos quedamos con las provincias que NO están en la lista.\n241:     # .copy() → copia independiente para evitar advertencias de pandas.\n242:     mapa = mapa[~mapa[\"_PROV_NORM\"].isin(PROVINCIAS_EXCLUIR_MAPA)].copy()\n243:     # .drop(columns=[...]) → elimina la columna temporal, ya no la necesitamos.\n244:     mapa = mapa.drop(columns=[\"_PROV_NORM\"])\n245:     n_despues = len(mapa)\n246:     n_excluidos = n_antes - n_despues  # Cuántos polígonos se quitaron.\n247: \n248:     print(f\"  Excluidos (Galápagos + Zona No Delim.): {n_excluidos}\")\n249:     print(f\"  Cantones continental final: {mapa['CANTON_MAPA'].nunique()}\")\n250: \n251:     # Control de seguridad: si por algún error el filtro borró todo el mapa,\n252:     # detenemos el programa con un mensaje claro (sin mapa no se puede validar nada).\n253:     if len(mapa) == 0:\n254:         raise ValueError(\n255:             \"El GeoDataFrame del mapa quedó vacío después de filtrar. \"\n256:             \"Verifica que PROVINCIAS_EXCLUIR_MAPA no elimine todo.\"\n257:         )\n258: \n259:     print(\"=\" * 60)\n260:     return mapa  # Devolvemos el mapa limpio, listo para la auditoría topológica.","truncated_fields":["content"]}
