{"step_index":261,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T00:54:07Z","content":"Created At: 2026-11-09T19:54:07-05:00\nCompleted At: 2026-11-09T19:54:07-05:00\nShowing lines 50-193 of 193\n50: # ── Imports Fase 4: Validación Geoespacial ──\n51: # Importa los módulos del pipeline geoespacial completo:\n52: # cartografía, creación de puntos, auditoría topológica,\n53: # algoritmo reparador (4 escenarios) y ensamblaje final.\n54: from src.validacion_geo.cartografia import cargar_mapa_cantonal\n55: from src.validacion_geo.ensamblaje import (\n56:     ensamblar_base_final,\n57:     guardar_artefactos_geo,\n58:     imprimir_reporte_geo,\n59: )\n60: from src.validacion_geo.geometrias import (\n61:     auditar_punto_en_poligono,\n62:     crear_geodataframe_puntos,\n63:     separar_por_formato,\n64: )\n65: from src.validacion_geo.reparacion import reparar_coordenadas_corruptas\n66: \n67: #pipeline = proceso general que coordina las etapas de preprocesamiento.\n68: #ingesta = módulo encargado de cargar los datos originales.\n69: \n70: \n71: def main():\n72:     \"\"\"Función principal encargada de ejecutar el pipeline de preprocesamiento.\"\"\"\n73: \n74:     # ── FASE 1: Ingesta y Renombrado ──\n75:     # Carga los datos originales de homicidios y guarda\n76:     # una versión intermedia con las columnas renombradas.\n77:     df = cargar_homicidios_raw()         # Lee el CSV crudo y renombra las 21 columnas.\n78:     guardar_intermedio_renombrado(df)    # Guarda data/interim/homi_renombrado.parquet.\n79: \n80:     # ── FASE 2: Limpieza y Normalización Textual ──\n81:     # Aplica strip() + upper() + unidecode() a las 13 columnas de texto.\n82:     # Equivale al bloque mutate() con iconv() + str_trim() + str_to_upper() del R.\n83:     df = normalizar_todas_columnas(df)   # MAYÚSCULAS + sin tildes/eñes + sin espacios extra.\n84:     auditar_caracteres_especiales(df)    # Verifica con regex que no haya quedado ni una tilde.\n85:     guardar_intermedio_normalizado(df)   # Guarda data/interim/homi_normalizado.parquet.\n86: \n87:     # ── FASE 3: Filtrado temporal y geográfico ──\n88:     # Aplica los filtro\n<truncated 2810 bytes>\necto, geo_corregir_decimales = separar_por_formato(\n146:         geo_corregir\n147:     )\n148: \n149:     # Paso 4.6: Algoritmo reparador de coordenadas corruptas (4 escenarios)\n150:     # Prueba en orden: X.XXX → 0.XXX → -X.XXX → -0.XXX y valida cada intento con sjoin.\n151:     esc1, esc2, esc3, esc4, no_reparados = reparar_coordenadas_corruptas(\n152:         geo_corregir_decimales, mapa\n153:     )\n154:     # Suma total de casos rescatados entre los 4 escenarios.\n155:     n_reparados_total = sum(len(d) for d in [esc1, esc2, esc3, esc4])\n156: \n157:     # Paso 4.7: Ensamblaje y limpieza final\n158:     # Une correctos + reparados + limbo, borra columnas auxiliares y filtra NaN.\n159:     df_georreferenciado = ensamblar_base_final(\n160:         geo_correctos=geo_correctos,\n161:         reparados_esc1=esc1,\n162:         reparados_esc2=esc2,\n163:         reparados_esc3=esc3,\n164:         reparados_esc4=esc4,\n165:         limbo_formato_correcto=limbo_formato_correcto,\n166:         no_reparados=no_reparados,\n167:     )\n168: \n169:     # Paso 4.8: Exportar artefactos Parquet\n170:     # Guarda geo_correctos.parquet (interim) y homi_georreferenciado.parquet (processed).\n171:     guardar_artefactos_geo(geo_correctos, df_georreferenciado)\n172: \n173:     # Reporte estadístico de la Fase 4\n174:     imprimir_reporte_geo(\n175:         n_procesados=n_entrada_fase4,\n176:         n_correctos=len(geo_correctos),\n177:         n_reparados_total=n_reparados_total,\n178:         n_limbo=len(limbo_formato_correcto),\n179:         n_no_reparados=len(no_reparados),\n180:         n_final=len(df_georreferenciado),\n181:     )\n182: \n183:     # ── FASE 5: Etiquetado y exportación final ──\n184:     # TODO: Sesión 7\n185: \n186:     print(\"\\n[OK] Pipeline Fases 1-4 completado exitosamente.\")\n187: \n188: \n189: # Punto de entrada del programa:\n190: # Cuando ejecutas `python main.py` en la terminal, Python pone \"__main__\" en\n191: # la variable especial `__name__` y entra aquí llamando a main().\n192: if __name__ == \"__main__\":\n193:     main()","truncated_fields":["content"]}
