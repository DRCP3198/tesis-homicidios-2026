{"step_index":336,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T01:22:01Z","content":"Created At: 2026-11-09T20:22:01-05:00\nCompleted At: 2026-11-09T20:22:01-05:00\nShowing lines 172-251 of 251\n172: \n173: # =========================================================================\n174: # ESQUEMA CONSOLIDADO DE 21 COLUMNAS FINALES (Fase 5)\n175: # =========================================================================\n176: # Orden oficial de las 21 columnas limpias según docs/diccionario_datos.md\n177: # y la arquitectura del proyecto (equivale al dplyr::select() de R Fase 13).\n178: COLUMNAS_FINALES_21 = [\n179:     \"codigo_caso\",           # 1.  str/string — Identificador policial codificado\n180:     \"tipo_delito\",           # 2.  category   — Tipificación legal\n181:     \"fecha_hecho\",           # 3.  datetime64 — Fecha exacta (YYYY-MM-DD)\n182:     \"anio_hecho\",            # 4.  Int64      — Año de ocurrencia (2010-2024)\n183:     \"mes_hecho\",             # 5.  category   — Mes del suceso\n184:     \"dia_semana\",            # 6.  category   — Día de la semana\n185:     \"hora_aproximada\",       # 7.  float64    — Hora decimal aproximada del evento\n186:     \"provincia\",             # 8.  category   — Nombre oficial de la provincia\n187:     \"canton\",                # 9.  category   — Nombre oficial del cantón\n188:     \"zona_tipo\",             # 10. category   — Urbano / Rural / SD\n189:     \"lugar_especifico\",      # 11. category   — Espacio de la agresión\n190:     \"tipo_arma\",             # 12. category   — Instrumento del deceso\n191:     \"motivacion_detalle\",    # 13. category   — Causa hipotética\n192:     \"causa_especifica\",      # 14. category   — Detalle fáctico del móvil\n193:     \"edad_victima\",          # 15. float64    — Edad en años (admite decimales en lactantes)\n194:     \"sexo_victima\",          # 16. category   — Género biológico\n195:     \"nacionalidad_victima\",  # 17. category   — País de origen\n196:     \"latitud\",               # 18. float64    — Coordenada Y validada/reparada (desde lat_num)\n197:     \"longitud\",              # 19. float64    —\n<truncated 893 bytes>\nrio de datos.\n221: MAPEO_COORDENADAS_FINALES = {\n222:     \"lat_num\": \"latitud\",\n223:     \"lon_num\": \"longitud\",\n224: }\n225: \n226: # =========================================================================\n227: # ARCHIVOS DE SALIDA INTERMEDIA\n228: # =========================================================================\n229: # Cada fase guarda su resultado en un archivo .parquet dentro de data/interim/.\n230: # Parquet es un formato binario, comprimido y que respeta los tipos de datos\n231: # (reemplaza al .rds de R). Es mucho más rápido de leer que un CSV.\n232: INTERIM_RENOMBRADO = INTERIM_DIR / \"homi_renombrado.parquet\"                # Salida Fase 1\n233: INTERIM_NORMALIZADO = INTERIM_DIR / \"homi_normalizado.parquet\"              # Salida Fase 2\n234: INTERIM_FILTRADO = INTERIM_DIR / \"homi_filtrado_2024.parquet\"               # Salida Fase 3\n235: INTERIM_INSULAR_EXCLUIDO = INTERIM_DIR / \"homi_insular_excluido.parquet\"    # Trazabilidad Fase 3\n236: INTERIM_GEO_CORRECTOS = INTERIM_DIR / \"geo_correctos.parquet\"               # Salida Fase 4 (1ra aud.)\n237: PROCESSED_GEORREFERENCIADO = PROCESSED_DIR / \"homi_georreferenciado.parquet\"  # Salida Fase 4 (ensamble)\n238: \n239: # =========================================================================\n240: # ARCHIVOS DE SALIDA FINAL (Fase 5)\n241: # =========================================================================\n242: # Archivos definitivos que se generarán en la Fase 5 (exportación final).\n243: SALIDA_CSV_FINAL = PROCESSED_DIR / \"homi_Final_Continental_Etiquetado.csv\"\n244: SALIDA_PARQUET_FINAL = PROCESSED_DIR / \"homi_final.parquet\"\n245: # .gpkg = GeoPackage: formato moderno de mapas en un solo archivo (reemplaza al .shp).\n246: SALIDA_GPKG_FINAL = PROCESSED_DIR / \"homi_final.gpkg\"\n247: \n248: # Reportes y visualizaciones diagnósticas (Fase 5.5 y 5.6)\n249: SALIDA_AUDITORIA_JSON = REPORTS_DIR / \"auditoria_pipeline.json\"\n250: SALIDA_AUDITORIA_MD = REPORTS_DIR / \"auditoria_pipeline.md\"\n251: SALIDA_MAPA_DIAGNOSTICO = FIGURAS_DIR / \"mapa_diagnostico_continental.png\"","truncated_fields":["content"]}
