\n286:     \"\"\"\n287:     # Si no hay filas que probar, devolvemos un conjunto vacío set().\n288:     if len(df) == 0:\n289:         return set()\n290: \n291:     # Convertir latitud reconstruida a numérico\n<truncated 8498 bytes>\n    rescatados[\"lat_num\"] = pd.to_numeric(lat_reparada, errors=\"coerce\")\n449: \n450:         # Los rescatados salen del pool\n451:         # Equivale a: geo.corregir.1 <- geo.corregir.1 %>% filter(!(ID.temp %in% correctos3))\n452:         # Así en la siguiente vuelta `pendientes` solo tiene los que siguen fallando.\n453:         pendientes = pendientes[~pendientes[\"ID_temp\"].isin(ids_rescatados)].copy()\n454: \n455:         # Guardamos la tabla de rescatados de este escenario en la lista.\n456:         resultados.append(rescatados)\n457:         print(f\"        {nombre}: {len(rescatados):,} rescatados \"\n458:               f\"({len(pendientes):,} pendientes)\")\n459: \n460:     # Limpiar columna auxiliar de todos los DataFrames\n461:     # enumerate(lista) → recorre la lista dándonos posición E ítem: (0, esc1), (1, esc2)...\n462:     # Usamos `i` para sobreescribir `resultados[i]` sin la columna temporal \"limpia_lat\".\n463:     for i, r in enumerate(resultados):\n464:         if len(r) > 0 and \"limpia_lat\" in r.columns:\n465:             resultados[i] = r.drop(columns=[\"limpia_lat\"])\n466: \n467:     if len(pendientes) > 0 and \"limpia_lat\" in pendientes.columns:\n468:         pendientes = pendientes.drop(columns=[\"limpia_lat\"])\n469: \n470:     # sum(...) suma la cantidad de filas rescatadas en los 4 escenarios.\n471:     n_total_rescatados = sum(len(r) for r in resultados)\n472:     n_no_reparados = len(pendientes)  # Lo que quedó en `pendientes` tras los 4 intentos.\n473: \n474:     print(f\"        {'─' * 45}\")\n475:     print(f\"        Total rescatados: {n_total_rescatados:,} de {n_total:,}\")\n476:     print(f\"        No reparados: {n_no_reparados:,}\")\n477: \n478:     return (\n479:         resultados[0],  # Escenario 1 (índice 0 de la lista)\n480:         resultados[1],  # Escenario 2 (índice 1 de la lista)\n481:         resultados[2],  # Escenario 3 (índice 2 de la lista)\n482:         resultados[3],  # Escenario 4 (índice 3 de la lista)\n483:         pendientes,     # No reparados (ej. coordenadas 0, 0 irrecuperables)\n484:     )","truncated_fields":["content"]}
{"step_index":396,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:33:14Z","content":"Created At: 2026-11-10T10:33:14-05:00\nCompleted At: 2026-11-10T10:33:14-05:00\nShowing lines 1-288 of 288\n1: \"\"\"\n2: ensamblaje.py — Ensamblaje final de la base georreferenciada.\n3: \n4: Corresponde a la Fase R 9 (líneas 460-484) del código original:\n5:     listo.corrcion.casos.posibles <- rbind(geo.corregir.1a, ..., geo.corregir.1g)\n6:     listo.corrcion.casos.posibles$lat.new <- as.numeric(lat.final)\n7:     listo.corrcion.casos.posibles <- select(-any_of(c(\"limpia.lat\", ...)))\n8:     homi_Nueva <- rbind(geo_correctos, listo.corrcion.casos.posibles, limbo)\n9:     homi_Nueva <- mutate(lat.new = as.numeric(lat.new), ...) %>%\n10:         filter(!is.na(lat.new) & !is.na(lon.new))\n11: \n12: Funciones principales:\n13:     - ensamblar_base_final(): Concatena y limpia todos los conjuntos (Paso 4.7)\n14:     - guardar_artefactos_geo(): Exporta Parquet en interim/ y processed/ (Paso 4.8)\n15:     - imprimir_reporte_geo(): Reporte estadístico de efectividad (equivale R Fase 11)\n16: \n17: En palabras simples: este módulo vuelve a JUNTAR todas las piezas válidas\n18: que se separaron durante la Fase 4 (los correctos desde el inicio + los\n19: reparados por los 4 escenarios + los del limbo), borra las columnas de\n20: trabajo temporal y guarda la tabla final limpia en disco.\n21: \"\"\"\n22: import pandas as pd\n23: \n24: from src.ingesta.config import (\n25:     INTERIM_GEO_CORRECTOS,  # data/interim/geo_correctos.parquet\n26:     PROCESSED_DIR,          # data/processed/\n27: )\n28: \n29: \n30: # Columnas auxiliares creadas durante la validación geoespacial que deben\n31: # eliminarse del DataFrame final para mantener el esquema limpio.\n32: # Equivale a: select(-any_of(c(\"limpia.lat\", \"lat.1\", \"lat.leng\", ...))) en R\n33: # El \"_\" al inicio indica que es una constante interna de este archivo.\n34: _COLUMNAS_AUXILIARES: list[str] = [\n35:     \"latitud_original\",   # Cadena original antes de conversión numérica\n36:     \"longitud_original\",  # Cadena original antes de conversión numérica\n37:     \"limpia_lat\",         # Cadena limpia usada en\n<truncated 10704 bytes>\n la Fase 4.\n251: \n252:     Equivalencia R (líneas 510-519):\n253:         print(paste(\"-> Homicidios procesados:\", nrow(homi_2010_2024)))\n254:         print(paste(\"-> Total rescatados perfectos:\", nrow(geo_correctos)))\n255:         print(paste(\"-> Total rescatados por algoritmo:\", nrow(reparados)))\n256:         print(paste(\"TOTAL DE REGISTROS GEORREFERENCIADOS:\", nrow(homi_Nueva)))\n257:         print(paste(\"Efectividad total:\", round(...*100, 2), \"%\"))\n258: \n259:     Parameters\n260:     ----------\n261:     n_procesados : int\n262:         Total de registros que entraron al pipeline de la Fase 4.\n263:     n_correctos : int\n264:         Registros que pasaron la primera auditoría sin corrección.\n265:     n_reparados_total : int\n266:         Total de registros reparados por los 4 escenarios del algoritmo.\n267:     n_limbo : int\n268:         Registros en limbo con formato correcto (punto decimal pero fuera).\n269:     n_no_reparados : int\n270:         Registros que ningún escenario pudo rescatar (excluidos).\n271:     n_final : int\n272:         Total de registros en la base georreferenciada final.\n273:     \"\"\"\n274:     # Porcentaje de registros que terminaron con coordenadas válidas respecto al total.\n275:     efectividad = (n_final / n_procesados * 100) if n_procesados > 0 else 0.0\n276: \n277:     print(\"=\" * 60)\n278:     print(\"  REPORTE DE VERIFICACIÓN — FASE 4: VALIDACIÓN GEOESPACIAL\")\n279:     print(\"=\" * 60)\n280:     print(f\"  {'Homicidios procesados (entrada):':<42} {n_procesados:>7,}\")\n281:     print(f\"  {'Rescatados perfectos (1ra auditoría):':<42} {n_correctos:>7,}\")\n282:     print(f\"  {'Rescatados por algoritmo (4 escenarios):':<42} {n_reparados_total:>7,}\")\n283:     print(f\"  {'Limbo con coordenadas retenidos:':<42} {n_limbo:>7,}\")\n284:     print(f\"  {'No reparados (excluidos):':<42} {n_no_reparados:>7,}\")\n285:     print(f\"  {'─' * 52}\")\n286:     print(f\"  {'TOTAL GEORREFERENCIADOS:':<42} {n_final:>7,}\")\n287:     print(f\"  Efectividad total del pipeline: {efectividad:.2f}%\")\n288:     print(\"=\" * 60)","truncated_fields":["content"]}
