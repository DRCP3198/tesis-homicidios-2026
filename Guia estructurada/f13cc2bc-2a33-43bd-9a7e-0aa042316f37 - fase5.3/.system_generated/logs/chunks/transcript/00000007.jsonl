{"step_index":409,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:34:53Z","content":"Created At: 2026-11-10T10:34:53-05:00\nCompleted At: 2026-11-10T10:34:53-05:00\nShowing lines 1-271 of 271\n1: \"\"\"\n2: test_normalizar_texto.py — Tests para la Fase 2: Limpieza y Normalización Textual.\n3: \n4: Verifica que:\n5: 1. La función normalizar_texto() elimine correctamente tildes, eñes y diéresis.\n6: 2. La función normalizar_columna() opere sobre pd.Series completas.\n7: 3. El pipeline normalizar_todas_columnas() procese las 13 columnas.\n8: 4. La auditoría de caracteres detecte problemas antes y confirme limpieza después.\n9: \"\"\"\n10: import pytest\n11: import pandas as pd\n12: \n13: from src.utils.texto import (\n14:     normalizar_texto,\n15:     normalizar_columna,\n16:     contiene_caracteres_especiales,\n17:     PATRON_CARACTERES_ESPECIALES,\n18: )\n19: from src.ingesta.config import COLUMNAS_TEXTO_NORMALIZAR\n20: from src.limpieza.normalizar_texto import normalizar_todas_columnas\n21: from src.reportes.auditoria_caracteres import auditar_caracteres_especiales\n22: \n23: \n24: # =========================================================================\n25: # TESTS UNITARIOS: normalizar_texto() — Función escalar\n26: # =========================================================================\n27: # Un \"test unitario\" prueba UNA sola pieza pequeña de código (una función)\n28: # de manera aislada, con entradas chiquitas inventadas por nosotros, sin\n29: # depender de archivos grandes ni bases de datos externas.\n30: class TestNormalizarTexto:\n31:     \"\"\"Tests de la función normalizar_texto() en src/utils/texto.py.\"\"\"\n32: \n33:     def test_elimina_tildes_vocales(self):\n34:         \"\"\"Verifica la remoción de todas las vocales acentuadas.\"\"\"\n35:         # Cada `assert A == B` verifica que la función devuelva exactamente lo esperado.\n36:         assert normalizar_texto(\"áéíóú\") == \"AEIOU\"\n37:         assert normalizar_texto(\"ÁÉÍÓÚ\") == \"AEIOU\"\n38: \n39:     def test_elimina_ene(self):\n40:         \"\"\"Verifica que la eñe se convierta a N.\"\"\"\n41:         assert normalizar_texto(\"Ñuño\") == \"NUNO\"\n42:         \n<truncated 10408 bytes>\ncaracteres especiales.\"\"\"\n228: \n229:     def test_datos_sucios_detectados(self):\n230:         \"\"\"Verifica que se detecten tildes en datos NO normalizados.\"\"\"\n231:         df = pd.DataFrame({\n232:             \"canton\": [\"Guayaquíl\", \"Quito\", \"Cuenca\"],\n233:             \"provincia\": [\"GUAYAS\", \"PICHINCHA\", \"AZUAY\"],\n234:         })\n235:         reporte = auditar_caracteres_especiales(\n236:             df, columnas=[\"canton\", \"provincia\"]\n237:         )\n238:         # Accedemos a los atributos del objeto `ReporteAuditoria` con punto \".\"\n239:         assert not reporte.limpio\n240:         assert reporte.columnas_con_problemas == 1\n241:         assert reporte.hallazgos[0].columna == \"canton\"\n242: \n243:     def test_datos_limpios_ok(self):\n244:         \"\"\"Verifica que datos ya normalizados pasen la auditoría.\"\"\"\n245:         df = pd.DataFrame({\n246:             \"canton\": [\"GUAYAQUIL\", \"QUITO\", \"CUENCA\"],\n247:             \"provincia\": [\"GUAYAS\", \"PICHINCHA\", \"AZUAY\"],\n248:         })\n249:         reporte = auditar_caracteres_especiales(\n250:             df, columnas=[\"canton\", \"provincia\"]\n251:         )\n252:         assert reporte.limpio\n253:         assert reporte.columnas_con_problemas == 0\n254:         assert len(reporte.hallazgos) == 0\n255: \n256:     def test_multiples_columnas_afectadas(self):\n257:         \"\"\"Verifica detección en múltiples columnas simultáneamente.\"\"\"\n258:         df = pd.DataFrame({\n259:             \"canton\": [\"Guayaquíl\"],\n260:             \"provincia\": [\"Pichinchá\"],\n261:         })\n262:         reporte = auditar_caracteres_especiales(\n263:             df, columnas=[\"canton\", \"provincia\"]\n264:      