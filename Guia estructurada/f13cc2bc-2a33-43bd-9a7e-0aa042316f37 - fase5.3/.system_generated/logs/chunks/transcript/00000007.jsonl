ad: si por algún error el filtro borró todo el mapa,\n173:     # detenemos el programa con un mensaje claro (sin mapa no se puede validar nada).\n174:     if len(mapa) == 0:\n175:         raise ValueError(\n176:             \"El GeoDataFrame del mapa quedó vacío después de filtrar. \"\n177:             \"Verifica que PROVINCIAS_EXCLUIR_MAPA no elimine todo.\"\n178:         )\n179: \n180:     print(\"=\" * 60)\n181:     return mapa  # Devolvemos el mapa limpio, listo para la auditoría topológica.","truncated_fields":["content"]}
{"step_index":394,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:33:13Z","content":"Created At: 2026-11-10T10:33:13-05:00\nCompleted At: 2026-11-10T10:33:14-05:00\nShowing lines 1-189 of 189\n1: \"\"\"\n2: normalizar_texto.py — Módulo de limpieza y normalización textual.\n3: \n4: Corresponde a la Fase 2 de la migración R → Python (líneas 81-130 del R):\n5:     homi_2010_2025 <- homi_2010_2025 %>%\n6:         mutate(\n7:             columna = iconv(str_to_upper(str_trim(columna)),\n8:                             to = \"ASCII//TRANSLIT\"),\n9:             ...\n10:         )\n11: \n12: Funciones principales:\n13:     - normalizar_todas_columnas(): Aplica strip + upper + unidecode\n14:       a las 13 columnas de texto definidas en config.py.\n15:     - guardar_intermedio_normalizado(): Guarda el resultado en Parquet.\n16:     - cargar_intermedio_normalizado(): Vuelve a leer ese Parquet.\n17: \n18: ¿Por qué normalizar el texto?\n19:     Para que \"Guayaquíl\", \" GUAYAQUIL \" y \"guayaquil\" se conviertan todos en\n20:     \"GUAYAQUIL\". Así, al comparar el cantón de la base de datos con el cantón\n21:     del mapa (Fase 4), coinciden letra por letra.\n22: \"\"\"\n23: # pandas: librería principal de manejo de tablas de datos (DataFrames).\n24: import pandas as pd\n25: \n26: from src.ingesta.config import (\n27:     COLUMNAS_TEXTO_NORMALIZAR,  # Lista de las 13 columnas de texto\n28:     INTERIM_NORMALIZADO,        # Ruta de salida: data/interim/homi_normalizado.parquet\n29:     INTERIM_RENOMBRADO,         # Ruta de entrada: data/interim/homi_renombrado.parquet\n30: )\n31: # Reutilizamos la función que limpia una columna completa (ver src/utils/texto.py).\n32: from src.utils.texto import normalizar_columna\n33: \n34: \n35: # =========================================================================\n36: # FUNCIÓN PRINCIPAL: Normaliza todas las columnas de texto\n37: # =========================================================================\n38: def normalizar_todas_columnas(df: pd.DataFrame) -> pd.DataFrame:\n39:     \"\"\"\n40:     Aplica la normalización textual a las 13 columnas de texto del dataset.\n41: \n42:     Equivalencia R (líneas 83-\n<truncated 5907 bytes>\n  Raises\n155:     ------\n156:     FileNotFoundError\n157:         Si el archivo intermedio no existe.\n158:     \"\"\"\n159:     # Si el archivo todavía no existe (no se ha corrido la Fase 2), avisamos con un error claro.\n160:     if not INTERIM_NORMALIZADO.exists():\n161:         raise FileNotFoundError(\n162:             f\"No existe el archivo intermedio: {INTERIM_NORMALIZADO}. \"\n163:             \"Ejecuta primero la Fase 2 (normalizar_todas_columnas + guardar).\"\n164:         )\n165:     return pd.read_parquet(INTERIM_NORMALIZADO, engine=\"pyarrow\") #Saco y devuelvo mis datos guardados, en tipo dataframe\n166: \n167: \n168: # =========================================================================\n169: # EJECUCIÓN DIRECTA (para pruebas rápidas desde terminal)\n170: # =========================================================================\n171: # `__name__` es una variable especial que Python crea automáticamente:\n172: #   - Si ejecutas ESTE archivo directamente (python -m src.limpieza.normalizar_texto),\n173: #     __name__ vale \"__main__\" → el bloque de abajo SÍ se ejecuta.\n174: #   - Si este archivo es IMPORTADO desde otro (ej. desde main.py),\n175: #     __name__ vale \"src.limpieza.normalizar_texto\" → el bloque NO se ejecuta.\n176: # Así podemos probar la fase por separado sin afectar al pipeline completo.\n177: if __name__ == \"__main__\":\n178:     # Permite ejecutar: python -m src.limpieza.normalizar_texto\n179:     print(\"Cargando datos de Fase 1 (homi_renombrado.parquet)...\")\n180: \n181:     if not INTERIM_RENOMBRADO.exists():\n182:         raise FileNotFoundError(\n183:             f\"No existe {INTERIM_RENOMBRADO}. Ejecuta primero la Fase 1.\"\n184:         )\n185: \n186:     df = pd.read_parquet(INTERIM_RENOMBRADO, engine=\"pyarrow\")  # Lee la salida de la Fase 1\n187:     df = normalizar_todas_columnas(df)                          # Aplica la Fase 2\n188:     guardar_intermedio_normalizado(df)                          # Guarda el resultado\n189:     print(\"\\n[OK] Fase 2 completada exitosamente.\")  # \"\\n\" = salto de línea","truncated_fields":["content"]}
