{"step_index":399,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:33:30Z","content":"Created At: 2026-11-10T10:33:30-05:00\nCompleted At: 2026-11-10T10:33:30-05:00\nShowing lines 1-298 of 298\n1: \"\"\"\n2: main.py — Orquestador del pipeline de preprocesamiento.\n3: \n4: Ejecuta todas las fases en secuencia. Cada fase se activa\n5: progresivamente a medida que se implementan los módulos.\n6: \n7: Uso:\n8:     python main.py\n9: \n10: ¿Qué es un \"orquestador\"?\n11:     Es el \"director de orquesta\": este archivo NO contiene la lógica pesada\n12:     (no limpia textos ni repara coordenadas él mismo), sino que llama en orden\n13:     a las funciones de cada módulo de `src/` y le pasa el resultado de una\n14:     fase a la siguiente, como una línea de ensamblaje.\n15: \"\"\"\n16: \n17: # ── Imports Fase 1: Ingesta ──\n18: # Importa las funciones encargadas de cargar los datos originales\n19: # de homicidios y guardar una copia intermedia con los nombres de\n20: # las columnas estandarizados.\n21: # Sintaxis `from paquete.modulo import funcion`:\n22: #   src.ingesta.cargar_datos → equivale a la ruta src/ingesta/cargar_datos.py\n23: #   (en Python las carpetas se separan con puntos \".\" al importar).\n24: from src.ingesta.cargar_datos import (\n25:     cargar_homicidios_raw,\n26:     guardar_intermedio_renombrado,\n27: )\n28: \n29: # ── Imports Fase 2: Limpieza textual ──\n30: # Importa las funciones de normalización de texto (strip + upper + unidecode)\n31: # y la auditoría de caracteres especiales (tildes, eñes, diéresis).\n32: from src.limpieza.normalizar_texto import (\n33:     normalizar_todas_columnas,\n34:     guardar_intermedio_normalizado,\n35: )\n36: from src.reportes.auditoria_caracteres import auditar_caracteres_especiales\n37: \n38: # ── Imports Fase 3: Filtrado temporal y geográfico ──\n39: # Importa las funciones de filtrado por año y exclusión de Galápagos,\n40: # así como el reporte de control que audita los conteos en cada paso.\n41: from src.limpieza.filtros import (\n42:     convertir_anio_a_entero,\n43:     excluir_galapagos,\n44:     filtrar_anio,\n45:     guardar_insular,\n46:     guardar_in\n<truncated 11142 bytes>\nuántos registros rescató individualmente cada uno\n268:     # de los 4 escenarios decimales para dejarlo documentado en `auditoria_pipeline.json`.\n269:     detalle_escenarios = {\n270:         \"escenario_1_positivo_entero\": len(esc1),\n271:         \"escenario_2_positivo_cero\": len(esc2),\n272:         \"escenario_3_negativo_entero\": len(esc3),\n273:         \"escenario_4_negativo_cero\": len(esc4),\n274:     }\n275:     # Pasamos los objetos ya cargados en memoria (`df_georreferenciado`, `mapa`) y los\n276:     # conteos exactos de cada etapa para verificar el cuadre contable de extremo a extremo.\n277:     ejecutar_exportacion_final(\n278:         df_georreferenciado=df_georreferenciado,\n279:         mapa_cantones=mapa,\n280:         n_brutos_iniciales=len(df_entrada_fase3),                                # Total inicial (Fase 1)\n281:         n_excluidos_temporal=len(df_entrada_fase3) - len(df_post_filtro_anio),   # Excluidos por año > 2024 o NaN\n282:         n_excluidos_insular=len(df_insular),                                     # Excluidos por Galápagos\n283:         n_universo_filtrado=len(df_continental),                                 # Universo continental 2010-2024\n284:         n_geo_correctos=len(geo_correctos),                                      # Validados al 1er sjoin\n285:         n_rescatados_algoritmo=n_reparados_total,                                # Rescatados por los 4 escenarios\n286:         n_limbo_retenidos=len(limbo_formato_correcto),                           # Con punto decimal retenidos\n287:         n_descartados_irreversibles=len(df_continental) - len(df_georreferenciado),  # Irrecuperables excluidos\n288:         detalle_escenarios=detalle_escenarios,\n289:     )\n290: \n291:     print(\"\\n[OK] Pipeline completo (Fases 1 a 5) ejecutado exitosamente.\")\n292: \n293: \n294: # Punto de entrada del programa:\n295: # Cuando ejecutas `python main.py` en la terminal, Python pone \"__main__\" en\n296: # la variable especial `__name__` y entra aquí llamando a main().\n297: if __name__ == \"__main__\":\n298:     main()","truncated_fields":["content"]}
