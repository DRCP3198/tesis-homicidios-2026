', 'geometry']], how='left', predicate='intersects')\n\n# Calcular distancia en metros (UTM 17S EPSG:32717) al poligono mas cercano y al canton declarado\ngdf_utm = gdf_limbo.to_crs(epsg=32717)\nmapa_utm = mapa.to_crs(epsg=32717)\n\nfor idx, row in sj.iterrows():\n    pt = gdf_utm.loc[idx, 'geometry']\n    # Poligono mas cercano\n    dists = mapa_utm.geometry.distance(pt)\n    min_idx = dists.idxmin()\n    min_dist_m = dists.loc[min_idx]\n    nearest_prov = mapa_utm.loc[min_idx, 'DPA_DESPRO']\n    nearest_can = mapa_utm.loc[min_idx, 'CANTON_MAPA']\n    # Distancia al canton reportado (si existe en el mapa)\n    rep_can = row['canton']\n    if rep_can in mapa_utm['CANTON_MAPA'].values:\n        dist_rep_m = mapa_utm[mapa_utm['CANTON_MAPA'] == rep_can].geometry.distance(pt).min()\n    else:\n        dist_rep_m = -1.0\n    sj.loc[idx, 'nearest_prov'] = nearest_prov\n    sj.loc[idx, 'nearest_can'] = nearest_can\n    sj.loc[idx, 'dist_nearest_m'] = round(min_dist_m, 1)\n    sj.loc[idx, 'dist_rep_m'] = round(dist_rep_m, 1)\n\ncols = ['codigo_caso', 'anio_hecho', 'provincia', 'canton', 'DPA_DESPRO', 'CANTON_MAPA', 'nearest_can', 'dist_nearest_m', 'dist_rep_m', 'lat_num', 'lon_num']\nprint(sj[cols].sort_values(['DPA_DESPRO', 'provincia', 'canton']).to_string())\n\"","WaitMsBeforeAsync":8000,"toolSummary":"Analyze exact distances in meters for the 62 limbo cases"}}]}
