{"step_index":399,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:33:30Z","content":"Created At: 2026-11-10T10:33:30-05:00\nCompleted At: 2026-11-10T10:33:30-05:00\nShowing lines 1-298 of 298\n1: \"\"\"\n2: main.py — Orquestador del pipeline de preprocesamiento.\n3: \n4: Ejecuta todas las fases en secuencia. Cada fase se activa\n5: progresivamente a medida que se implementan los módulos.\n6: \n7: Uso:\n8:     python main.py\n9: \n10: ¿Qué es un \"orquestador\"?\n11:     Es el \"director de orquesta\": este archivo NO contiene la lógica pesada\n12:     (no limpia textos ni repara coordenadas él mismo), sino que llama en orden\n13:     a las funciones de cada módulo de `src/` y le pasa el resultado de una\n14:     fase a la siguiente, como una línea de ensamblaje.\n15: \"\"\"\n16: \n17: # ── Imports Fase 1: Ingesta ──\n18: # Importa las funciones encargadas de cargar los datos originales\n19: # de homicidios y guardar una copia intermedia con los nombres de\n20: # las columnas estandarizados.\n21: # Sintaxis `from paquete.modulo import funcion`:\n22: #   src.ingesta.cargar_datos → equivale a la ruta src/ingesta/cargar_datos.py\n23: #   (en Python las carpetas se separan con puntos \".\" al importar).\n24: from src.ingesta.cargar_datos import (\n25:     cargar_homicidios_raw,\n26:     guardar_intermedio_renombrado,\n27: )\n28: \n29: # ── Imports Fase 2: Limpieza textual ──\n30: # Importa las funciones de normalización de texto (strip + upper + unidecode)\n31: # y la auditoría de caracteres especiales (tildes, eñes, diéresis).\n32: from src.limpieza.normalizar_texto import (\n33:     normalizar_todas_columnas,\n34:     guardar_intermedio_normalizado,\n35: )\n36: from src.reportes.auditoria_caracteres import auditar_caracteres_especiales\n37: \n38: # ── Imports Fase 3: Filtrado temporal y geográfico ──\n39: # Importa las funciones de filtrado por año y exclusión de Galápagos,\n40: # así como el reporte de control que audita los conteos en cada paso.\n41: from src.limpieza.filtros import (\n42:     convertir_anio_a_entero,\n43:     excluir_galapagos,\n44:     filtrar_anio,\n45:     guardar_insular,\n46:     guardar_intermedio_filtrado,\n47: )\n48: from src.reportes.reporte_control import imprimir_conteos\n49: \n50: # ── Imports Fase 4: Validación Geoespacial ──\n51: # Importa los módulos del pipeline geoespacial completo:\n52: # cartografía, creación de puntos, auditoría topológica,\n53: # algoritmo reparador (4 escenarios) y ensamblaje final.\n54: from src.validacion_geo.cartografia import cargar_mapa_cantonal\n55: from src.validacion_geo.ensamblaje import (\n56:     ensamblar_base_final,\n57:     guardar_artefactos_geo,\n58:     imprimir_reporte_geo,\n59: )\n60: from src.validacion_geo.geometrias import (\n61:     auditar_punto_en_poligono,\n62:     crear_geodataframe_puntos,\n63:     separar_por_formato,\n64: )\n65: from src.validacion_geo.reparacion import reparar_coordenadas_corruptas\n66: \n67: # ── Imports Fase 5: Etiquetado Final, Exportación y Visualización ──\n68: # Importa las librerías de tipos (`gpd`, `pd`) y los tres submódulos finales (Pasos 5.1 a 5.6):\n69: #   1. exportador.py        → selección de 21 columnas, tipado estricto y escritura CSV/Parquet/GeoPackage.\n70: #   2. metricas_pipeline.py → auditoría estadística del ciclo de vida completo (JSON + Markdown + consola).\n71: #   3. mapa_diagnostico.py  → figura cartográfica desatendida (`Agg`) en alta resolución (300 DPI).\n72: import geopandas as gpd\n73: import pandas as pd\n74: \n75: from src.exportacion.exportador import (\n76:     exportar_todos_formatos,\n77:     seleccionar_y_estandarizar_columnas,\n78: )\n79: from src.ingesta.config import PROCESSED_GEORREFERENCIADO\n80: from src.reportes.metricas_pipeline import (\n81:     ResumenAuditoriaPipeline,\n82:     generar_auditoria_pipeline,\n83: )\n84: from src.visualizacion.mapa_diagnostico import generar_mapa_diagnostico\n85: \n86: #pipeline = proceso general que coordina las etapas de preprocesamiento.\n87: #ingesta = módulo encargado de cargar los datos originales.\n88: \n89: \n90: # ¿Por qué todos los parámetros de `ejecutar_exportacion_final` tienen `| None = None`?\n91: #   • `pd.DataFrame | None = None` indica un parámetro OPCIONAL: puede recibir el objeto en\n92: #     memoria (cuando lo llama `main()` tras terminar la Fase 4) o puede omitirse (`None`).\n93: #   • Si se omite, la propia función carga automáticamente desde disco los artefactos Parquet\n94: #     y el shapefile cantonal, permitiendo re-ejecutar solo la etapa final sin repetir Fases 1-4.\n95: def ejecutar_exportacion_final(\n96:     df_georreferenciado: pd.DataFrame | None = None,\n97:     mapa_cantones: gpd.GeoDataFrame | None = None,\n98:     n_brutos_iniciales: int | None = None,\n99:     n_excluidos_temporal: int | None = None,\n100:     n_excluidos_insular: int | None = None,\n101:     n_universo_filtrado: int | None = None,\n102:     n_geo_correctos: int | None = None,\n103:     n_rescatados_algoritmo: int | None = None,\n104:     n_limbo_retenidos: int | None = None,\n105:     n_descartados_irreversibles: int | None = None,\n106:     detalle_escenarios: dict[str, int] | None = None,\n107: ) -> tuple[pd.DataFrame, ResumenAuditoriaPipeline]:\n108:     \"\"\"\n109:     Orquesta los Pasos 5.1 a 5.6 (Etiquetado Final, Exportación, Auditoría y Mapa).\n110: \n111:     Puede invocarse al final de `main()` pasando los objetos en memoria, o bien de\n112:     manera independiente (`ejecutar_exportacion_final()`) leyendo `data/processed/homi_georreferenciado.parquet`.\n113:     \"\"\"\n114:     print(\"=\" * 60)\n115:     print(\"  FASE 5: ETIQUETADO FINAL, EXPORTACIÓN Y VISUALIZACIÓN\")\n116:     print(\"=\" * 60)\n117: \n118:     # Carga perezosa (lazy fallback): solo lee de disco si el dato no vino ya en RAM.\n119:     if df_georreferenciado is None:\n120:         df_georreferenciado = pd.read_parquet(PROCESSED_GEORREFERENCIADO)\n121: \n122:     if mapa_cantones is None:\n123:         mapa_cantones = cargar_mapa_cantonal()\n124: \n125:     # Paso 5.1: Proyecta únicamente las 21 columnas limpias, renombra `lat_num`/`lon_num`\n126:     # hacia `latitud`/`longitud`, descarta `ID_temp` y convierte cada columna a su dtype óptimo.\n127:     df_etiquetado = seleccionar_y_estandarizar_columnas(df_georreferenciado)\n128: \n129:     # Pasos 5.2, 5.3 y 5.4: Persiste simultáneamente CSV (UTF-8), Parquet (Snappy) y GeoPackage (EPSG:4326).\n130:     exportar_todos_formatos(df_etiquetado)\n131: \n132:     # Paso 5.5: Calcula métricas extremo a extremo, verifica cuadre contable y escribe JSON + Markdown.\n133:     resumen_auditoria = generar_auditoria_pipeline(\n134:         df_final=df_etiquetado,\n135:         n_brutos_iniciales=n_brutos_iniciales,\n136:         n_excluidos_temporal=n_excluidos_temporal,\n137:         n_excluidos_insular=n_excluidos_insular,\n138:         n_universo_filtrado=n_universo_filtrado,\n139:         n_geo_correctos=n_geo_correctos,\n140:         n_rescatados_algoritmo=n_rescatados_algoritmo,\n141:         n_limbo_retenidos=n_limbo_retenidos,\n142:         n_descartados_irreversibles=n_descartados_irreversibles,\n143:         detalle_escenarios=detalle_escenarios,\n144:     )\n145: \n146:     # Paso 5.6: Renderiza el mapa diagnóstico sobre cantones y provincias disueltas a 300 DPI.\n147:     generar_mapa_diagnostico(df_etiquetado, mapa_cantones)\n148: \n149:     # Devuelve una tupla `(DataFrame_final, ResumenAuditoriaPipeline)` para inspección o tests.\n150:     return df_etiquetado, resumen_auditoria\n151: \n152: \n153: def main():\n154:     \"\"\"Función principal encargada de ejecutar el pipeline de preprocesamiento.\"\"\"\n155: \n156:     # ── FASE 1: Ingesta y Renombrado ──\n157:     # Carga los datos originales de homicidios y guarda\n158:     # una versión intermedia con las columnas renombradas.\n159:     df = cargar_homicidios_raw()         # Lee el CSV crudo y renombra las 21 columnas.\n160:     guardar_intermedio_renombrado(df)    # Guarda data/interim/homi_renombrado.parquet.\n161: \n162:     # ── FASE 2: Limpieza y Normalización Textual ──\n163:     # Aplica strip() + upper() + unidecode() a las 13 columnas de texto.\n164:     # Equivale al bloque mutate() con iconv() + str_trim() + str_to_upper() del R.\n165:     df = normalizar_todas_columnas(df)   # MAYÚSCULAS + sin tildes/eñes + sin espacios extra.\n166:     auditar_caracteres_especiales(df)    # Verifica con regex que no haya quedado ni una tilde.\n167:     guardar_intermedio_normalizado(df)   # Guarda data/interim/homi_normalizado.parquet.\n168: \n169:     # ── FASE 3: Filtrado temporal y geográfico ──\n170:     # Aplica los filtros de año (<=2024) y excluye cantones insulares.\n171:     # Equivale al bloque filter() del R (líneas 132-150).\n172:     print(\"=\" * 60)\n173:     print(\"  FASE 3: FILTRADO TEMPORAL Y GEOGRÁFICO\")\n174:     print(\"=\" * 60)\n175: \n176:     # Guardamos una \"foto\" (.copy()) de la tabla antes de cada paso, para que\n177:     # al final `imprimir_conteos` pueda comparar cuántos registros había en cada etapa.\n178:     df_entrada_fase3 = df.copy()\n179: \n180:     # Paso 3.1: Conversión de anio_hecho a entero\n181:     df = convertir_anio_a_entero(df)\n182:     df_post_conversion = df.copy()\n183: \n184:     # Paso 3.2: Filtro temporal (anio_hecho <= 2024)\n185:     df = filtrar_anio(df)\n186:     df_post_filtro_anio = df.copy()\n187: \n188:     # Pasos 3.3 y 3.4: Exclusión de Galápagos + separación insular\n189:     # `excluir_galapagos` devuelve 2 tablas a la vez; las recibimos separadas por coma.\n190:     df_continental, df_insular = excluir_galapagos(df)\n191:     guardar_insular(df_insular)  # Guarda los insulares aparte para no perder trazabilidad.\n192: \n193:     # Paso 3.5: Reporte de conteos (auditoría de integridad)\n194:     # Comprueba que: originales == eliminados + insulares + continentales.\n195:     imprimir_conteos(\n196:         df_original=df_entrada_fase3,\n197:         df_post_conversion=df_post_conversion,\n198:         df_post_filtro_anio=df_post_filtro_anio,\n199:         df_continental=df_continental,\n200:         df_insular=df_insular,\n201:     )\n202: \n203:     # Paso 3.6: Guardar intermedio continental filtrado\n204:     guardar_intermedio_filtrado(df_continental)  # data/interim/homi_filtrado_2024.parquet\n205: \n206:     # ── FASE 4: Validación Geoespacial Completa ──\n207:     # Corresponde a las Fases R 5-9 (líneas 206-484).\n208:     print(\"=\" * 60)\n209:     print(\"  FASE 4: VALIDACIÓN GEOESPACIAL COMPLETA\")\n210:     print(\"=\" * 60)\n211: \n212:     # Pasos 4.1–4.2: Carga y homologación del mapa cantonal\n213:     # Abre nxcantones.shp, pasa a WGS84, repara polígonos y quita Galápagos.\n214:     mapa = cargar_mapa_cantonal()\n215: \n216:     # Paso 4.3: Crear GeoDataFrame de puntos desde coordenadas\n217:     # Convierte latitud/longitud en objetos geométricos Point y asigna ID_temp.\n218:     gdf_puntos = crear_geodataframe_puntos(df_continental)\n219:     n_entrada_fase4 = len(gdf_puntos)  # Total de puntos que entraron a validarse.\n220: \n221:     # Paso 4.4: Primera auditoría topológica (sjoin vectorizado)\n222:     # Separa los que caen DENTRO de su cantón (geo_correctos) vs. FUERA (geo_corregir).\n223:     geo_correctos, geo_corregir = auditar_punto_en_poligono(gdf_puntos, mapa)\n224: \n225:     # Paso 4.5: Separar por formato decimal\n226:     # De los que cayeron fuera: ¿tienen punto decimal (limbo) o les falta (a reparar)?\n227:     limbo_formato_correcto, geo_corregir_decimales = separar_por_formato(\n228:         geo_corregir\n229:     )\n230: \n231:     # Paso 4.6: Algoritmo reparador de coordenadas corruptas (4 escenarios)\n232:     # Prueba en orden: X.XXX → 0.XXX → -X.XXX → -0.XXX y valida cada intento con sjoin.\n233:     esc1, esc2, esc3, esc4, no_reparados = reparar_coordenadas_corruptas(\n234:         geo_corregir_decimales, mapa\n235:     )\n236:     # Suma total de casos rescatados entre los 4 escenarios.\n237:     n_reparados_total = sum(len(d) for d in [esc1, esc2, esc3, esc4])\n238: \n239:     # Paso 4.7: Ensamblaje y limpieza final\n240:     # Une correctos + reparados + limbo, borra columnas auxiliares y filtra NaN.\n241:     df_georreferenciado = ensamblar_base_final(\n242:         geo_correctos=geo_correctos,\n243:         reparados_esc1=esc1,\n244:         reparados_esc2=esc2,\n245:         reparados_esc3=esc3,\n246:         reparados_esc4=esc4,\n247:         limbo_formato_correcto=limbo_formato_correcto,\n248:         no_reparados=no_reparados,\n249:     )\n250: \n251:     # Paso 4.8: Exportar artefactos Parquet\n252:     # Guarda geo_correctos.parquet (interim) y homi_georreferenciado.parquet (processed).\n253:     guardar_artefactos_geo(geo_correctos, df_georreferenciado)\n254: \n255:     # Reporte estadístico de la Fase 4\n256:     imprimir_reporte_geo(\n257:         n_procesados=n_entrada_fase4,\n258:         n_correctos=len(geo_correctos),\n259:         n_reparados_total=n_reparados_total,\n260:         n_limbo=len(limbo_formato_correcto),\n261:         n_no_reparados=len(no_reparados),\n262:         n_final=len(df_georreferenciado),\n263:     )\n264: \n265:     # ── FASE 5: Etiquetado final, exportación multiformato, auditoría y mapa ──\n266:     # Corresponde a las Fases R 10-13 (líneas 486-627): concluye la migración completa.\n267:     # Armamos un diccionario con cuántos registros rescató individualmente cada uno\n268:     # de los 4 escenarios decimales para dejarlo documentado en `auditoria_pipeline.json`.\n269:     detalle_escenarios = {\n270:         \"escenario_1_positivo_entero\": len(esc1),\n271:         \"escenario_2_positivo_cero\": len(esc2),\n272:         \"escenario_3_negativo_entero\": len(esc3),\n273:         \"escenario_4_negativo_cero\": len(esc4),\n274:     }\n275:     # Pasamos los objetos ya cargados en memoria (`df_georreferenciado`, `mapa`) y los\n276:     # conteos exactos de cada etapa para verificar el cuadre contable de extremo a extremo.\n277:     ejecutar_exportacion_final(\n278:         df_georreferenciado=df_georreferenciado,\n279:         mapa_cantones=mapa,\n280:         n_brutos_iniciales=len(df_entrada_fase3),                                # Total inicial (Fase 1)\n281:         n_excluidos_temporal=len(df_entrada_fase3) - len(df_post_filtro_anio),   # Excluidos por año > 2024 o NaN\n282:         n_excluidos_insular=len(df_insular),                                     # Excluidos por Galápagos\n283:         n_universo_filtrado=len(df_continental),                                 # Universo continental 2010-2024\n284:         n_geo_correctos=len(geo_correctos),                                      # Validados al 1er sjoin\n285:         n_rescatados_algoritmo=n_reparados_total,                                # Rescatados por los 4 escenarios\n286:         n_limbo_retenidos=len(limbo_formato_correcto),                           # Con punto decimal retenidos\n287:         n_descartados_irreversibles=len(df_continental) - len(df_georreferenciado),  # Irrecuperables excluidos\n288:         detalle_escenarios=detalle_escenarios,\n289:     )\n290: \n291:     print(\"\\n[OK] Pipeline completo (Fases 1 a 5) ejecutado exitosamente.\")\n292: \n293: \n294: # Punto de entrada del programa:\n295: # Cuando ejecutas `python main.py` en la terminal, Python pone \"__main__\" en\n296: # la variable especial `__name__` y entra aquí llamando a main().\n297: if __name__ == \"__main__\":\n298:     main()"}
