{"step_index":401,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:33:39Z","content":"Created At: 2026-11-10T10:33:39-05:00\nCompleted At: 2026-11-10T10:33:39-05:00\nShowing lines 250-630 of 630\n250:     if n_universo_filtrado is None:\n251:         if INTERIM_FILTRADO.exists():\n252:             n_universo_filtrado = len(pd.read_parquet(INTERIM_FILTRADO))\n253:         else:\n254:             n_universo_filtrado = n_finales\n255: \n256:     if n_brutos_iniciales is None:\n257:         if INTERIM_RENOMBRADO.exists():\n258:             n_brutos_iniciales = len(pd.read_parquet(INTERIM_RENOMBRADO))\n259:         else:\n260:             n_brutos_iniciales = n_universo_filtrado\n261: \n262:     if n_excluidos_insular is None:\n263:         if INTERIM_INSULAR_EXCLUIDO.exists():\n264:             n_excluidos_insular = len(pd.read_parquet(INTERIM_INSULAR_EXCLUIDO))\n265:         else:\n266:             n_excluidos_insular = 0\n267: \n268:     if n_excluidos_temporal is None:\n269:         # `max(0, ...)` evita conteos negativos si en un test sintético se pasaran subconjuntos parciales.\n270:         n_excluidos_temporal = max(\n271:             0, n_brutos_iniciales - n_universo_filtrado - n_excluidos_insular\n272:         )\n273: \n274:     # ── 3. Resolver desglose geoespacial (Fase 4) ──\n275:     if n_geo_correctos is None:\n276:         if INTERIM_GEO_CORRECTOS.exists():\n277:             n_geo_correctos = len(pd.read_parquet(INTERIM_GEO_CORRECTOS))\n278:         else:\n279:             n_geo_correctos = n_finales\n280: \n281:     # Total de puntos que no intersectaron su cantón declarado en la primera pasada espacial.\n282:     n_fuera_poligono = max(0, n_universo_filtrado - n_geo_correctos)\n283: \n284:     if n_descartados_irreversibles is None:\n285:         n_descartados_irreversibles = max(0, n_universo_filtrado - n_finales)\n286: \n287:     # Resolución algebraica entre `limbo` y `rescatados`:\n288:     # Sabemos que `n_finales == n_geo_correctos + n_limbo_retenidos + n_rescatados_algoritmo`.\n289:     # Si falta uno de los dos términos, se despeja del otro; si faltan ambos, se infiere desde Parquet.\n290:     if n_limbo_retenidos is None and n_rescatados_algoritmo is None:\n291:         inferido_limbo = _inferir_limbo_desde_artefactos(\n292:             INTERIM_FILTRADO, INTERIM_GEO_CORRECTOS\n293:         )\n294:         if inferido_limbo is not None:\n295:             n_limbo_retenidos = inferido_limbo\n296:             n_rescatados_algoritmo = max(\n297:                 0, (n_finales - n_geo_correctos) - n_limbo_retenidos\n298:             )\n299:         else:\n300:             n_rescatados_algoritmo = 0\n301:             n_limbo_retenidos = max(0, n_finales - n_geo_correctos)\n302:     elif n_limbo_retenidos is None:\n303:         n_limbo_retenidos = max(\n304:             0, (n_finales - n_geo_correctos) - int(n_rescatados_algoritmo or 0)\n305:         )\n306:     elif n_rescatados_algoritmo is None:\n307:         n_rescatados_algoritmo = max(\n308:             0, (n_finales - n_geo_correctos) - n_limbo_retenidos\n309:         )\n310: \n311:     # Todo candidato sin punto decimal terminó en uno de dos destinos mutuamente excluyentes:\n312:     # o fue rescatado por alguno de los 4 escenarios, o fue descartado como irreversible.\n313:     n_corruptos_sin_decimal = n_rescatados_algoritmo + n_descartados_irreversibles\n314: \n315:     # ── 4. Cálculo seguro de tasas porcentuales ──\n316:     # Sintaxis de expresión condicional ternaria en Python:\n317:     #   `valor_si_verdadero if condicion else valor_si_falso`\n318:     # Protege contra `ZeroDivisionError` cuando un denominador vale `0` (por ejemplo, si hubiese\n319:     # `0` candidatos corruptos sin punto decimal). `round(valor, 4)` redondea a 4 decimales.\n320:     tasa_retencion_filtro = (\n321:         round((n_universo_filtrado / n_brutos_iniciales) * 100, 4)\n322:         if n_brutos_iniciales > 0\n323:         else 0.0\n324:     )\n325:     precision_topologica_inicial = (\n326:         round((n_geo_correctos / n_universo_filtrado) * 100, 4)\n327:         if n_universo_filtrado > 0\n328:         else 0.0\n329:     )\n330:     tasa_rescate_corruptos = (\n331:         round((n_rescatados_algoritmo / n_corruptos_sin_decimal) * 100, 4)\n332:         if n_corruptos_sin_decimal > 0\n333:         else 0.0\n334:     )\n335:     # Equivalente directo al indicador de efectividad de la Fase 11 de R (línea 518):\n336:     # `(nrow(homi_Nueva) / nrow(homi_2010_2024)) * 100`\n337:     efectividad_geo = (\n338:         round((n_finales / n_universo_filtrado) * 100, 4)\n339:         if n_universo_filtrado > 0\n340:         else 0.0\n341:     )\n342:     retencion_global = (\n343:         round((n_finales / n_brutos_iniciales) * 100, 4)\n344:         if n_brutos_iniciales > 0\n345:         else 0.0\n346:     )\n347: \n348:     # ── 5. Verificación matemática de integridad contable (3 invariantes del pipeline) ──\n349:     # Invariante 1 (Filtrado Fase 3): todo registro bruto se clasificó en temporal, insular o continental.\n350:     cuadra_filtrado = (\n351:         n_excluidos_temporal + n_excluidos_insular + n_universo_filtrado\n352:     ) == n_brutos_iniciales\n353: \n354:     # Invariante 2 (Partición Fase 4): todo registro continental fue a correctos, rescatados, limbo o descartados.\n355:     cuadra_validacion_geo = (\n356:         n_geo_correctos\n357:         + n_rescatados_algoritmo\n358:         + n_limbo_retenidos\n359:         + n_descartados_irreversibles\n360:     ) == n_universo_filtrado\n361: \n362:     # Invariante 3 (Ensamble Fase 5): el dataset final es exactamente la unión disjunta de los tres grupos válidos.\n363:     cuadra_ensamble = (\n364:         n_geo_correctos + n_rescatados_algoritmo + n_limbo_retenidos\n365:     ) == n_finales\n366: \n367:     # Solo es `True` si las tres ecuaciones de balance se cumplen simultáneamente.\n368:     integridad_ok = bool(cuadra_filtrado and cuadra_validacion_geo and cuadra_ensamble)\n369: \n370:     # ── 6. Perfil estructural y cobertura geográfica/temporal del dataset final ──\n371:     nombres_cols = list(df_final.columns)\n372:     # Comprensión de diccionario que registra el nombre textual del `dtype` de cada columna\n373:     # (ej. `{\"codigo_caso\": \"string\", \"fecha_hecho\": \"datetime64[ns]\", \"provincia\": \"category\", ...}`).\n374:     esquema_tipos = {col: str(dtype) for col, dtype in df_final.dtypes.items()}\n375: \n376:     anio_min: int | None = None\n377:     anio_max: int | None = None\n378:     if \"anio_hecho\" in df_final.columns and df_final[\"anio_hecho\"].notna().any():\n379:         # Convertimos el escalar de Pandas/NumPy a `int` nativo de Python para que `json.dump`\n380:         # pueda serializarlo (el serializador JSON estándar no acepta `np.int64` directamente).\n381:         anio_min = int(df_final[\"anio_hecho\"].min())\n382:         anio_max = int(df_final[\"anio_hecho\"].max())\n383: \n384:     fecha_min: str | None = None\n385:     fecha_max: str | None = None\n386:     if \"fecha_hecho\" in df_final.columns and df_final[\"fecha_hecho\"].notna().any():\n387:         fechas_dt = pd.to_datetime(df_final[\"fecha_hecho\"], errors=\"coerce\").dropna()\n388:         if len(fechas_dt) > 0:\n389:             # `.strftime(\"%Y-%m-%d\")` formatea un objeto `Timestamp` al estándar ISO `\"2010-01-01\"`.\n390:             fecha_min = fechas_dt.min().strftime(\"%Y-%m-%d\")\n391:             fecha_max = fechas_dt.max().strftime(\"%Y-%m-%d\")\n392: \n393:     # `.nunique(dropna=True)` cuenta cuántos valores distintos no nulos existen en la columna\n394:     # (equivale a `n_distinct(x, na.rm = TRUE)` de `dplyr` en R).\n395:     n_provincias = (\n396:         int(df_final[\"provincia\"].nunique(dropna=True))\n397:         if \"provincia\" in df_final.columns\n398:         else 0\n399:     )\n400:     n_cantones = (\n401:         int(df_final[\"canton\"].nunique(dropna=True))\n402:         if \"canton\" in df_final.columns\n403:         else 0\n404:     )\n405: \n406:     # Capturamos la hora exacta UTC en formato estándar ISO-8601 (`YYYY-MM-DDTHH:MM:SSZ`).\n407:     marca_utc = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n408: \n409:     # `detalle_escenarios or {}`: si `detalle_escenarios` es `None`, sustituye por un diccionario vacío `{}`.\n410:     return ResumenAuditoriaPipeline(\n411:         fecha_generacion_utc=marca_utc,\n412:         registros_brutos_iniciales=n_brutos_iniciales,\n413:         registros_excluidos_temporal=n_excluidos_temporal,\n414:         registros_excluidos_insular=n_excluidos_insular,\n415:         registros_universo_filtrado=n_universo_filtrado,\n416:         registros_finales_etiquetados=n_finales,\n417:         geo_correctos_primera_auditoria=n_geo_correctos,\n418:         candidatos_fuera_poligono=n_fuera_poligono,\n419:         limbo_formato_correcto_retenidos=n_limbo_retenidos,\n420:         candidatos_corruptos_sin_decimal=n_corruptos_sin_decimal,\n421:         coordenadas_rescatadas_algoritmo=n_rescatados_algoritmo,\n422:         coordenadas_descartadas_irreversibles=n_descartados_irreversibles,\n423:         detalle_rescate_por_escenario=detalle_escenarios or {},\n424:         tasa_retencion_post_filtro_pct=tasa_retencion_filtro,\n425:         precision_topologica_inicial_pct=precision_topologica_inicial,\n426:         tasa_rescate_sobre_corruptos_pct=tasa_rescate_corruptos,\n427:         efectividad_georreferenciacion_pct=efectividad_geo,\n428:         retencion_global_bruto_a_final_pct=retencion_global,\n429:         integridad_contable_ok=integridad_ok,\n430:         columnas_finales=len(nombres_cols),\n431:         nombres_columnas=nombres_cols,\n432:         esquema_tipos=esquema_tipos,\n433:         anio_min=anio_min,\n434:         anio_max=anio_max,\n435:         fecha_min=fecha_min,\n436:         fecha_max=fecha_max,\n437:         provincias_unicas=n_provincias,\n438:         cantones_unicos=n_cantones,\n439:     )\n440: \n441: \n442: # =========================================================================\n443: # PASO 5.5b — Persistencia estructurada en JSON y Markdown + consola\n444: # =========================================================================\n445: def exportar_reporte_json(\n446:     resumen: ResumenAuditoriaPipeline,\n447:     ruta_salida: Path = SALIDA_AUDITORIA_JSON,\n448: ) -> Path:\n449:     \"\"\"\n450:     Guarda el resumen estadístico completo en un archivo JSON estructurado UTF-8.\n451: \n452:     Parameters\n453:     ----------\n454:     resumen : ResumenAuditoriaPipeline\n455:         Objeto con todas las métricas calculadas.\n456:     ruta_salida : Path, optional\n457:         Ruta destino del JSON (`reports/auditoria_pipeline.json` por defecto).\n458: \n459:     Returns\n460:     -------\n461:     Path\n462:         Ruta del archivo JSON escrito.\n463:     \"\"\"\n464:     ruta_salida = Path(ruta_salida)\n465:     ruta_salida.parent.mkdir(parents=True, exist_ok=True)\n466: \n467:     # Bloque `with open(...) as archivo_json:` (administrador de contexto / Context Manager):\n468:     #   • `mode=\"w\"` abre el archivo para escritura (sobrescribe si existía).\n469:     #   • `encoding=\"utf-8\"` asegura codificación internacional uniforme.\n470:     #   • Al terminar el bloque indentado, Python invoca automáticamente `archivo_json.close()`,\n471:     #     liberando el descriptor del sistema operativo incluso si ocurriera una excepción.\n472:     # Parámetros de `json.dump(...)`:\n473:     #   • `resumen.to_dict()`: diccionario plano con todos los campos del dataclass.\n474:     #   • `ensure_ascii=False`: escribe caracteres acentuados reales en vez de secuencias `\\u00f3`.\n475:     #   • `indent=2`: formatea el JSON con sangría legible de 2 espacios por nivel.\n476:     with open(ruta_salida, mode=\"w\", encoding=\"utf-8\") as archivo_json:\n477:         json.dump(resumen.to_dict(), archivo_json, ensure_ascii=False, indent=2)\n478: \n479:     print(f\"        Reporte JSON guardado: {ruta_salida}\")\n480:     return ruta_salida\n481: \n482: \n483: def exportar_reporte_markdown(\n484:     resumen: ResumenAuditoriaPipeline,\n485:     ruta_salida: Path = SALIDA_AUDITORIA_MD,\n486: ) -> Path:\n487:     \"\"\"\n488:     Exporta un resumen ejecutivo en formato Markdown listo para anexar al documento de tesis.\n489: \n490:     Parameters\n491:     ----------\n492:     resumen : ResumenAuditoriaPipeline\n493:         Objeto con todas las métricas calculadas.\n494:     ruta_salida : Path, optional\n495:         Ruta destino del archivo Markdown (`reports/auditoria_pipeline.md` por defecto).\n496: \n497:     Returns\n498:     -------\n499:     Path\n500:         Ruta del archivo Markdown escrito.\n501:     \"\"\"\n502:     ruta_salida = Path(ruta_salida)\n503:     ruta_salida.parent.mkdir(parents=True, exist_ok=True)\n504: \n505:     estado_txt = \"VERIFICADA (100% cuadre contable)\" if resumen.integridad_contable_ok else \"OBSERVADA\"\n506:     rango_fechas = (\n507:         f\"{resumen.fecha_min} a {resumen.fecha_max}\"\n508:         if resumen.fecha_min and resumen.fecha_max\n509:         else f\"{resumen.anio_min}–{resumen.anio_max}\"\n510:     )\n511: \n512:     # Construimos el documento línea por línea en una lista `list[str]`.\n513:     # En tablas GitHub-Flavored Markdown, `:---` alinea a la izquierda y `---:` alinea números a la derecha.\n514:     lineas_md = [\n515:         \"# Auditoría Estadística Integral del Pipeline (Fases 1 a 5)\",\n516:         \"\",\n517:         f\"- **Fecha de generación (UTC):** `{resumen.fecha_generacion_utc}`\",\n518:         f\"- **Integridad contable extremo a extremo:** **{estado_txt}**\",\n519:         f\"- **Cobertura temporal validada:** `{rango_fechas}`\",\n520:         f\"- **Cobertura territorial continental:** `{resumen.provincias_unicas}` provincias | `{resumen.cantones_unicos}` cantones\",\n521:         f\"- **Esquema consolidado:** `{resumen.columnas_finales}` columnas limpias\",\n522:         \"\",\n523:         \"## 1. Trazabilidad del Ciclo de Vida de los Registros\",\n524:         \"\",\n525:         \"| Etapa del Pipeline | Registros | Porcentaje |\",\n526:         \"|---|---:|---:|\",\n527:         f\"| Registros brutos iniciales (CSV 2010–2025) | {resumen.registros_brutos_iniciales:,} | 100.00% |\",\n528:         f\"| (-) Excluidos por filtro temporal (`anio_hecho > 2024`) | {resumen.registros_excluidos_temporal:,} | — |\",\n529:         f\"| (-) Excluidos por filtro insular (Galápagos) | {resumen.registros_excluidos_insular:,} | — |\",\n530:         f\"| **(=) Universo continental de análisis (2010–2024)** | **{resumen.registros_universo_filtrado:,}** | **{resumen.tasa_retencion_post_filtro_pct:.2f}%** |\",\n531:         f\"| (+) Validados en 1ra auditoría punto-en-polígono | {resumen.geo_correctos_primera_auditoria:,} | {resumen.precision_topologica_inicial_pct:.2f}% |\",\n532:         f\"| (+) Rescatados por algoritmo reparador decimal (4 escenarios) | {resumen.coordenadas_rescatadas_algoritmo:,} | {resumen.tasa_rescate_sobre_corruptos_pct:.2f}% (sobre corruptos) |\",\n533:         f\"| (+) Retenidos en limbo con formato decimal válido | {resumen.limbo_formato_correcto_retenidos:,} | — |\",\n534:         f\"| (-) Coordenadas descartadas irreversibles | {resumen.coordenadas_descartadas_irreversibles:,} | — |\",\n535:         f\"| **(=) REGISTROS FINALES ETIQUETADOS Y GEORREFERENCIADOS** | **{resumen.registros_finales_etiquetados:,}** | **{resumen.efectividad_georreferenciacion_pct:.4f}%** |\",\n536:         \"\",\n537:         \"## 2. Indicadores Clave de Efectividad\",\n538:         \"\",\n539:         f\"- **Efectividad general de georreferenciación (sobre universo 2010–2024):** `{resumen.efectividad_georreferenciacion_pct:.4f}%`\",\n540:         f\"- **Tasa de retención global (bruto inicial → entregable final):** `{resumen.retencion_global_bruto_a_final_pct:.2f}%`\",\n541:         f\"- **Candidatos sin punto decimal evaluados por algoritmo reparador:** `{resumen.candidatos_corruptos_sin_decimal:,}` \"\n542:         f\"(rescatados: `{resumen.coordenadas_rescatadas_algoritmo:,}`, descartados irreversibles: `{resumen.coordenadas_descartadas_irreversibles:,}`)\",\n543:         \"\",\n544:     ]\n545: \n546:     # `\"\\n\".join(lineas_md)` concatena todas las cadenas de la lista separándolas con saltos de línea `\\n`,\n547:     # y `Path.write_text(..., encoding=\"utf-8\")` abre, escribe y cierra el archivo en un solo paso.\n548:     ruta_salida.write_text(\"\\n\".join(lineas_md), encoding=\"utf-8\")\n549:     print(f\"        Reporte Markdown guardado: {ruta_salida}\")\n550:     return ruta_salida\n551: \n552: \n553: def imprimir_resumen_pipeline(resumen: ResumenAuditoriaPipeline) -> None:\n554:     \"\"\"\n555:     Muestra en consola el cuadro ejecutivo de control integral (equivalente a R Fases 11 y 13).\n556:     \"\"\"\n557:     # Especificadores de formato dentro de las f-strings `{valor:formato}`:\n558:     #   • `:<48`  → alinea el texto a la IZQUIERDA rellenando con espacios hasta 48 columnas.\n559:     #   • `:>14,` → alinea el entero a la DERECHA en 14 columnas con coma separadora de miles.\n560:     #   • `:.4f`  → muestra un número flotante con exactamente 4 cifras decimales.\n561:     print(\"=\" * 68)\n562:     print(\"  AUDITORÍA ESTADÍSTICA INTEGRAL DEL PIPELINE (FASES 1 A 5)\")\n563:     print(\"=\" * 68)\n564:     print(f\"  {'1. CICLO DE VIDA DE REGISTROS':<48} {'Conteo':>14}\")\n565:     print(f\"  {'-' * 48} {'-' * 14}\")\n566:     print(f\"  {'Registros brutos iniciales (Fase 1)':<48} {resumen.registros_brutos_iniciales:>14,}\")\n567:     print(f\"  {'(-) Excluidos filtro temporal (> 2024)':<48} {resumen.registros_excluidos_temporal:>14,}\")\n568:     print(f\"  {'(-) Excluidos filtro insular (Galápagos)':<48} {resumen.registros_excluidos_insular:>14,}\")\n569:     print(f\"  {'(=) Universo continental 2010-2024 (Fase 3)':<48} {resumen.registros_universo_filtrado:>14,}\")\n570:     print(f\"  {'-' * 48} {'-' * 14}\")\n571:     print(f\"  {'2. AUDITORÍA Y RESCATE GEOESPACIAL (Fase 4)':<48}\")\n572:     print(f\"  {'(+) Correctos en 1ra auditoría topológica':<48} {resumen.geo_correctos_primera_auditoria:>14,}\")\n573:     print(f\"  {'(+) Rescatados por algoritmo decimal (4 esc.)':<48} {resumen.coordenadas_rescatadas_algoritmo:>14,}\")\n574:     print(f\"  {'(+) Limbo con formato decimal retenidos':<48} {resumen.limbo_formato_correcto_retenidos:>14,}\")\n575:     print(f\"  {'(-) Coordenadas descartadas irreversibles':<48} {resumen.coordenadas_descartadas_irreversibles:>14,}\")\n576:     print(f\"  {'-' * 48} {'-' * 14}\")\n577:     print(f\"  {'(=) REGISTROS FINALES ETIQUETADOS (Fase 5)':<48} {resumen.registros_finales_etiquetados:>14,}\")\n578:     print(f\"  {'Columnas limpias seleccionadas':<48} {resumen.columnas_finales:>14}\")\n579:     print(f\"  {'Provincias / Cantones representados':<48} {f'{resumen.provincias_unicas} / {resumen.cantones_unicos}':>14}\")\n580:     print(f\"  {'-' * 63}\")\n581:     print(f\"  • Efectividad de georreferenciación (sobre universo): {resumen.efectividad_georreferenciacion_pct:.4f}%\")\n582:     print(f\"  • Precisión topológica inicial (1ra pasada):          {resumen.precision_topologica_inicial_pct:.2f}%\")\n583:     print(f\"  • Tasa de rescate sobre corruptos sin decimal:        {resumen.tasa_rescate_sobre_corruptos_pct:.2f}%\")\n584:     print(f\"  • Retención global (bruto → final):                   {resumen.retencion_global_bruto_a_final_pct:.2f}%\")\n585:     estado = \"[OK] CUADRE EXACTO\" if resumen.integridad_contable_ok else \"[ALERTA] REVISAR CONTEOS\"\n586:     print(f\"  • Integridad contable del ciclo de vida:              {estado}\")\n587:     print(\"=\" * 68)\n588: \n589: \n590: def generar_auditoria_pipeline(\n591:     df_final: pd.DataFrame | None = None,\n592:     n_brutos_iniciales: int | None = None,\n593:     n_excluidos_temporal: int | None = None,\n594:     n_excluidos_insular: int | None = None,\n595:     n_universo_filtrado: int | None = None,\n596:     n_geo_correctos: int | None = None,\n597:     n_rescatados_algoritmo: int | None = None,\n598:     n_limbo_retenidos: int | None = None,\n599:     n_descartados_irreversibles: int | None = None,\n600:     detalle_escenarios: dict[str, int] | None = None,\n601:     ruta_json: Path = SALIDA_AUDITORIA_JSON,\n602:     ruta_md: Path = SALIDA_AUDITORIA_MD,\n603: ) -> ResumenAuditoriaPipeline:\n604:     \"\"\"\n605:     Función fachada (Facade Pattern) del Paso 5.5:\n606:     coordina en una sola llamada el cálculo de métricas, la escritura de JSON + Markdown y el reporte en consola.\n607:     \"\"\"\n608:     print(\"  [5.5] Generando reporte estadístico de control y efectividad del pipeline\")\n609:     resumen = calcular_metricas_pipeline(\n610:         df_final=df_final,\n611:         n_brutos_iniciales=n_brutos_iniciales,\n612:         n_excluidos_temporal=n_excluidos_temporal,\n613:         n_excluidos_insular=n_excluidos_insular,\n614:         n_universo_filtrado=n_universo_filtrado,\n615:         n_geo_correctos=n_geo_correctos,\n616:         n_rescatados_algoritmo=n_rescatados_algoritmo,\n617:         n_limbo_retenidos=n_limbo_retenidos,\n618:         n_descartados_irreversibles=n_descartados_irreversibles,\n619:         detalle_escenarios=detalle_escenarios,\n620:     )\n621:     exportar_reporte_json(resumen, ruta_salida=ruta_json)\n622:     exportar_reporte_markdown(resumen, ruta_salida=ruta_md)\n623:     imprimir_resumen_pipeline(resumen)\n624:     return resumen\n625: \n626: \n627: # Permite ejecutar la auditoría de forma independiente desde terminal:\n628: #     python -m src.reportes.metricas_pipeline\n629: if __name__ == \"__main__\":\n630:     generar_auditoria_pipeline()"}
