cifica el \"motor\" o biblioteca que se encargará de traducir y comprimir\n139:     tamanio_kb = INTERIM_NORMALIZADO.stat().st_size / 1024\n140:     # .stat().st_size → tamaño del archivo en bytes; / 1024 → lo pasa a kilobytes.\n141:     print(f\"  Guardado intermedio: {INTERIM_NORMALIZADO}\")\n142:     print(f\"  Tamaño: {tamanio_kb:.1f} KB\")  # :.1f → número con 1 decimal\n143: \n144: \n145: def cargar_intermedio_normalizado() -> pd.DataFrame:\n146:     \"\"\"\n147:     Carga el archivo Parquet intermedio de datos normalizados.\n148: \n149:     Returns\n150:     -------\n151:     pd.DataFrame\n152:         DataFrame previamente normalizado y guardado.\n153: \n154:     Raises\n155:     ------\n156:     FileNotFoundError\n157:         Si el archivo intermedio no existe.\n158:     \"\"\"\n159:     # Si el archivo todavía no existe (no se ha corrido la Fase 2), avisamos con un error claro.\n160:     if not INTERIM_NORMALIZADO.exists():\n161:         raise FileNotFoundError(\n162:             f\"No existe el archivo intermedio: {INTERIM_NORMALIZADO}. \"\n163:             \"Ejecuta primero la Fase 2 (normalizar_todas_columnas + guardar).\"\n164:         )\n165:     return pd.read_parquet(INTERIM_NORMALIZADO, engine=\"pyarrow\") #Saco y devuelvo mis datos guardados, en tipo dataframe\n166: \n167: \n168: # =========================================================================\n169: # EJECUCIÓN DIRECTA (para pruebas rápidas desde terminal)\n170: # =========================================================================\n171: # `__name__` es una variable especial que Python crea automáticamente:\n172: #   - Si ejecutas ESTE archivo directamente (python -m src.limpieza.normalizar_texto),\n173: #     __name__ vale \"__main__\" → el bloque de abajo SÍ se ejecuta.\n174: #   - Si este archivo es IMPORTADO desde otro (ej. desde main.py),\n175: #     __name__ vale \"src.limpieza.normalizar_texto\" → el bloque NO se ejecuta.\n176: # Así podemos probar la fase por separado sin afectar al pipeline completo.\n177: if __name__ == \"__main__\":\n178:     # Permite ejecutar: python -m src.limpieza.normalizar_texto\n179:     print(\"Cargando datos de Fase 1 (homi_renombrado.parquet)...\")\n180: \n181:     if not INTERIM_RENOMBRADO.exists():\n182:         raise FileNotFoundError(\n183:             f\"No existe {INTERIM_RENOMBRADO}. Ejecuta primero la Fase 1.\"\n184:         )\n185: \n186:     df = pd.read_parquet(INTERIM_RENOMBRADO, engine=\"pyarrow\")  # Lee la salida de la Fase 1\n187:     df = normalizar_todas_columnas(df)                          # Aplica la Fase 2\n188:     guardar_intermedio_normalizado(df)                          # Guarda el resultado\n189:     print(\"\\n[OK] Fase 2 completada exitosamente.\")  # \"\\n\" = salto de línea"}
{"step_index":395,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:33:14Z","content":"Created At: 2026-11-10T10:33:14-05:00\nCompleted At: 2026-11-10T10:33:14-05:00\nShowing lines 250-484 of 484\n250:     df: pd.DataFrame,              # Filas candidatas a reparar.\n251:     lat_reconstruida: pd.Series,   # La nueva latitud propuesta por un escenario.\n252:     mapa: gpd.GeoDataFrame,        # El mapa de cantones contra el que probamos.\n253: ) -> set[int]:                     # Devuelve un CONJUNTO con los ID_temp rescatados.\n254:     \"\"\"\n255:     Valida una reconstrucción de latitud mediante sjoin contra el mapa.\n256: \n257:     Crea puntos con la latitud reconstruida, ejecuta sjoin contra los\n258:     polígonos cantonales, y devuelve los ID_temp de los registros cuyo\n259:     punto reparado cae dentro del polígono de su cantón reportado.\n260: \n261:     **[OPTIMIZACIÓN vs. R]:** Un solo sjoin vectorizado reemplaza el\n262:     bucle for(j in 1:length(cantones)) del código R original.\n263: \n264:     Equivalencia R (líneas 350-367, 382-397, 411-426, 439-454):\n265:         point_analisis_cX <- data.frame(y = as.numeric(lat.final), x = lon.new)\n266:         point_analisis_cX <- st_as_sf(point_analisis_cX, coords = c(\"x\",\"y\"), ...)\n267:         for(j in 1:length(cantones.cX)) {\n268:             ...\n269:             dentro <- pts.eval[apply(st_intersects(...), 1, any), ]\n270:             correctos3 <- c(correctos3, dentro$ID.temp)\n271:         }\n272: \n273:     Parameters\n274:     ----------\n275:     df : pd.DataFrame\n276:         Registros a validar, con columnas 'lon_num', 'canton', 'ID_temp'.\n277:     lat_reconstruida : pd.Series\n278:         Serie con la latitud reconstruida como string.\n279:     mapa : gpd.GeoDataFrame\n280:         Mapa cantonal con columna 'CANTON_MAPA'.\n281: \n282:     Returns\n283:     -------\n284:     set[int]\n285:         Conjunto de ID_temp de los registros exitosamente reparados.\n286:     \"\"\"\n287:     # Si no hay filas que probar, devolvemos un conjunto vacío set().\n288:     if len(df) == 0:\n289:         return set()\n290: \n291:     # Convertir latitud reconstruida a numérico\n292:     # Ej: \"-2.1894\" → -2.1894 | \"1.\" (cadena rota) → 1.0 | basura → NaN\n293:     lat_num = pd.to_numeric(lat_reconstruida, errors=\"coerce\")\n294: \n295:     # Filtrar registros con latitud válida\n296:     # .notna() → True donde NO es nulo. \"&\" = \"Y\" lógico fila por fila\n297:     # (en pandas se usa \"&\" entre columnas booleanas, NO la palabra `and`).\n298:     validos = lat_num.notna() & df[\"lon_num\"].notna() #***en las latitudes recosntruidas no deve estar null ni la longitud de data frame A REPARAR\n299:     if validos.sum() == 0:  # Ninguna fila tuvo ambas coordenadas válidas.\n300:         return set()\n301: \n302:     df_validos = df[validos].copy() #***a partir de la \"Serie booleana de pandas\" hago una copia para hacer los procesos.\n303:     lat_valida = lat_num[validos]\n304: \n305:     # Crear GeoDataFrame de puntos con la latitud reconstruida\n306:     # Equivale a: st_as_sf(data.frame(y=..., x=...), coords=c(\"x\",\"y\"), crs=...)\n307:     # Usamos la longitud que ya teníamos (lon_num) + la NUEVA latitud propuesta.\n308:     gdf_prueba = gpd.GeoDataFrame(\n309:         df_validos,\n310:         geometry=gpd.points_from_xy(df_validos[\"lon_num\"], lat_valida),\n311:         crs=f\"EPSG:{CRS_OBJETIVO}\",\n312:     )#*** creo un geo data frame con todo lo valido\n313: \n314:     # sjoin vectorizado (reemplaza el bucle R completo)\n315:     # ***how=\"inner\" → aquí solo nos interesan los puntos que SÍ cayeron dentro\n316:     #               de algún polígono del mapa; los que caen en el mar o en\n317:     #               otro país se descartan directo (más rápido que \"left\").\n318:     resultado = gpd.sjoin(\n319:         gdf_prueba,\n320:         mapa[[\"CANTON_MAPA\", \"geometry\"]],\n321:         how=\"inner\",\n322:         predicate=\"intersects\",\n323:     )#*** hago el inter (intercepcion), \n324:     #Evalúa fila por fila si el cantón que el usuario escribió originalmente coincide con el polígono \n325:     # #donde el punto cayó físicamente tras la reparación. \n326: \n327:     # Filtrar donde cantón reportado == cantón geográfico\n328:     # ¡Esta es la prueba de fuego! No basta con que el punto caiga en Ecuador:\n329:     # tiene que caer específicamente en el MISMO cantón que dice el registro.\n330:     # Si la reparación de Guayaquil cayó dentro del polígono de GUAYAQUIL → ¡rescatado!\n331:     ids_rescatados = set(\n332:         resultado.loc[\n333:             resultado[\"canton\"] == resultado[\"CANTON_MAPA\"], \"ID_temp\"\n334:         ].unique()\n335:     )\n336:     # ***ID_temp corresponde a registros exitosamente reparados. SE ENTIENDE QUE VIENE YA COMO COLUMNA\n337:     # Y devuelve uncamente el  \"ID_temp\" ****\n338:     #Si por alguna razón un punto cayó justo en el borde de dos mapas \n339:     # y la fila se duplicó, .unique() elimina duplicados y devuelve un arreglo limpio de números\n340:     # set(...):\n341:     #Convierte ese arreglo en un conjunto de Python: {101, 103}.\n342: \n343:     return ids_rescatados #devuelve una lista de identificadores (set[int]) \n344:     #de los registros que superaron la prueba con éxito.\n345: \n346: \n347: # =========================================================================\n348: # ORQUESTADOR: Ejecución secuencial de los 4 escenarios\n349: # =========================================================================\n350: def reparar_coordenadas_corruptas(\n351:     geo_corregir_decimales: pd.DataFrame,\n352:     mapa: gpd.GeoDataFrame,\n353: ) -> tuple[pd.DataFrame, pd.DataFrame, pd.DataFrame, pd.DataFrame, pd.DataFrame]:\n354:     \"\"\"\n355:     Ejecuta secuencialmente los 4 escenarios de reparación decimal.\n356: \n357:     Replica la lógica del bucle R for(i in 1:10) con los escenarios\n358:     i=1, i=2, i=6, i=7 (en el R usaban esos índices). Cada escenario\n359:     intenta reparar los registros restantes y los registros rescatados\n360:     se retiran del pool para el siguiente escenario.\n361: \n362:     Equivalencia R (líneas 336-457):\n363:         for(i in 1:10) {\n364:             if(i == 1) { ... escenario X.XXXXXX ... }\n365:             if(i == 2) { ... escenario 0.XXXXXX ... }\n366:             if(i == 6) { ... escenario -X.XXXXXX ... }\n367:             if(i == 7) { ... escenario -0.XXXXXX ... }\n368:         }\n369: \n370:     Parameters\n371:     ----------\n372:     geo_corregir_decimales : pd.DataFrame\n373:         Registros sin punto decimal que necesitan reparación.\n374:     mapa : gpd.GeoDataFrame\n375:         Mapa cantonal para validación sjoin.\n376: \n377:     Returns\n378:     -------\n379:     tuple de 5 DataFrames:\n380:         - reparados_esc1: Rescatados por escenario 1 (X.XXXXXX)\n381:         - reparados_esc2: Rescatados por escenario 2 (0.XXXXXX)\n382:         - reparados_esc3: Rescatados por escenario 3 (-X.XXXXXX)\n383:         - reparados_esc4: Rescatados por escenario 4 (-0.XXXXXX)\n384:         - no_reparados: Registros que ningún escenario pudo rescatar\n385:     \"\"\"\n386:     print(\"  [4.6] Algoritmo reparador de coordenadas decimales\")\n387: \n388:     # Si no llegó ningún registro sin punto decimal, devolvemos 5 tablas vacías.\n389:     if len(geo_corregir_decimales) == 0:\n390:         print(\"        No hay registros con decimales corruptos para reparar.\")\n391:         vacio = pd.DataFrame()\n392:         return vacio, vacio, vacio, vacio, vacio\n393: \n394:     # ── Preparación: limpiar cadena de latitud ──\n395:     # Equivale a: gsub(\"\\\\.\", \"\", ...) + gsub(\"-\", \"\", ...)\n396:     df = geo_corregir_decimales.copy()\n397:     # Dejamos solo los dígitos puros en una columna auxiliar \"limpia_lat\".\n398:     df[\"limpia_lat\"] = _limpiar_cadena_lat(df[\"latitud_original\"])\n399: \n400:     # `pendientes` es la \"bolsa\" de casos aún no resueltos. A medida que cada\n401:     # escenario rescata registros, los sacamos de `pendientes` para que el\n402:     # siguiente escenario no los vuelva a evaluar (evita duplicados).\n403:     pendientes = df.copy()\n404:     n_total = len(pendientes)\n405: \n406:     # Lista de parejas (nombre_para_imprimir, función_a_ejecutar).\n407:     # En Python las funciones son objetos como cualquier otro: se pueden guardar\n408:     # dentro de una lista y recorrerlas con un `for` para no repetir 4 veces el\n409:     # mismo bloque de código (principio DRY: \"Don't Repeat Yourself\").\n410:     escenarios = [\n411:         (\"Escenario 1: X.XXXXXX  (positivo Norte)\", reconstruir_escenario_1),\n412:         (\"Escenario 2: 0.XXXXXX  (positivo Ecuador)\", reconstruir_escenario_2),\n413:         (\"Escenario 3: -X.XXXXXX (negativo Sur) ← CRÍTICO\", reconstruir_escenario_3),\n414:         (\"Escenario 4: -0.XXXXXX (negativo Ecuador)\", reconstruir_escenario_4),\n415:     ]\n416: \n417:     # Lista donde iremos guardando los DataFrames rescatados por cada escenario.\n418:     # `: list[pd.DataFrame]` indica que es una lista cuyos elementos son DataFrames.\n419:     resultados: list[pd.DataFrame] = []\n420: \n421:     # Desempaquetamos cada tupla de la lista en `nombre` (texto) y `fn_reconstruir` (función).\n422:     for nombre, fn_reconstruir in escenarios:\n423:         # Si los escenarios anteriores ya rescataron TODO, no queda nada que probar:\n424:         # guardamos una tabla vacía para este escenario y `continue` salta a la siguiente vuelta.\n425:         if len(pendientes) == 0:\n426:             resultados.append(pd.DataFrame())\n427:             continue\n428: \n429:         # Reconstruir latitud según el escenario\n430:         # Llamamos a la función del turno actual (escenario 1, luego 2, luego 3, luego 4).\n431:         lat_reconstruida = fn_reconstruir(pendientes[\"limpia_lat\"])\n432: \n433:         # Validar contra el mapa con sjoin\n434:         # Nos devuelve los ID_temp cuya latitud reconstruida SÍ cayó en su cantón.\n435:         ids_rescatados = validar_reconstruccion_sjoin(\n436:             pendientes, lat_reconstruida, mapa\n437:         )\n438: \n439:         # Separar rescatados del pool de pendientes\n440:         # Equivale a: geo.corregir.1X <- geo.corregir.1 %>% filter(ID.temp %in% correctos3)\n441:         rescatados = pendientes[pendientes[\"ID_temp\"].isin(ids_rescatados)].copy()\n442: \n443:         # Actualizar lat_num con el valor reparado para los rescatados\n444:         # ¡Muy importante! Antes tenían la latitud vieja corrupta en lat_num\n445:         # (ej. 21894.0); aquí la sobreescribimos con la latitud ya reparada (-2.1894).\n446:         if len(rescatados) > 0:\n447:             lat_reparada = fn_reconstruir(rescatados[\"limpia_lat\"])\n448:             rescatados[\"lat_num\"] = pd.to_numeric(lat_reparada, errors=\"coerce\")\n449: \n450:         # Los rescatados salen del pool\n451:         # Equivale a: geo.corregir.1 <- geo.corregir.1 %>% filter(!(ID.temp %in% correctos3))\n452:         # Así en la siguiente vuelta `pendientes` solo tiene los que siguen fallando.\n453:         pendientes = pendientes[~pendientes[\"ID_temp\"].isin(ids_rescatados)].copy()\n454: \n455:         # Guardamos la tabla de rescatados de este escenario en la lista.\n456:         resultados.append(rescatados)\n457:         print(f\"        {nombre}: {len(rescatados):,} rescatados \"\n458:               f\"({len(pendientes):,} pendientes)\")\n459: \n460:     # Limpiar columna auxiliar de todos los DataFrames\n461:     # enumerate(lista) → recorre la lista dándonos posición E ítem: (0, esc1), (1, esc2)...\n462:     # Usamos `i` para sobreescribir `resultados[i]` sin la columna temporal \"limpia_lat\".\n463:     for i, r in enumerate(resultados):\n464:         if len(r) > 0 and \"limpia_lat\" in r.columns:\n465:             resultados[i] = r.drop(columns=[\"limpia_lat\"])\n466: \n467:     if len(pendientes) > 0 and \"limpia_lat\" in pendientes.columns:\n468:         pendientes = pendientes.drop(columns=[\"limpia_lat\"])\n469: \n470:     # sum(...) suma la cantidad de filas rescatadas en los 4 escenarios.\n471:     n_total_rescatados = sum(len(r) for r in resultados)\n472:     n_no_reparados = len(pendientes)  # Lo que quedó en `pendientes` tras los 4 intentos.\n473: \n474:     print(f\"        {'─' * 45}\")\n475:     print(f\"        Total rescatados: {n_total_rescatados:,} de {n_total:,}\")\n476:     print(f\"        No reparados: {n_no_reparados:,}\")\n477: \n478:     return (\n479:         resultados[0],  # Escenario 1 (índice 0 de la lista)\n480:         resultados[1],  # Escenario 2 (índice 1 de la lista)\n481:         resultados[2],  # Escenario 3 (índice 2 de la lista)\n482:         resultados[3],  # Escenario 4 (índice 3 de la lista)\n483:         pendientes,     # No reparados (ej. coordenadas 0, 0 irrecuperables)\n484:     )"}
{"step_index":396,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:33:14Z","content":"Created At: 2026-11-10T10:33:14-05:00\nCompleted At: 2026-11-10T10:33:14-05:00\nShowing lines 1-288 of 288\n1: \"\"\"\n2: ensamblaje.py — Ensamblaje final de la base georreferenciada.\n3: \n4: Corresponde a la Fase R 9 (líneas 460-484) del código original:\n5:     listo.corrcion.casos.posibles <- rbind(geo.corregir.1a, ..., geo.corregir.1g)\n6:     listo.corrcion.casos.posibles$lat.new <- as.numeric(lat.final)\n7:     listo.corrcion.casos.posibles <- select(-any_of(c(\"limpia.lat\", ...)))\n8:     homi_Nueva <- rbind(geo_correctos, listo.corrcion.casos.posibles, limbo)\n9:     homi_Nueva <- mutate(lat.new = as.numeric(lat.new), ...) %>%\n10:         filter(!is.na(lat.new) & !is.na(lon.new))\n11: \n12: Funciones principales:\n13:     - ensamblar_base_final(): Concatena y limpia todos los conjuntos (Paso 4.7)\n14:     - guardar_artefactos_geo(): Exporta Parquet en interim/ y processed/ (Paso 4.8)\n15:     - imprimir_reporte_geo(): Reporte estadístico de efectividad (equivale R Fase 11)\n16: \n17: En palabras simples: este módulo vuelve a JUNTAR todas las piezas válidas\n18: que se separaron durante la Fase 4 (los correctos desde el inicio + los\n19: reparados por los 4 escenarios + los del limbo), borra las columnas de\n20: trabajo temporal y guarda la tabla final limpia en disco.\n21: \"\"\"\n22: import pandas as pd\n23: \n24: from src.ingesta.config import (\n25:     INTERIM_GEO_CORRECTOS,  # data/interim/geo_correctos.parquet\n26:     PROCESSED_DIR,          # data/processed/\n27: )\n28: \n29: \n30: # Columnas auxiliares creadas durante la validación geoespacial que deben\n31: # eliminarse del DataFrame final para mantener el esquema limpio.\n32: # Equivale a: select(-any_of(c(\"limpia.lat\", \"lat.1\", \"lat.leng\", ...))) en R\n33: # El \"_\" al inicio indica que es una constante interna de este archivo.\n34: _COLUMNAS_AUXILIARES: list[str] = [\n35:     \"latitud_original\",   # Cadena original antes de conversión numérica\n36:     \"longitud_original\",  # Cadena original antes de conversión numérica\n37:     \"limpia_lat\",         # Cadena limpia usada en reconstrucción decimal\n38:     \"lat_1\",              # Parte entera de la reconstrucción\n39:     \"lat_2\",              # Parte decimal de la reconstrucción\n40:     \"lat_leng\",           # Longitud de la cadena (auxiliar R)\n41:     \"lat_final\",          # Cadena final reconstruida antes de casteo\n42:     \"geometry\",           # Columna GeoDataFrame que ya no se necesita\n43:     \"index_right\",        # Columna residual creada por gpd.sjoin()\n44:     \"CANTON_MAPA\",        # Columna del mapa unida por sjoin — ya no necesaria\n45:     \"_coincide\",          # Máscara booleana de la auditoría topológica\n46:     \"_PROV_NORM\",         # Columna normalizada temporal de provincias\n47: ]\n48: \n49: \n50: # =========================================================================\n51: # PASO 4.7 — Ensamblaje y limpieza final\n52: # =========================================================================\n53: def ensamblar_base_final(\n54:     geo_correctos: pd.DataFrame,\n55:     reparados_esc1: pd.DataFrame,\n56:     reparados_esc2: pd.DataFrame,\n57:     reparados_esc3: pd.DataFrame,\n58:     reparados_esc4: pd.DataFrame,\n59:     limbo_formato_correcto: pd.DataFrame,\n60:     no_reparados: pd.DataFrame | None = None,  # Opcional: solo se usa para imprimir cuántos fueron.\n61: ) -> pd.DataFrame:\n62:     \"\"\"\n63:     Consolida todos los conjuntos de datos en la base georreferenciada final.\n64: \n65:     Equivalencia R (líneas 466-484):\n66:         listo.corrcion.casos.posibles <- rbind(geo.corregir.1a, geo.corregir.1b,\n67:                                                geo.corregir.1f, geo.corregir.1g)\n68:         listo.corrcion.casos.posibles$lat.new <- as.numeric(lat.final)\n69:         listo.corrcion.casos.posibles <- select(-any_of(c(...)))\n70:         homi_Nueva <- rbind(geo_correctos, listo.corrcion.casos.posibles,\n71:                             limbo_formato_correcto)\n72:         homi_Nueva <- mutate(lat.new = as.numeric(lat.new), ...) %>%\n73:             filter(!is.na(lat.new) & !is.na(lon.new))\n74: \n75:     Mapeo R → Python:\n76:         rbind(a, b, c, ...)      →  pd.concat([a, b, c, ...], ignore_index=True)\n77:         select(-any_of(cols))    →  df.drop(columns=cols, errors='ignore')\n78:         filter(!is.na(lat/lon))  →  df.dropna(subset=['lat_num', 'lon_num'])\n79: \n80:     Parameters\n81:     ----------\n82:     geo_correctos : pd.DataFrame\n83:         Registros correctos de la primera auditoría topológica (Paso 4.4).\n84:     reparados_esc1 : pd.DataFrame\n85:         Registros reparados por escenario 1 — X.XXXXXX positivo (Paso 4.6).\n86:     reparados_esc2 : pd.DataFrame\n87:         Registros reparados por escenario 2 — 0.XXXXXX positivo (Paso 4.6).\n88:     reparados_esc3 : pd.DataFrame\n89:         Registros reparados por escenario 3 — -X.XXXXXX negativo (Paso 4.6).\n90:     reparados_esc4 : pd.DataFrame\n91:         Registros reparados por escenario 4 — -0.XXXXXX negativo (Paso 4.6).\n92:     limbo_formato_correcto : pd.DataFrame\n93:         Registros con punto decimal que cayeron fuera de cantón (Paso 4.5).\n94:     no_reparados : pd.DataFrame or None\n95:         Registros que ningún escenario pudo rescatar. Se excluyen del\n96:         ensamblaje pero se reportan para auditoría.\n97: \n98:     Returns\n99:     -------\n100:     pd.DataFrame\n101:         Base consolidada y limpia con columnas 'lat_num' / 'lon_num' como\n102:         coordenadas numéricas definitivas, lista para exportación.\n103: \n104:     Raises\n105:     ------\n106:     ValueError\n107:         Si todos los DataFrames de entrada están vacíos.\n108:     \"\"\"\n109:     print(\"  [4.7] Ensamblaje y limpieza final\")\n110: \n111:     # ── Catalogar las partes con sus tamaños ──\n112:     # Diccionario {nombre: tabla} para poder imprimir el conteo de cada parte\n113:     # con un solo `for` y luego unir todas sus tablas.\n114:     partes_etiquetadas = {\n115:         \"geo_correctos\":          geo_correctos,\n116:         \"reparados_esc1\":         reparados_esc1,\n117:         \"reparados_esc2\":         reparados_esc2,\n118:         \"reparados_esc3\":         reparados_esc3,\n119:         \"reparados_esc4\":         reparados_esc4,\n120:         \"limbo_formato_correcto\": limbo_formato_correcto,\n121:     }\n122: \n123:     # .items() nos da cada pareja (clave, valor) del diccionario.\n124:     for etiqueta, df_parte in partes_etiquetadas.items():\n125:         # :<30 = alineado a la izquierda en 30 espacios | :>7, = derecha en 7 con miles.\n126:         print(f\"        {etiqueta:<30}: {len(df_parte):>7,}\")\n127: \n128:     # Si nos pasaron la tabla de no_reparados, mostramos cuántos se descartan.\n129:     if no_reparados is not None:\n130:         print(f\"        {'no_reparados (excluidos)':<30}: {len(no_reparados):>7,}\")\n131: \n132:     # ── pd.concat() — equivale a rbind() de R ──\n133:     # Filtramos DataFrames vacíos para evitar warnings en concat()\n134:     #\n135:     # Esto es una \"comprensión de listas\" (list comprehension): una forma\n136:     # compacta de armar una lista nueva filtrando otra. Se lee en español:\n137:     #   \"dame cada `df` de los valores del diccionario SI ese `df` tiene filas\".\n138:     partes_no_vacias = [\n139:         df for df in partes_etiquetadas.values() if len(df) > 0\n140:     ]\n141: \n142:     # Si ninguna parte tenía filas, no hay nada que unir → lanzamos error.\n143:     if len(partes_no_vacias) == 0:\n144:         raise ValueError(\n145:             \"Todos los DataFrames de entrada están vacíos. \"\n146:             \"No hay registros para ensamblar.\"\n147:         )\n148: \n149:     # pd.concat(lista_de_tablas) → apila las tablas una debajo de otra (verticalmente).\n150:     # ignore_index=True reinicia el índice secuencialmente (0, 1, 2, ...) — equivale al\n151:     # reindexado implícito que hace R al hacer rbind() sobre data.frames\n152:     df_ensamblado = pd.concat(partes_no_vacias, ignore_index=True)\n153:     print(f\"        {'─' * 45}\")\n154:     print(f\"        Total ensamblado (antes de limpieza): {len(df_ensamblado):,}\")\n155: \n156:     # ── Eliminar columnas auxiliares ──\n157:     # Equivale a: select(-any_of(c(\"limpia.lat\", \"lat.1\", \"lat.leng\", ...)))\n158:     # Primero filtramos cuáles de las columnas auxiliares están realmente presentes\n159:     # en la tabla (igual que hace any_of() en R, para no fallar si alguna no está).\n160:     cols_presentes = [c for c in _COLUMNAS_AUXILIARES if c in df_ensamblado.columns]\n161:     if cols_presentes:\n162:         # .drop(columns=...) devuelve la tabla sin esas columnas.\n163:         df_ensamblado = df_ensamblado.drop(columns=cols_presentes)\n164: \n165:     # ── Forzar tipos numéricos en coordenadas ──\n166:     # Equivale a: mutate(lat.new = as.numeric(lat.new), lon.new = as.numeric(lon.new))\n167:     # Garantiza que lat_num y lon_num sean números decimales (float64) en toda la tabla.\n168:     df_ensamblado[\"lat_num\"] = pd.to_numeric(\n169:         df_ensamblado[\"lat_num\"], errors=\"coerce\"\n170:     )\n171:     df_ensamblado[\"lon_num\"] = pd.to_numeric(\n172:         df_ensamblado[\"lon_num\"], errors=\"coerce\"\n173:     )\n174: \n175:     # ── Filtro de integridad final ──\n176:     # Equivale a: filter(!is.na(lat.new) & !is.na(lon.new))\n177:     # Último candado: si por algún motivo quedó alguna fila con coordenada NaN, se borra.\n178:     n_antes = len(df_ensamblado)\n179:     df_ensamblado = df_ensamblado.dropna(subset=[\"lat_num\", \"lon_num\"])\n180:     n_despues = len(df_ensamblado)\n181:     n_eliminados_nan = n_antes - n_despues\n182: \n183:     if n_eliminados_nan > 0:\n184:         print(f\"        Eliminados por NaN lat/lon: {n_eliminados_nan:,}\")\n185: \n186:     print(f\"        REGISTROS GEORREFERENCIADOS FINALES: {n_despues:,}\")\n187: \n188:     return df_ensamblado\n189: \n190: \n191: # =========================================================================\n192: # PASO 4.8 — Exportación de artefactos geoespaciales\n193: # =========================================================================\n194: def guardar_artefactos_geo(\n195:     geo_correctos: pd.DataFrame,\n196:     df_final: pd.DataFrame,\n197: ) -> None:\n198:     \"\"\"\n199:     Exporta los artefactos de la Fase 4 en formato Parquet.\n200: \n201:     Genera:\n202:       • data/interim/geo_correctos.parquet  — registros correctos iniciales\n203:       • data/processed/homi_georreferenciado.parquet — base final consolidada\n204: \n205:     Equivalencia R (líneas 498-504):\n206:         st_write(homi_Nueva_espacial, \"homi_Nueva.shp\", delete_layer=TRUE)\n207:         write.csv(homi_Nueva, \"homi_Nueva_limpio7.csv\", row.names=FALSE)\n208:         saveRDS(homi_Nueva, file = \"homi_2010_2024_2.rds\")\n209:     En Python usamos Parquet como formato binario moderno (reemplaza RDS).\n210: \n211:     Parameters\n212:     ----------\n213:     geo_correctos : pd.DataFrame\n214:         Registros correctos de la primera auditoría topológica.\n215:     df_final : pd.DataFrame\n216:         Base consolidada final post-ensamblaje y limpieza.\n217:     \"\"\"\n218:     print(\"  [4.8] Exportación de artefactos geoespaciales\")\n219: \n220:     # ── geo_correctos.parquet (interim/) ──\n221:     # Guardamos aparte los que estaban bien desde el origen (para auditoría).\n222:     INTERIM_GEO_CORRECTOS.parent.mkdir(parents=True, exist_ok=True)\n223:     geo_correctos.to_parquet(INTERIM_GEO_CORRECTOS, index=False, engine=\"pyarrow\")\n224:     tamanio_kb = INTERIM_GEO_CORRECTOS.stat().st_size / 1024\n225:     print(f\"        Guardado: {INTERIM_GEO_CORRECTOS}\")\n226:     print(f\"        Tamaño: {tamanio_kb:.1f} KB | Registros: {len(geo_correctos):,}\")\n227: \n228:     # ── homi_georreferenciado.parquet (processed/) ──\n229:     # Guardamos la base completa ya georreferenciada (entrada para la Fase 5).\n230:     ruta_final = PROCESSED_DIR / \"homi_georreferenciado.parquet\"\n231:     PROCESSED_DIR.mkdir(parents=True, exist_ok=True)\n232:     df_final.to_parquet(ruta_final, index=False, engine=\"pyarrow\")\n233:     tamanio_kb = ruta_final.stat().st_size / 1024\n234:     print(f\"        Guardado: {ruta_final}\")\n235:     print(f\"        Tamaño: {tamanio_kb:.1f} KB | Registros: {len(df_final):,}\")\n236: \n237: \n238: # =========================================================================\n239: # REPORTE ESTADÍSTICO — equivale a R Fase 11 (líneas 510-519)\n240: # =========================================================================\n241: def imprimir_reporte_geo(\n242:     n_procesados: int,\n243:     n_correctos: int,\n244:     n_reparados_total: int,\n245:     n_limbo: int,\n246:     n_no_reparados: int,\n247:     n_final: int,\n248: ) -> None:\n249:     \"\"\"\n250:     Imprime el reporte estadístico de efectividad de la Fase 4.\n251: \n252:     Equivalencia R (líneas 510-519):\n253:         print(paste(\"-> Homicidios procesados:\", nrow(homi_2010_2024)))\n254:         print(paste(\"-> Total rescatados perfectos:\", nrow(geo_correctos)))\n255:         print(paste(\"-> Total rescatados por algoritmo:\", nrow(reparados)))\n256:         print(paste(\"TOTAL DE REGISTROS GEORREFERENCIADOS:\", nrow(homi_Nueva)))\n257:         print(paste(\"Efectividad total:\", round(...*100, 2), \"%\"))\n258: \n259:     Parameters\n260:     ----------\n261:     n_procesados : int\n262:         Total de registros que entraron al pipeline de la Fase 4.\n263:     n_correctos : int\n264:         Registros que pasaron la primera auditoría sin corrección.\n265:     n_reparados_total : int\n266:         Total de registros reparados por los 4 escenarios del algoritmo.\n267:     n_limbo : int\n268:         Registros en limbo con formato correcto (punto decimal pero fuera).\n269:     n_no_reparados : int\n270:         Registros que ningún escenario pudo rescatar (excluidos).\n271:     n_final : int\n272:         Total de registros en la base georreferenciada final.\n273:     \"\"\"\n274:     # Porcentaje de registros que terminaron con coordenadas válidas respecto al total.\n275:     efectividad = (n_final / n_procesados * 100) if n_procesados > 0 else 0.0\n276: \n277:     print(\"=\" * 60)\n278:     print(\"  REPORTE DE VERIFICACIÓN — FASE 4: VALIDACIÓN GEOESPACIAL\")\n279:     print(\"=\" * 60)\n280:     print(f\"  {'Homicidios procesados (entrada):':<42} {n_procesados:>7,}\")\n281:     print(f\"  {'Rescatados perfectos (1ra auditoría):':<42} {n_correctos:>7,}\")\n282:     print(f\"  {'Rescatados por algoritmo (4 escenarios):':<42} {n_reparados_total:>7,}\")\n283:     print(f\"  {'Limbo con coordenadas retenidos:':<42} {n_limbo:>7,}\")\n284:     print(f\"  {'No reparados (excluidos):':<42} {n_no_reparados:>7,}\")\n285:     print(f\"  {'─' * 52}\")\n286:     print(f\"  {'TOTAL GEORREFERENCIADOS:':<42} {n_final:>7,}\")\n287:     print(f\"  Efectividad total del pipeline: {efectividad:.2f}%\")\n288:     print(\"=\" * 60)"}
