{"step_index":419,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:36:29Z","content":"Created At: 2026-11-10T10:36:29-05:00\nCompleted At: 2026-11-10T10:36:29-05:00\nShowing lines 350-627 of 627\n350:         # Prueba negativa: aunque el punto cae en Ecuador (Guayaquil), el registro\n351:         # dice \"QUITO\", así que NO coincide y NO debe darse por válido.\n352:         df_prueba = _crear_df_sintetico(\n353:             canton=\"QUITO\",          # Canton incorrecto para estas coords\n354:             lat_str=\"21894\",\n355:             lon_str=\"-79.8891\",\n356:             lat_num=-2.1894,\n357:             lon_num=-79.8891,\n358:         )\n359:         df_prueba[\"limpia_lat\"] = _limpiar_cadena_lat(pd.Series([\"21894\"]))\n360:         lat_rec = reconstruir_escenario_3(df_prueba[\"limpia_lat\"])\n361:         ids = validar_reconstruccion_sjoin(df_prueba, lat_rec, mapa_cantonal)\n362:         assert 1 not in ids, (\n363:             \"Un punto de GUAYAQUIL con cantón='QUITO' no debería rescatarse.\"\n364:         )\n365: \n366: \n367: # =========================================================================\n368: # TESTS DE INTEGRACIÓN: Pipeline completo de reparación\n369: # =========================================================================\n370: class TestReparacionCompleta:\n371:     \"\"\"Tests del orquestador reparar_coordenadas_corruptas().\"\"\"\n372: \n373:     # Método auxiliar interno de la clase (no empieza con `test_`, así que\n374:     # pytest no lo ejecuta como prueba; solo lo llamamos desde los tests de abajo).\n375:     def _make_pool_corruptos(self) -> pd.DataFrame:\n376:         \"\"\"Crea un pool de registros con coordenadas corruptas (sin punto).\"\"\"\n377:         rows = [\n378:             # Escenario 3: negativo sur\n379:             {\n380:                 \"canton\": \"GUAYAQUIL\", \"latitud_original\": \"21894\",\n381:                 \"longitud_original\": \"-79.8891\", \"lat_num\": -2.1894,\n382:                 \"lon_num\": -79.8891, \"ID_temp\": 1,\n383:             },\n384:             {\n385:                 \"canton\": \"CUENCA\", \"latitud_original\": \"28970\",\n386:                 \"longitud_original\": \"-79.0045\", \"lat_num\": -2.8970,\n387:                 \"lon_num\": -79.0045, \"ID_temp\": 2,\n388:             },\n389:             # Escenario 4: negativo ecuatorial\n390:             {\n391:                 \"canton\": \"QUITO\", \"latitud_original\": \"1807\",\n392:                 \"longitud_original\": \"-78.4678\", \"lat_num\": -0.1807,\n393:                 \"lon_num\": -78.4678, \"ID_temp\": 3,\n394:             },\n395:         ]\n396:         df = pd.DataFrame(rows)\n397:         # Agregar campos textuales mínimos\n398:         for col in [\"codigo_caso\", \"tipo_delito\", \"provincia\"]:\n399:             df[col] = \"TEST\"\n400:         df[\"limpia_lat\"] = _limpiar_cadena_lat(df[\"latitud_original\"])\n401:         return df\n402: \n403:     def test_rescata_registros_corruptos(self, mapa_cantonal):\n404:         \"\"\"Verifica que el orquestador rescata al menos un registro corrupto.\"\"\"\n405:         df_corruptos = self._make_pool_corruptos()\n406:         esc1, esc2, esc3, esc4, no_rep = reparar_coordenadas_corruptas(\n407:             df_corruptos, mapa_cantonal\n408:         )\n409:         total_rescatados = sum(len(d) for d in [esc1, esc2, esc3, esc4])\n410:         assert total_rescatados > 0, (\n411:             \"El algoritmo no rescató ningún registro corrupto.\"\n412:         )\n413: \n414:     def test_escenario3_domina_sur(self, mapa_cantonal):\n415:         \"\"\"Verifica que el Escenario 3 rescata registros del hemisferio sur.\"\"\"\n416:         df_corruptos = self._make_pool_corruptos()\n417:         esc1, esc2, esc3, esc4, no_rep = reparar_coordenadas_corruptas(\n418:             df_corruptos, mapa_cantonal\n419:         )\n420:         # Guayaquil y Cuenca son del Hemisferio Sur → deben estar en esc3\n421:         ids_esc3 = set(esc3[\"ID_temp\"].tolist()) if len(esc3) > 0 else set()\n422:         assert len(ids_esc3) > 0, (\n423:             \"El Escenario 3 (negativo sur) no rescató ningún registro. \"\n424:             \"Es el escenario más crítico para Ecuador.\"\n425:         )\n426: \n427:     def test_no_duplicados_entre_escenarios(self, mapa_cantonal):\n428:         \"\"\"Verifica que un mismo ID_temp no aparezca en dos escenarios.\"\"\"\n429:         df_corruptos = self._make_pool_corruptos()\n430:         esc1, esc2, esc3, esc4, _ = reparar_coordenadas_corruptas(\n431:             df_corruptos, mapa_cantonal\n432:         )\n433:         todos_ids = []\n434:         for df_esc in [esc1, esc2, esc3, esc4]:\n435:             if len(df_esc) > 0:\n436:                 # .extend(lista) agrega TODOS los elementos de esa lista a `todos_ids`.\n437:                 todos_ids.extend(df_esc[\"ID_temp\"].tolist())\n438:         # Si no hay duplicados, el tamaño de la lista es igual al tamaño del set sin repetidos.\n439:         assert len(todos_ids) == len(set(todos_ids)), (\n440:             \"Se encontraron ID_temp duplicados entre escenarios. \"\n441:             \"Un registro fue rescatado por más de un escenario.\"\n442:         )\n443: \n444:     def test_dataset_vacio_sin_error(self, mapa_cantonal):\n445:         \"\"\"Verifica que un dataset vacío no lance errores.\"\"\"\n446:         df_vacio = pd.DataFrame(columns=[\n447:             \"canton\", \"latitud_original\", \"lon_num\",\n448:             \"lat_num\", \"ID_temp\", \"limpia_lat\",\n449:         ])\n450:         esc1, esc2, esc3, esc4, no_rep = reparar_coordenadas_corruptas(\n451:             df_vacio, mapa_cantonal\n452:         )\n453:         for df_esc in [esc1, esc2, esc3, esc4, no_rep]:\n454:             assert len(df_esc) == 0\n455: \n456: \n457: # =========================================================================\n458: # TESTS: Separación por formato (Paso 4.5)\n459: # =========================================================================\n460: class TestSepararPorFormato:\n461:     \"\"\"Tests de separar_por_formato().\"\"\"\n462: \n463:     def test_con_punto_va_al_limbo(self):\n464:         \"\"\"Registros con punto decimal van a limbo_formato_correcto.\"\"\"\n465:         df = pd.DataFrame({\n466:             \"latitud_original\": [\"-2.1894\", \"-0.1807\", \"1.3696\"],\n467:             \"canton\": [\"GUAYAQUIL\", \"QUITO\", \"IBARRA\"],\n468:         })\n469:         limbo, decimales = separar_por_formato(df)\n470:         assert len(limbo) == 3\n471:         assert len(decimales) == 0\n472: \n473:     def test_sin_punto_va_a_reparar(self):\n474:         \"\"\"Registros sin punto decimal van a geo_corregir_decimales.\"\"\"\n475:         df = pd.DataFrame({\n476:             \"latitud_original\": [\"21894\", \"1807\", \"3516\"],\n477:             \"canton\": [\"GUAYAQUIL\", \"QUITO\", \"IBARRA\"],\n478:         })\n479:         limbo, decimales = separar_por_formato(df)\n480:         assert len(limbo) == 0\n481:         assert len(decimales) == 3\n482: \n483:     def test_mixto_separacion_correcta(self):\n484:         \"\"\"Verifica la separación correcta de registros mixtos.\"\"\"\n485:         df = pd.DataFrame({\n486:             \"latitud_original\": [\"-2.1894\", \"21894\", \"-0.1807\", \"1807\"],\n487:             \"canton\": [\"G\", \"G\", \"Q\", \"Q\"],\n488:         })\n489:         limbo, decimales = separar_por_formato(df)\n490:         assert len(limbo) == 2\n491:         assert len(decimales) == 2\n492: \n493:     def test_vacio_sin_error(self):\n494:         \"\"\"Verifica comportamiento con DataFrame vacío.\"\"\"\n495:         df = pd.DataFrame({\"latitud_original\": [], \"canton\": []})\n496:         limbo, decimales = separar_por_formato(df)\n497:         assert len(limbo) == 0\n498:         assert len(decimales) == 0\n499: \n500: \n501: # =========================================================================\n502: # TESTS: Ensamblaje final (Paso 4.7)\n503: # =========================================================================\n504: class TestEnsamblaje:\n505:     \"\"\"Tests de ensamblar_base_final().\"\"\"\n506: \n507:     def _make_df(self, n: int, start_id: int = 1) -> pd.DataFrame:\n508:         \"\"\"Crea un DataFrame de prueba con n registros.\"\"\"\n509:         return pd.DataFrame({\n510:             \"ID_temp\": range(start_id, start_id + n),\n511:             \"canton\": [\"QUITO\"] * n,\n512:             \"lat_num\": [-0.18] * n,\n513:             \"lon_num\": [-78.46] * n,\n514:         })\n515: \n516:     def test_ensamblaje_basico(self):\n517:         \"\"\"Verifica que pd.concat() de las partes produzca la suma correcta.\"\"\"\n518:         df1 = self._make_df(10, 1)\n519:         df2 = self._make_df(5, 11)\n520:         vacio = pd.DataFrame()\n521: \n522:         resultado = ensamblar_base_final(df1, vacio, vacio, df2, vacio, vacio)\n523:         assert len(resultado) == 15\n524: \n525:     def test_elimina_columnas_auxiliares(self):\n526:         \"\"\"Verifica que columnas auxiliares sean eliminadas.\"\"\"\n527:         df = self._make_df(5, 1)\n528:         df[\"latitud_original\"] = \"-2.18\"   # Columna auxiliar\n529:         df[\"CANTON_MAPA\"] = \"GUAYAQUIL\"    # Columna residual de sjoin\n530:         df[\"index_right\"] = 0              # Columna residual de sjoin\n531: \n532:         vacio = pd.DataFrame()\n533:         resultado = ensamblar_base_final(df, vacio, vacio, vacio, vacio, vacio)\n534: \n535:         assert \"latitud_original\" not in resultado.columns\n536:         assert \"CANTON_MAPA\" not in resultado.columns\n537:         assert \"index_right\" not in resultado.columns\n538: \n539:     def test_elimina_filas_nan_coords(self):\n540:         \"\"\"Verifica que filas con NaN en lat/lon sean eliminadas.\"\"\"\n541:         df = self._make_df(5, 1)\n542:         # float(\"nan\") crea un valor numérico nulo (Not a Number) a propósito.\n543:         df.loc[0, \"lat_num\"] = float(\"nan\")\n544:         df.loc[1, \"lon_num\"] = float(\"nan\")\n545: \n546:         vacio = pd.DataFrame()\n547:         resultado = ensamblar_base_final(df, vacio, vacio, vacio, vacio, vacio)\n548:         assert len(resultado) == 3  # Se eliminaron 2 filas con NaN\n549: \n550:     def test_error_todos_vacios(self):\n551:         \"\"\"Verifica que ValueError se lanza si todas las partes están vacías.\"\"\"\n552:         vacio = pd.DataFrame()\n553:         with pytest.raises(ValueError, match=\"vacíos\"):\n554:             ensamblar_base_final(vacio, vacio, vacio, vacio, vacio, vacio)\n555: \n556:     def test_preserva_columnas_originales(self):\n557:         \"\"\"Verifica que las columnas no-auxiliares se preservan.\"\"\"\n558:         df = self._make_df(3, 1)\n559:         df[\"canton\"] = \"QUITO\"\n560: \n561:         vacio = pd.DataFrame()\n562:         resultado = ensamblar_base_final(df, vacio, vacio, vacio, vacio, vacio)\n563:         assert \"canton\" in resultado.columns\n564:         assert \"lat_num\" in resultado.columns\n565:         assert \"lon_num\" in resultado.columns\n566: \n567: \n568: # =========================================================================\n569: # TEST DE INTEGRACIÓN REAL: Pipeline completo sobre datos reales (Paso 4.9)\n570: # =========================================================================\n571: class TestPipelineCompletoReal:\n572:     \"\"\"\n573:     Test de integración que ejecuta el pipeline completo de Fase 4 sobre\n574:     los datos reales de homi_filtrado_2024.parquet.\n575:     \"\"\"\n576: \n577:     @pytest.fixture\n578:     def datos_filtrados(self):\n579:         \"\"\"Carga los datos reales de Fase 3 si existen.\"\"\"\n580:         try:\n581:             return cargar_intermedio_filtrado()\n582:         except FileNotFoundError:\n583:             pytest.skip(\n584:                 \"No existe homi_filtrado_2024.parquet. \"\n585:                 \"Ejecuta primero las Fases 1–3.\"\n586:             )\n587: \n588:     def test_crear_puntos_datos_reales(self, datos_filtrados):\n589:         \"\"\"Verifica que se creen puntos geoespaciales válidos.\"\"\"\n590:         gdf = crear_geodataframe_puntos(datos_filtrados)\n591:         assert len(gdf) > 0\n592:         assert \"ID_temp\" in gdf.columns\n593:         assert \"lat_num\" in gdf.columns\n594:         assert \"lon_num\" in gdf.columns\n595:         assert gdf.crs is not None\n596: \n597:     def test_id_temp_unico(self, datos_filtrados):\n598:         \"\"\"Verifica que ID_temp sea único en el GeoDataFrame.\"\"\"\n599:         gdf = crear_geodataframe_puntos(datos_filtrados)\n600:         assert gdf[\"ID_temp\"].nunique() == len(gdf), (\n601:             \"ID_temp contiene valores duplicados.\"\n602:         )\n603: \n604:     def test_auditoria_produce_dos_grupos(self, datos_filtrados, mapa_cantonal):\n605:         \"\"\"Verifica que la auditoría topológica produce correctos + a corregir.\"\"\"\n606:         gdf = crear_geodataframe_puntos(datos_filtrados)\n607:         correctos, corregir = auditar_punto_en_poligono(gdf, mapa_cantonal)\n608:         total = len(correctos) + len(corregir)\n609:         assert total == len(gdf), (\n610:             f\"Pérdida de registros: {len(gdf)} entrada != {total} salida\"\n611:         )\n612: \n613:     def test_sin_duplicados_correctos_corregir(self, datos_filtrados, mapa_cantonal):\n614:         \"\"\"Verifica que un ID_temp no aparezca en ambos grupos.\"\"\"\n615:         gdf = crear_geodataframe_puntos(datos_filtrados)\n616:         correctos, corregir = auditar_punto_en_poligono(gdf, mapa_cantonal)\n617: \n618:         ids_correctos = set(correctos[\"ID_temp\"])\n619:         ids_corregir = set(corregir[\"ID_temp\"])\n620:         # \"&\" entre dos conjuntos (`set`) calcula la INTERSECCIÓN (elementos en común).\n621:         # No debe haber ningún ID que esté en ambos grupos a la vez.\n622:         interseccion = ids_correctos & ids_corregir\n623: \n624:         assert len(interseccion) == 0, (\n625:             f\"Se encontraron {len(interseccion)} IDs en ambos grupos: \"\n626:             f\"{list(interseccion)[:5]}\"\n627:         )"}
