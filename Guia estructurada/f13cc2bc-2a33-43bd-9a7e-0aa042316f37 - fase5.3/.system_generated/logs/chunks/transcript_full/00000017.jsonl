{"step_index":415,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T15:36:02Z","content":"Created At: 2026-11-10T10:36:02-05:00\nCompleted At: 2026-11-10T10:36:02-05:00\nShowing lines 455-484 of 484\n455:         # Guardamos la tabla de rescatados de este escenario en la lista.\n456:         resultados.append(rescatados)\n457:         print(f\"        {nombre}: {len(rescatados):,} rescatados \"\n458:               f\"({len(pendientes):,} pendientes)\")\n459: \n460:     # Limpiar columna auxiliar de todos los DataFrames\n461:     # enumerate(lista) → recorre la lista dándonos posición E ítem: (0, esc1), (1, esc2)...\n462:     # Usamos `i` para sobreescribir `resultados[i]` sin la columna temporal \"limpia_lat\".\n463:     for i, r in enumerate(resultados):\n464:         if len(r) > 0 and \"limpia_lat\" in r.columns:\n465:             resultados[i] = r.drop(columns=[\"limpia_lat\"])\n466: \n467:     if len(pendientes) > 0 and \"limpia_lat\" in pendientes.columns:\n468:         pendientes = pendientes.drop(columns=[\"limpia_lat\"])\n469: \n470:     # sum(...) suma la cantidad de filas rescatadas en los 4 escenarios.\n471:     n_total_rescatados = sum(len(r) for r in resultados)\n472:     n_no_reparados = len(pendientes)  # Lo que quedó en `pendientes` tras los 4 intentos.\n473: \n474:     print(f\"        {'─' * 45}\")\n475:     print(f\"        Total rescatados: {n_total_rescatados:,} de {n_total:,}\")\n476:     print(f\"        No reparados: {n_no_reparados:,}\")\n477: \n478:     return (\n479:         resultados[0],  # Escenario 1 (índice 0 de la lista)\n480:         resultados[1],  # Escenario 2 (índice 1 de la lista)\n481:         resultados[2],  # Escenario 3 (índice 2 de la lista)\n482:         resultados[3],  # Escenario 4 (índice 3 de la lista)\n483:         pendientes,     # No reparados (ej. coordenadas 0, 0 irrecuperables)\n484:     )"}
{"step_index":416,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-10T15:36:02Z","input_tokens":3178,"cache_read_tokens":65767,"output_tokens":1227,"tool_calls":[{"name":"edit_file","args":{"Path":"D:\\Tesis\\src\\validacion_geo\\reparacion.py","Replacement":"    print(f\"        {'─' * 45}\")\n    print(f\"        Total rescatados: {n_total_rescatados:,} de {n_total:,}\")\n    print(f\"        No reparados: {n_no_reparados:,}\")\n\n    # Si quedaron registros sin reparar (excluidos), los imprimimos explícitamente en consola\n    # para que el usuario visualice exactamente qué coordenadas inválidas provocaron su descarte.\n    if n_no_reparados > 0:\n        imprimir_detalle_no_reparados(pendientes)\n\n    return (\n        resultados[0],  # Escenario 1 (índice 0 de la lista)\n        resultados[1],  # Escenario 2 (índice 1 de la lista)\n        resultados[2],  # Escenario 3 (índice 2 de la lista)\n        resultados[3],  # Escenario 4 (índice 3 de la lista)\n        pendientes,     # No reparados (ej. coordenadas 0, 0 irrecuperables)\n    )\n\n\n# =========================================================================\n# AUDITORÍA EN CONSOLA: Detalle explícito de registros no reparados (excluidos)\n# =========================================================================\ndef imprimir_detalle_no_reparados(no_reparados: pd.DataFrame) -> None:\n    \"\"\"\n    Imprime en consola el listado detallado de los registros cuyas coordenadas\n    no pudieron ser rescatadas por ninguno de los 4 escenarios decimales y que,\n    por lo tanto, quedan excluidos de la base georreferenciada final.\n\n    Parameters\n    ----------\n    no_reparados : pd.DataFrame\n        DataFrame con los registros irrecuperables devueltos al final del Paso 4.6.\n    \"\"\"\n    if no_reparados is None or len(no_reparados) == 0:\n        return\n\n    print(\"\\n        \" + \"=\" * 86)\n    print(\n        f\"        [AUDITORÍA DE EXCLUSIÓN] REGISTROS NO REPARADOS DESCARTADOS ({len(no_reparados):,} fila/s):\"\n    )\n    print(\"        \" + \"-\" * 86)\n    print(\n        f\"        {'ID_temp':<8} | {'Caso':<8} | {'Fecha':<10} | \"\n        f\"{'Provincia':<12} | {'Cantón':<16} | {'Lat original':<12} | {'Lon original':<12}\"\n    )\n    print(\"        \" + \"-\" * 86)\n\n    # Recorremos cada fila descartada mostrando sus campos identificadores y sus coordenadas crudas.\n    for _, fila in no_reparados.iterrows():\n        id_temp = str(fila.get(\"ID_temp\", \"N/A\"))\n        caso = str(fila.get(\"codigo_caso\", \"N/A\"))\n        fecha = str(fila.get(\"fecha_hecho\", \"N/A\"))[:10]\n        prov = str(fila.get(\"provincia\", \"N/A\"))\n        canton = str(fila.get(\"canton\", \"N/A\"))\n        lat_raw = str(fila.get(\"latitud_original\", fila.get(\"latitud\", fila.get(\"lat_num\", \"N/A\"))))\n        lon_raw = str(fila.get(\"longitud_original\", fila.get(\"longitud\", fila.get(\"lon_num\", \"N/A\"))))\n\n        print(\n            f\"        {id_temp:<8} | {caso:<8} | {fecha:<10} | \"\n            f\"{prov:<12} | {canton:<16} | {lat_raw:<12} | {lon_raw:<12}\"\n        )\n\n    print(\"        \" + \"-\" * 86)\n    print(\n        \"        Motivo: Coordenadas nulas o en origen (0, 0 — Golfo de Guinea), sin dígitos \"\n        \"geográficos válidos para reconstruir.\"\n    )\n    print(\"        \" + \"=\" * 86 + \"\\n\")","Target":"    print(f\"        {'─' * 45}\")\n    print(f\"        Total rescatados: {n_total_rescatados:,} de {n_total:,}\")\n    print(f\"        No reparados: {n_no_reparados:,}\")\n\n    return (\n        resultados[0],  # Escenario 1 (índice 0 de la lista)\n        resultados[1],  # Escenario 2 (índice 1 de la lista)\n        resultados[2],  # Escenario 3 (índice 2 de la lista)\n        resultados[3],  # Escenario 4 (índice 3 de la lista)\n        pendientes,     # No reparados (ej. coordenadas 0, 0 irrecuperables)\n    )"}}]}
