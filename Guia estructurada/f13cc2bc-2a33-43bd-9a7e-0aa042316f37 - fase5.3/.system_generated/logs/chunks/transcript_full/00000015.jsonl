esta.config import ARCHIVO_SHAPEFILE_CANTONES, INTERIM_FILTRADO\n\nmapa = gpd.read_file(ARCHIVO_SHAPEFILE_CANTONES)\nprint('=== Caracteres no-ASCII en nxcantones.shp (DPA_DESPRO y DPA_DESCAN) ===')\nfor col in ['DPA_DESPRO', 'DPA_DESCAN']:\n    raros = mapa[col][mapa[col].str.contains(r'[^\\x00-\\x7F]', regex=True, na=False)].unique().tolist()\n    print(col, ':', raros)\n\ndf = pd.read_parquet(INTERIM_FILTRADO)\ncantones_shp = set(mapa['DPA_DESCAN'].str.replace('Ð', 'N').str.strip().str.upper())\ncantones_csv = set(df['canton'].unique())\nno_en_shp = sorted(cantones_csv - cantones_shp)\nprint('\\n=== Valores de canton en CSV que NO existen literalmente en DPA_DESCAN del shapefile ===')\nfor c in no_en_shp:\n    sub = df[df['canton'] == c]\n    provs = sub['provincia'].value_counts().to_dict()\n    print(f'  {c:<32} -> {len(sub):>4} filas | provincias en CSV: {provs}')\n\"","WaitMsBeforeAsync":10000,"toolSummary":"Check all non-ASCII in shapefile and all unmatched canton names in CSV"}}]}
