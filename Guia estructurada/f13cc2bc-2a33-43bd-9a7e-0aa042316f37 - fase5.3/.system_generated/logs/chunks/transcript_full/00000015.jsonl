lizar_texto(\"ÁÉÍÓÚ\") == \"AEIOU\"\n38: \n39:     def test_elimina_ene(self):\n40:         \"\"\"Verifica que la eñe se convierta a N.\"\"\"\n41:         assert normalizar_texto(\"Ñuño\") == \"NUNO\"\n42:         assert normalizar_texto(\"ñ\") == \"N\"\n43:         assert normalizar_texto(\"SEÑOR\") == \"SENOR\"\n44: \n45:     def test_elimina_dieresis(self):\n46:         \"\"\"Verifica que la diéresis (ü/Ü) se convierta a U.\"\"\"\n47:         assert normalizar_texto(\"güero\") == \"GUERO\"\n48:         assert normalizar_texto(\"PINGÜINO\") == \"PINGUINO\"\n49: \n50:     def test_strip_espacios(self):\n51:         \"\"\"Verifica la remoción de espacios al inicio y final.\"\"\"\n52:         assert normalizar_texto(\"  Guayaquíl  \") == \"GUAYAQUIL\"\n53:         assert normalizar_texto(\"  quito  \") == \"QUITO\"\n54:         # \\t = tabulación, \\n = salto de línea; strip() también los elimina.\n55:         assert normalizar_texto(\"\\t CUENCA \\n\") == \"CUENCA\"\n56: \n57:     def test_mayusculas(self):\n58:         \"\"\"Verifica la conversión a mayúsculas.\"\"\"\n59:         assert normalizar_texto(\"guayaquil\") == \"GUAYAQUIL\"\n60:         assert normalizar_texto(\"santo domingo\") == \"SANTO DOMINGO\"\n61: \n62:     def test_cadena_completa(self):\n63:         \"\"\"Verifica la normalización completa de nombres geográficos ecuatorianos.\"\"\"\n64:         assert normalizar_texto(\"SANTO DOMINGO DE LOS TSÁCHILAS\") == \"SANTO DOMINGO DE LOS TSACHILAS\"\n65:         assert normalizar_texto(\"  Esmeraldas  \") == \"ESMERALDAS\"\n66:         assert normalizar_texto(\"Portoviejo\") == \"PORTOVIEJO\"\n67:         assert normalizar_texto(\"Zamora-Chinchipe\") == \"ZAMORA-CHINCHIPE\"\n68: \n69:     def test_texto_ya_limpio(self):\n70:         \"\"\"Verifica que un texto ya normalizado no cambie.\"\"\"\n71:         # Propiedad de \"idempotencia\": aplicar la limpieza una segunda vez no cambia nada.\n72:         assert normalizar_texto(\"QUITO\") == \"QUITO\"\n73:         assert normalizar_texto(\"GUAYAQUIL\") == \"GUAYAQUIL\"\n74: \n75:     def test_valor_no_string(self):\n76:         \"\"\"Verifica que valores no-string (NaN, None, int) pasen sin error.\"\"\"\n77:         # Para None siempre se compara con `is None` (identidad), no con `==`.\n78:         assert normalizar_texto(None) is None\n79:         assert normalizar_texto(42) == 42\n80:         assert normalizar_texto(3.14) == 3.14\n81: \n82:     def test_string_vacio(self):\n83:         \"\"\"Verifica el comportamiento con string vacío.\"\"\"\n84:         assert normalizar_texto(\"\") == \"\"\n85:         assert normalizar_texto(\"   \") == \"\"  # Solo espacios → queda vacío \"\".\n86: \n87:     def test_caracteres_mixtos(self):\n88:         \"\"\"Verifica mezcla de acentos y caracteres ASCII normales.\"\"\"\n89:         assert normalizar_texto(\"Café123\") == \"CAFE123\"\n90:         assert normalizar_texto(\"Niño-2024\") == \"NINO-2024\"\n91: \n92: \n93: # =========================================================================\n94: # TESTS UNITARIOS: normalizar_columna() — Función vectorizada\n95: # =========================================================================\n96: class TestNormalizarColumna:\n97:     \"\"\"Tests de la función normalizar_columna() para pd.Series.\"\"\"\n98: \n99:     def test_serie_basica(self):\n100:         \"\"\"Verifica la normalización de una Serie simple.\"\"\"\n101:         # pd.Series([...]) crea una columna suelta de pandas a partir de una lista.\n102:         serie = pd.Series([\"  Guayaquíl  \", \"Ñuño\", \"QUITO\"])\n103:         resultado = normalizar_columna(serie)\n104:         # .tolist() convierte la columna de vuelta a lista para compararla con ==.\n105:         assert resultado.tolist() == [\"GUAYAQUIL\", \"NUNO\", \"QUITO\"]\n106: \n107:     def test_serie_con_nulos(self):\n108:         \"\"\"Verifica que los valores NA se preserven correctamente.\"\"\"\n109:         # pd.NA es el valor nulo propio de pandas (similar al NA de R).\n110:         serie = pd.Series([\"  Guayaquíl  \", None, \"Ñuño\", pd.NA])\n111:         resultado = normalizar_columna(serie)\n112:         # .iloc[n] → accede al elemento en la POSICIÓN n (0 = primero, 1 = segundo...).\n113:         assert resultado.iloc[0] == \"GUAYAQUIL\"\n114:         # pd.isna(x) → True si x es nulo (sirve tanto para None como para NaN y pd.NA).\n115:         assert pd.isna(resultado.iloc[1])\n116:         assert resultado.iloc[2] == \"NUNO\"\n117:         assert pd.isna(resultado.iloc[3])\n118: \n119:     def test_serie_vacia(self):\n120:         \"\"\"Verifica el comportamiento con Serie vacía.\"\"\"\n121:         serie = pd.Series([], dtype=str)\n122:         resultado = normalizar_columna(serie)\n123:         assert len(resultado) == 0\n124: \n125:     def test_preserva_indice(self):\n126:         \"\"\"Verifica que el índice original se mantenga.\"\"\"\n127:         # index=[10, 20, 30] asigna etiquetas personalizadas a las filas.\n128:         serie = pd.Series([\"á\", \"é\", \"í\"], index=[10, 20, 30])\n129:         resultado = normalizar_columna(serie)\n130:         assert list(resultado.index) == [10, 20, 30]\n131:         assert resultado.tolist() == [\"A\", \"E\", \"I\"]\n132: \n133: \n134: # =========================================================================\n135: # TESTS DE INTEGRACIÓN: normalizar_todas_columnas() — Pipeline completo\n136: # =========================================================================\n137: # Un \"test de integración\" prueba cómo funcionan VARIAS piezas juntas\n138: # (ej. normalizar_todas_columnas llamando internamente a normalizar_columna y config).\n139: class TestNormalizarTodasColumnas:\n140:     \"\"\"Tests del pipeline completo de normalización.\"\"\"\n141: \n142:     # ¿Qué es `@pytest.fixture`?\n143:     #   Es un decorador de pytest que marca a una función como \"proveedora de\n144:     #   datos de prueba\". Cualquier test que ponga `df_simulado` entre sus\n145:     #   paréntesis recibirá automáticamente un DataFrame NUEVO y limpio creado\n146:     #   por esta función, sin tener que copiar y pegar la tabla en cada test.\n147:     @pytest.fixture\n148:     def df_simulado(self) -> pd.DataFrame:\n149:         \"\"\"\n150:         Crea un DataFrame de prueba que simula la estructura real\n151:         con las 21 columnas (13 de texto + 8 no-texto).\n152:         \"\"\"\n153:         # pd.DataFrame({columna: [valores...]}) crea una tabla desde un diccionario.\n154:         return pd.DataFrame({\n155:             # 13 columnas de texto (con tildes y eñes intencionalmente)\n156:             \"codigo_caso\":          [\"  ABC-001  \", \"DEF-002\"],\n157:             \"tipo_delito\":          [\"Homicidio\", \"Asesinato\"],\n158:             \"zona_tipo\":            [\"URBANO\", \"Rural\"],\n159:             \"lugar_especifico\":     [\"Vía Pública\", \"Domicilio\"],\n160:             \"tipo_arma\":            [\"Arma de Fuego\", \"Arma Blanca\"],\n161:             \"motivacion_detalle\":   [\"Violencia Comunitaria\", \"Riñas\"],\n162:             \"causa_especifica\":     [\"Venganza\", \"Robo\"],\n163:             \"sexo_victima\":         [\"Masculino\", \"Femenino\"],\n164:             \"nacionalidad_victima\": [\"Ecuatoriana\", \"Colombiana\"],\n165:             \"canton\":               [\"  Guayaquíl  \", \"Quito\"],\n166:             \"mes_hecho\":            [\"Enero\", \"Febrero\"],\n167:             \"dia_semana\":           [\"Lunes\", \"Martes\"],\n168:             \"provincia\":            [\"GUAYAS\", \"Pichincha\"],\n169:             # 8 columnas no-texto (no deben ser afectadas)\n170:             \"fecha_hecho\":          [\"2023-01-15\", \"2023-02-20\"],\n171:             \"anio_hecho\":           [\"2023\", \"2023\"],\n172:             \"hora_aproximada\":      [\"14\", \"22\"],\n173:             \"edad_victima\":         [\"35\", \"28\"],\n174:             \"latitud\":              [\"-2.1894\", \"-0.1807\"],\n175:             \"longitud\":             [\"-79.8891\", \"-78.4678\"],\n176:             \"AUX_HORA_SISTEMA\":     [\"14\", \"22\"],\n177:             \"AUX_MINUTO_SISTEMA\":   [\"30\", \"45\"],\n178:         })\n179: \n180:     # pytest ve el parámetro `df_simulado` y le inyecta lo que devuelve el fixture de arriba.\n181:     def test_normaliza_13_columnas(self, df_simulado: pd.DataFrame):\n182:         \"\"\"Verifica que las 13 columnas de texto se normalicen.\"\"\"\n183:         resultado = normalizar_todas_columnas(df_simulado)\n184: \n185:         # Verificar cada columna de texto y cada celda dentro de ella.\n186:         for col in COLUMNAS_TEXTO_NORMALIZAR:\n187:             for valor in resultado[col].dropna():\n188:                 assert valor == valor.upper(), (\n189:                     f\"Columna '{col}' tiene valor no-mayúscula: '{valor}'\"\n190:                 )\n191:                 assert not contiene_caracteres_especiales(valor), (\n192:                     f\"Columna '{col}' aún tiene caracteres especiales: '{valor}'\"\n193:                 )\n194: \n195:     def test_guayaquil_normalizado(self, df_simulado: pd.DataFrame):\n196:         \"\"\"Verifica que 'Guayaquíl' → 'GUAYAQUIL'.\"\"\"\n197:         resultado = normalizar_todas_columnas(df_simulado)\n198:         # .loc[fila, columna] → accede a la celda de la fila 0 en la columna \"canton\".\n199:         assert resultado.loc[0, \"canton\"] == \"GUAYAQUIL\"\n200: \n201:     def test_columnas_no_texto_intactas(self, df_simulado: pd.DataFrame):\n202:         \"\"\"Verifica que las columnas no-texto NO sean modificadas.\"\"\"\n203:         resultado = normalizar_todas_columnas(df_simulado)\n204:         assert resultado.loc[0, \"latitud\"] == \"-2.1894\"\n205:         assert resultado.loc[0, \"longitud\"] == \"-79.8891\"\n206:         assert resultado.loc[0, \"anio_hecho\"] == \"2023\"\n207: \n208:     def test_forma_preservada(self, df_simulado: pd.DataFrame):\n209:         \"\"\"Verifica que no se agreguen ni eliminen filas o columnas.\"\"\"\n210:         resultado = normalizar_todas_columnas(df_simulado)\n211:         assert resultado.shape == df_simulado.shape\n212: \n213:     def test_error_columna_faltante(self):\n214:         \"\"\"Verifica que lance KeyError si falta una columna de texto.\"\"\"\n215:         df_incompleto = pd.DataFrame({\"codigo_caso\": [\"ABC\"]})\n216:         # `with pytest.raises(TipoDeError, match=\"texto\"):` → esta prueba PASA\n217:         # solo si el código de adentro efectivamente lanza ese error y su mensaje\n218:         # contiene \"Columnas de texto no encontradas\". Si NO lanzara error, fallaría.\n219:         with pytest.raises(KeyError, match=\"Columnas de texto no encontradas\"):\n220:             normalizar_todas_columnas(df_incompleto)\n221: \n222: \n223: # =========================================================================\n224: # TESTS DE AUDITORÍA: auditar_caracteres_especiales()\n225: # =========================================================================\n226: class TestAuditoriaCaracteres:\n227:     \"\"\"Tests de la función de auditoría de caracteres especiales.\"\"\"\n228: \n229:     def test_datos_sucios_detectados(self):\n230:         \"\"\"Verifica que se detecten tildes en datos NO normalizados.\"\"\"\n231:         df = pd.DataFrame({\n232:             \"canton\": [\"Guayaquíl\", \"Quito\", \"Cuenca\"],\n233:             \"provincia\": [\"GUAYAS\", \"PICHINCHA\", \"AZUAY\"],\n234:         })\n235:         reporte = auditar_caracteres_especiales(\n236:             df, columnas=[\"canton\", \"provincia\"]\n237:         )\n238:         # Accedemos a los atributos del objeto `ReporteAuditoria` con punto \".\"\n239:         assert not reporte.limpio\n240:         assert reporte.columnas_con_problemas == 1\n241:         assert reporte.hallazgos[0].columna == \"canton\"\n242: \n243:     def test_datos_limpios_ok(self):\n244:         \"\"\"Verifica que datos ya normalizados pasen la auditoría.\"\"\"\n245:         df = pd.DataFrame({\n246:             \"canton\": [\"GUAYAQUIL\", \"QUITO\", \"CUENCA\"],\n247:             \"provincia\": [\"GUAYAS\", \"PICHINCHA\", \"AZUAY\"],\n248:         })\n249:         reporte = auditar_caracteres_especiales(\n250:             df, columnas=[\"canton\", \"provincia\"]"}
