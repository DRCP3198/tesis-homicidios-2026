ords\n354:             lat_str=\"21894\",\n355:             lon_str=\"-79.8891\",\n356:             lat_num=-2.1894,\n357:             lon_num=-79.8891,\n358:         )\n359:         df_prueba[\"limpia_lat\"] = _limpiar_cadena_lat(pd.Series([\"21894\"]))\n360:         lat_rec = reconstruir_escenario_3(df_prueba[\"limpia_lat\"])\n361:         ids = validar_reconstruccion_sjoin(df_prueba, lat_rec, mapa_cantonal)\n362:         assert 1 not in ids, (\n363:             \"Un punto de GUAYAQUIL con cantón='QUITO' no debería rescatarse.\"\n364:         )\n365: \n366: \n367: # =========================================================================\n368: # TESTS DE INTEGRACIÓN: Pipeline completo de reparación\n369: # =========================================================================\n370: class TestReparacionCompleta:\n371:     \"\"\"Tests del orquestador reparar_coordenadas_corruptas().\"\"\"\n372: \n373:     # Método auxiliar interno de la clase (no empieza con `test_`, así que\n374:     # pytest no lo ejecuta como prueba; solo lo llamamos desde los tests de abajo).\n375:     def _make_pool_corruptos(self) -> pd.DataFrame:\n376:         \"\"\"Crea un pool de registros con coordenadas corruptas (sin punto).\"\"\"\n377:         rows = [\n378:             # Escenario 3: negativo sur\n379:             {\n380:                 \"canton\": \"GUAYAQUIL\", \"latitud_original\": \"21894\",\n381:                 \"longitud_original\": \"-79.8891\", \"lat_num\": -2.1894,\n382:                 \"lon_num\": -79.8891, \"ID_temp\": 1,\n383:             },\n384:             {\n385:                 \"canton\": \"CUENCA\", \"latitud_original\": \"28970\",\n386:                 \"longitud_original\": \"-79.0045\", \"lat_num\": -2.8970,\n387:                 \"lon_num\": -79.0045, \"ID_temp\": 2,\n388:             },\n389:             # Escenario 4: negativo ecuatorial\n390:             {\n391:                 \"canton\": \"QUITO\", \"latitud_original\": \"1807\",\n392:                