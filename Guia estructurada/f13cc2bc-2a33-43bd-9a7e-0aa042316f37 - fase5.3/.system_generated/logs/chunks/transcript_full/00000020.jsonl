o tal como venía en el CSV, después no sabríamos\n88:     # si tenía punto decimal o no.\n89:     # .astype(str) → asegura que cada celda quede como texto puro.\n90:     df[\"latitud_original\"] = df[\"latitud\"].astype(str)\n91:     df[\"longitud_original\"] = df[\"longitud\"].astype(str)\n92: \n93:     # Conversión numérica: as.numeric() → pd.to_numeric(errors='coerce')\n94:     # errors='coerce' convierte valores no-numéricos a NaN (equivale a NA en R)\n95:     # Guardamos los números en columnas nuevas (lat_num, lon_num) para conservar\n96:     # también las columnas originales.\n97:     df[\"lat_num\"] = pd.to_numeric(df[\"latitud\"], errors=\"coerce\")\n98:     df[\"lon_num\"] = pd.to_numeric(df[\"longitud\"], errors=\"coerce\")\n99: \n100:     n_antes = len(df)\n101:     n_lat_nan = df[\"lat_num\"].isna().sum()  # Cuántas latitudes quedaron vacías (NaN).\n102:     n_lon_nan = df[\"lon_num\"].isna().sum()  # Cuántas longitudes quedaron vacías (NaN).\n103: \n104:     # filter(!is.na(lat.new) & !is.na(lon.new)) → dropna\n105:     # Elimina cualquier fila a la que le falte la latitud O la longitud\n106:     # (sin ambas coordenadas es imposible ubicar el punto en el mapa).\n107:     df = df.dropna(subset=[\"lat_num\", \"lon_num\"]) #de estas columnas elimina los na\n108:     n_despues = len(df)\n109: \n110:     print(f\"        Registros entrada: {n_antes:,}\")\n111:     print(f\"        NaN en latitud:  {n_lat_nan:,}\")\n112:     print(f\"        NaN en longitud: {n_lon_nan:,}\")\n113:     print(f\"        Registros con coordenadas válidas: {n_despues:,}\")\n114: \n115:     # Asignar ID temporal secuencial (≡ homi_2010_2024_fin$ID.temp <- 1:nrow(...))\n116:     #\n117:     # .reset_index(drop=True) → renumera el índice de filas desde 0 (0, 1, 2...)\n118:     #                           sin huecos (por si dropna borró filas intermedias).\n119:     #                           drop=True descarta el índice viejo en lugar de guardarlo\n120:     #                           como columna.\n121:     # range(1, len(df) + 1)   → genera los números 1, 2, 3, ..., N.\n122:     #                           (En Python range(a, b) llega hasta b-1, por eso el +1).\n123:     # Este ID_temp es la \"cédula única\" de cada homicidio para seguirle el rastro.\n124:     df = df.reset_index(drop=True)\n125:     df[\"ID_temp\"] = range(1, len(df) + 1)\n126: \n127:     # Crear GeoDataFrame de puntos\n128:     # Equivale a: st_as_sf(point_analisis, coords = c(\"x\",\"y\"), crs = st_crs(Provincia))\n129:     # NOTA: points_from_xy recibe (x=longitud, y=latitud) — orden geográfico estándar\n130:     #\n131:     # ¡CUIDADO CON EL ORDEN!\n132:     #   En el habla cotidiana decimos \"latitud, longitud\" (Y, X).\n133:     #   Pero en geometría y mapas un punto es (X, Y) = (Este-Oeste, Norte-Sur)\n134:     #   = (LONGITUD, LATITUD). Si se invierten, los puntos de Ecuador aparecen\n135:     #   en medio del océano Índico.\n136:     # gpd.points_from_xy(x, y) → construye un objeto Point(x, y) por cada fila.\n137:     # crs=f\"EPSG:{CRS_OBJETIVO}\" → indica que esos números son grados WGS84 (\"EPSG:4326\").\n138:     gdf = gpd.GeoDataFrame(\n139:         df,\n140:         geometry=gpd.points_from_xy(df[\"lon_num\"], df[\"lat_num\"]),\n141:         crs=f\"EPSG:{CRS_OBJETIVO}\",\n142:     )\n143:     #En pocas palabrabras cojo la longitud y latitud y creo la nuve de puntos en formato EPSG:4326 que es un estandar creado por una petrolera\n144: \n145:     print(f\"        GeoDataFrame creado: {len(gdf):,} puntos en EPSG:{CRS_OBJETIVO}\")\n146: \n147:     return gdf\n148: \n149: \n150: # =========================================================================\n151: # PASO 4.4 — Primera Auditoría Topológica (sjoin vectorizado)\n152: # =========================================================================\n153: def auditar_punto_en_poligono(\n154:     gdf_puntos: gpd.GeoDataFrame,  # Los homicidios como puntos en el mapa.\n155:     mapa: gpd.GeoDataFrame,        # Los cantones como polígonos en el mapa.\n156: ) -> tuple[pd.DataFrame, pd.DataFrame]:  # Devuelve (correctos, a_corregir).\n157:     \"\"\"\n158:     Verifica si cada punto cae dentro del polígono del cantón reportado.\n159: \n160:     **[OPTIMIZACIÓN CRÍTICA vs. R]:**\n161:     El código R usa un bucle for(j in 1:length(cantones)) con st_intersects()\n162:     cantón por cantón (O(n×m)). Aquí reemplazamos TODO el bucle por un ÚNICO\n163:     gpd.sjoin() vectorizado que usa un índice espacial R-tree internamente,\n164:     reduciendo la complejidad a O(n log m).\n165: \n166:     Equivalencia R (líneas 265-298):\n167:         for(j in 1:length(cantones.puntos)) {\n168:             base.canton <- filter(CANTON_HECHO == cantones.puntos[j])\n169:             poligono.canton <- Provincia %>% filter(CANTON_MAPA == ...)\n170:             aux.dentro.polig <- st_intersects(puntos.evaluar, poligono.canton)\n171:             dentro.polig <- puntos.evaluar[apply(aux.dentro.polig, 1, any), ]\n172:             correctos <- c(correctos, dentro.polig$ID.temp)\n173:         }\n174:         geo_correctos <- filter(ID.temp %in% correctos)\n175:         geo.corregir.master <- filter(!(ID.temp %in% correctos))\n176: \n177:     Mapeo R → Python:\n178:         st_intersects(sparse=FALSE)  →  gpd.sjoin(predicate='intersects')\n179:         for(j in 1:n)                →  UN SOLO sjoin vectorizado\n180:         filter(ID.temp %in% ...)     →  df[df['ID_temp'].isin(...)]\n181: \n182:     Parameters\n183:     ----------\n184:     gdf_puntos : gpd.GeoDataFrame\n185:         GeoDataFrame de puntos con columnas 'canton' y 'ID_temp'.\n186:     mapa : gpd.GeoDataFrame\n187:         GeoDataFrame del mapa cantonal con columna 'CANTON_MAPA'.\n188: \n189:     Returns\n190:     -------\n191:     tuple[pd.DataFrame, pd.DataFrame]\n192:         - geo_correctos: Registros cuya coordenada cae DENTRO de su cantón.\n193:         - geo_corregir: Registros cuya coordenada cae FUERA de su cantón.\n194:     \"\"\"\n195:     print(\"  [4.4] Auditoría topológica: punto-en-polígono (sjoin vectorizado)\")\n196: \n197:     n_total = len(gdf_puntos)\n198: \n199:     # ── sjoin global: UNA sola operación reemplaza todo el bucle R ──\n200:     # predicate='intersects' equivale a st_intersects()\n201:     # how='left' para preservar TODOS los puntos (los que no caigan en ningún\n202:     # polígono tendrán NaN en las columnas del mapa)\n203:     #\n204:     # ¿Qué hace gpd.sjoin() (\"spatial join\" = unión espacial)?\n205:     #   Toma cada punto de `gdf_puntos` y busca en qué polígono de `mapa` cae.\n206:     #   Cuando encuentra el polígono, le PEGA al costado el valor de CANTON_MAPA\n207:     #   de ese polígono.\n208:     #   Ejemplo del resultado fila por fila:\n209:     #     ID_temp | canton (reportado) | CANTON_MAPA (donde cayó)\n210:     #     1       | CUENCA             | CUENCA          ← ¡coincide! (correcto)\n211:     #     2       | QUITO              | RUMINAHUI       ← no coincide (a corregir)\n212:     #     3       | GUAYAQUIL          | NaN (en el mar) ← no cayó en ninguno (a corregir)\n213:     #\n214:     #   ¿Por qué es tan rápido? Porque internamente arma un \"R-tree\" (un índice\n215:     #   de cajas envolventes): en vez de probar cada punto contra los 216 cantones,\n216:     #   descarta de golpe todos los cantones lejanos y solo prueba 1 o 2 vecinos.\n217:     #\n218:     #   mapa[[\"CANTON_MAPA\", \"geometry\"]] → del mapa solo llevamos esas 2 columnas\n219:     #   para no llenar la tabla de columnas innecesarias.\n220:     resultado_sjoin = gpd.sjoin(\n221:         gdf_puntos,\n222:         mapa[[\"CANTON_MAPA\", \"geometry\"]],\n223:         how=\"left\",\n224:         predicate=\"intersects\",\n225:     )\n226: \n227:     #esta operación hace un cruce espacial donde la capa base son tus puntos y el mapa\n228:     # con poligonos, \"intersects\" evalúa si el punto comparte al menos un vértice o área con el polígono.\n229: \n230: \n231:     # ── Comparar cantón reportado vs. cantón geográfico ──\n232:     # Un punto es \"correcto\" si el cantón que reporta la base de datos\n233:     # coincide con el cantón del polígono donde cae geométricamente.\n234:     # Crea una columna booleana (True/False) comparando ambas columnas fila a fila.\n235:     resultado_sjoin[\"_coincide\"] = (\n236:         resultado_sjoin[\"canton\"] == resultado_sjoin[\"CANTON_MAPA\"]\n237:     )\n238:     #Si coincide TRUE, el canton por registro como canton geografico por latitud y longitud\n239: \n240:     # Obtener IDs de los registros correctos (coincidencia cantón-polígono)\n241:     #   .loc[condicion, \"ID_temp\"] → toma el ID_temp solo de las filas con _coincide == True.\n242:     #   .unique()                  → sin repetidos (por si un punto cayó justo en\n243:     #                                la frontera entre dos polígonos y sjoin lo duplicó).\n244:     #   set(...)                   → lo convierte en conjunto: buscar dentro de un set\n245:     #                                es instantáneo aunque tenga decenas de miles de IDs.\n246:     ids_correctos = set(\n247:         resultado_sjoin.loc[resultado_sjoin[\"_coincide\"], \"ID_temp\"].unique()\n248:     )\n249: \n250:     # ── Separar correctos vs. a corregir ──\n251:     # Equivale a:\n252:     #   geo_correctos <- filter(ID.temp %in% correctos)\n253:     #   geo.corregir.master <- filter(!(ID.temp %in% correctos))\n254:     # Partimos de `gdf_puntos` (NO de `resultado_sjoin`, que puede tener filas\n255:     # duplicadas por bordes compartidos) y filtramos usando los ID_temp.\n256:     mascara_correctos = gdf_puntos[\"ID_temp\"].isin(ids_correctos)\n257:     geo_correctos = gdf_puntos[mascara_correctos].copy()    # Los que SÍ cayeron en su cantón.\n258:     geo_corregir = gdf_puntos[~mascara_correctos].copy()    # \"~\" = los que NO cayeron.\n259: \n260:     # Convertir de GeoDataFrame a DataFrame plano (ya no necesitamos geometría\n261:     # para los correctos; la geometría de 'a corregir' se reconstruirá)\n262:     # .drop(columns=\"geometry\") → quita la columna de puntos espaciales.\n263:     # pd.DataFrame(...) → asegura que el tipo sea un DataFrame normal de pandas\n264:     #                     (necesario para guardarlo después en Parquet estándar).\n265:     geo_correctos_df = pd.DataFrame(geo_correctos.drop(columns=\"geometry\")) #elimino la columna geometry\n266:     geo_corregir_df = pd.DataFrame(geo_corregir.drop(columns=\"geometry\"))\n267: \n268:     n_correctos = len(geo_correctos_df)\n269:     n_corregir = len(geo_corregir_df)\n270: \n271:     # Calculamos el porcentaje (evitando dividir para 0 si la tabla viniera vacía).\n272:     pct_correctos = (n_correctos / n_total * 100) if n_total > 0 else 0\n273: \n274:     # Equivale a: print(paste0(\"Calidad de data inicial perfecta: \", ...))\n275:     print(f\"        Total puntos evaluados: {n_total:,}\")\n276:     print(f\"        Correctos (dentro de su cantón): {n_correctos:,} \"\n277:           f\"({pct_correctos:.2f}%)\")\n278:     print(f\"        A corregir (fuera de su cantón): {n_corregir:,} \"\n279:           f\"({100 - pct_correctos:.2f}%)\")\n280: \n281:     return geo_correctos_df, geo_corregir_df\n282: \n283: \n284: # =========================================================================\n285: # PASO 4.5 — Separación por formato (diagnóstico de limbo)\n286: # =========================================================================\n287: def separar_por_formato(\n288:     geo_corregir: pd.DataFrame,\n289: ) -> tuple[pd.DataFrame, pd.DataFrame]:\n290:     # La \"r\" antes de \"\"\" hace que este docstring sea un \"raw string\" (texto crudo),\n291:     # así Python no se queja por el \"\\.\" que aparece escrito en la documentación.\n292:     r\"\"\"\n293:     Separa registros a corregir según si su latitud tiene punto decimal o no.\n294: \n295:     Equivalencia R (líneas 309-313):\n296:         limbo_formato_correcto <- geo.corregir.master %>%\n297:             filter(grepl(\"[.]\", as.character(lat.new)))\n298:         geo.corregir.1 <- geo.corregir.master %>%\n299:             filter(!grepl(\"[.]\", as.character(lat.new)))\n300: \n301:     Mapeo R → Python:\n302:         grepl(\"[.]\", x)  equiv  x.str.contains(r'\\.', regex=True)\n303: \n304:     Parameters\n305:     ----------\n306:     geo_corregir : pd.DataFrame\n307:         Registros cuyas coordenadas no coinciden con su cantón reportado.\n308: \n309:     Returns\n310:     -------\n311:     tuple[pd.DataFrame, pd.DataFrame]\n312:         - limbo_formato_correcto: Tienen punto decimal (coordenada formateada\n313:           pero fuera de su cantón, posiblemente por error de límites).\n314:         - geo_corregir_decimales: SIN punto decimal (coordenada corrupta\n315:           que requiere reparación del algoritmo decimal).\n316:     \"\"\"\n317:     print(\"  [4.5] Separación por formato de coordenadas\")\n318: \n319:     # Caso borde: si no hay ningún registro que corregir, devolvemos dos tablas vacías.\n320:     if len(geo_corregir) == 0:\n321:         print(\"        No hay registros a corregir.\")\n322:         return pd.DataFrame(), pd.DataFrame()\n323: \n324:     # Inspeccionar si la cadena de latitud original tiene punto decimal\n325:     # Equivale a: grepl(\"\\\\.\", as.character(lat.new))\n326:     #\n327:     # Desglose:\n328:     #   geo_corregir[\"latitud_original\"] → el texto TAL CUAL venía en el CSV\n329:     #                                      (lo guardamos en el Paso 4.3).\n330:     #   .str.contains(...) → revisa cada texto y devuelve True si contiene el patrón.\n331:     #   r\"\\.\"              → en regex un \".\" solo significa \"cualquier carácter\".\n332:     #                        Con la barra delante \"\\.\" significa un PUNTO literal.\n333:     #   regex=True         → interpreta el patrón como expresión regular.\n334:     #   na=False           → si alguna celda fuera nula, la trata como False (sin punto).\n335:     tiene_punto = geo_corregir[\"latitud_original\"].str.contains(\n336:         r\"\\.\", regex=True, na=False\n337:     ) # busco si contiene el .\n338: \n339:     # Con punto decimal → \"limbo\": la coordenada está bien escrita (ej. -2.1894),\n340:     # así que NO debemos tocarle los dígitos; se conserva tal cual.\n341:     limbo_formato_correcto = geo_corregir[tiene_punto].copy()\n342:     # Sin punto decimal → coordenada corrupta (ej. \"21894\"), pasa al reparador.\n343:     geo_corregir_decimales = geo_corregir[~tiene_punto].copy()\n344: \n345:     print(f\"        Con punto decimal (limbo): {len(limbo_formato_correcto):,}\")\n346:     print(f\"        Sin punto decimal (reparar): {len(geo_corregir_decimales):,}\")\n347: \n348:     return limbo_formato_correcto, geo_corregir_decimales #entonces detecto em pocas palabras si contiene . o ,."}
{"step_index":501,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-10T22:03:08Z","input_tokens":9678,"cache_read_tokens":169697,"output_tokens":5697,"thinking":"I'm thinking through how to approach this.\n\n\nJurisdictional corrections for 32 cases are authorized based on the `Point-in-Polygon` method. Initial concern about a 1km tolerance for non-delimited zones is raised, lacking a clear justification for this deviation. Confirmed that 12 cases are too distant and 18 cases are also very far from the zone.\n\n\nAnalyzing the remaining 10 cases within the former Zonas No Delimitadas, where one typed entry needs to be transformed. Considering the user's explicit instruction to exclude the 1km tolerance, the 30 maritime and terrestrial border cases are designated as anomalous and will be flagged, requiring confirmation on their handling within the anomalous category. The intention is to identify these 30 cases by their category.\n\nThe analysis confirms that the user explicitly excludes the 1km tolerance, classifying any cases outside the polygon as anomalous. Correct 32 cases (22 `provincia == canton` and 10 former `Zonas No Delimitadas`) using the `Point-in-Polygon` method. The remaining 30 cases (18 maritime/coastal and 12 terrestrial border) are flagged as anomalous and kept aside. Now, examining how the `corregir_jurisdiccion_por_ubicacion` function, and its dependencies, must work to manage these cases, ensuring correct implementation of the correction logic.\n\n\nThe `corregir_jurisdiccion_por_ubicacion` function's behavior depends on the presence of specified columns in the input DataFrames. It appears to implement geospatial disambiguation based on the user's explicit rules, specifically focusing on `Point-in-Polygon` operations. The first rule addresses cases where \"provincia\" and \"canton\" are identical but the point falls within a different canton of the same province. This is implemented via a spatial join.\n\n\nThe `canton = CANTON_MAPA` logic is intended to leave valid records like \"LOJA - LOJA\" untouched because the conditions match. The goal is to automatically and accurately correct the 22 cases where the province name was erroneously repeated by the data entry personnel, mapping them to the geographically correct canton based on their GPS coordinates, which is then printed to console. This logic applies to the second rule that focuses on jurisdiction correction for polygons of former Undelimited Zones (`Código DPA 90`).\n\n\nCorrected the `provincia` and `canton` for the ten remaining cases within former Undelimited Zones, printing the changes. Examined how the algorithm handles points outside their reported canton, noting that 31 such points are identified. One point with an invalid format is discarded, and the remaining 30 with valid format are categorized as anomalies.\n\n\nCategorizing the 30 anomalous cases, ensuring strict `Point-in-Polygon` logic without buffer zones. The cases are divided into two categories, Maritime/Estuarine/Fluvial and Intercantonal Land Borders, with a detailed breakdown of each category and its specific occurrences. This precise categorization confirms that the applied spatial predicate is accurate, and no buffer was used. The 22 province-canton repetition cases are intended to be corrected via a spatial join.\n\n\nAll 32 corrected cases were processed via `Point-in-Polygon` as intended, with the breakdown of the 30 anomalous cases, categorized as maritime/terrestrial borders, remaining intact as per the defined workflow and printed in console. The initial numbers have been verified: 38,535 cases were corrected in the first audit (`99.92%`), 30 anomalous cases retained (`0.08%`), and one coordinate discarded, resulting in 38,565 georeferenced records. Confirmed that the final dataset represents 23 unique provinces and 210 official cantons.\n\n\n","tool_calls":[{"name":"edit_file","args":{"Path":"D:\\Tesis\\src\\validacion_geo\\geometrias.py","Replacement":"# =========================================================================\n# PASO 4.3b — Corrección espacial objetiva por Point-in-Polygon (Pre-Auditoría)\n# =========================================================================\ndef corregir_jurisdiccion_por_ubicacion(\n    gdf_puntos: gpd.GeoDataFrame,\n    mapa: gpd.GeoDataFrame,\n) -> gpd.GeoDataFrame:\n    \"\"\"\n    Aplica dos reglas deterministas de corrección jurisdiccional basadas en\n    intersección espacial exacta (`Point-in-Polygon`, predicado `intersects`)\n    antes de ejecutar la auditoría topológica definitiva, e imprime en consola\n    el detalle íntegro de los registros corregidos:\n\n    1. **Regla 1 — Desambiguación espacial cuando `canton == provincia` (22 casos):**\n       En ciertos partes policiales (principalmente de 2024) el digitador repitió\n       el nombre de la provincia dentro de la columna `canton` (ej. `GUAYAS - GUAYAS`,\n       `EL ORO - EL ORO`, `MANABI - MANABI`, `PICHINCHA - PICHINCHA`, `ORELLANA - ORELLANA`).\n       Cuando el punto GPS cae físicamente dentro de un polígono de esa misma provincia\n       cuyo nombre oficial (`CANTON_MAPA`) es distinto al nombre repetido, se asigna\n       el `CANTON_MAPA` donde se ubica el punto (`GUAYAQUIL`, `DURAN`, `NARANJAL`,\n       `EL GUABO`, `SANTA ROSA`, `PASAJE`, `MANTA`, `QUITO`, `LA JOYA DE LOS SACHAS`).\n       *(Si el cantón homónimo sí existe y el punto cae dentro de él, como en\n       `LOJA - LOJA` o `ESMERALDAS - ESMERALDAS`, `CANTON_MAPA == canton` y no se altera).*\n\n    2. **Regla 2 — Corrección de jurisdicción dentro de polígonos de ex Zonas No\n       Delimitadas (`Código DPA 90`: `9001`, `9003`, `9004`) (10 casos):**\n       Para los puntos que caen físicamente en el interior de los 3 polígonos de las\n       antiguas Zonas No Delimitadas pero que fueron digitados con la capital provincial\n       o cabecera zonal lejana (9 casos en `LAS GOLONDRINAS / COTACACHI` digitados como\n       `IBARRA` a ~97 km de distancia, y 1 caso en `EL PIEDRERO / LA TRONCAL` digitado\n       como `GUAYAS - GUAYAQUIL` a ~50.8 km de distancia), se asigna la jurisdicción\n       legal del polígono (`DPA_DESPRO`, `CANTON_MAPA`).\n\n    Parameters\n    ----------\n    gdf_puntos : gpd.GeoDataFrame\n        GeoDataFrame de puntos con columnas `'provincia'`, `'canton'` e `'ID_temp'`.\n    mapa : gpd.GeoDataFrame\n        GeoDataFrame del mapa cantonal con `'DPA_DESPRO'`, `'CANTON_MAPA'` y `'geometry'`.\n\n    Returns\n    -------\n    gpd.GeoDataFrame\n        GeoDataFrame con `'provincia'` y `'canton'` corregidos en los casos objetivos.\n    \"\"\"\n    # Si se trata de un DataFrame sintético de test que no incluye columna 'provincia'\n    # o un mapa de prueba sin 'DPA_DESPRO', devolvemos los puntos sin modificar.\n    if \"provincia\" not in gdf_puntos.columns or \"DPA_DESPRO\" not in mapa.columns:\n        return gdf_puntos\n\n    gdf = gdf_puntos.copy()\n\n    # Columnas disponibles en el mapa para el cruce espacial.\n    cols_mapa = [\"DPA_DESPRO\", \"CANTON_MAPA\", \"geometry\"]\n    if \"DPA_CANTON\" in mapa.columns:\n        cols_mapa.insert(0, \"DPA_CANTON\")\n\n    # Ejecutamos un `sjoin` interno para conocer en qué polígono cae cada punto.\n    # `.drop_duplicates(subset=[\"ID_temp\"])` garantiza relación 1 a 1 por cada punto.\n    cruce = gpd.sjoin(\n        gdf[[\"ID_temp\", \"provincia\", \"canton\", \"geometry\"]],\n        mapa[cols_mapa],\n        how=\"inner\",\n        predicate=\"intersects\",\n    ).drop_duplicates(subset=[\"ID_temp\"])\n\n    # Indexamos por `ID_temp` para consultar rápidamente qué polígono corresponde a cada fila.\n    cruce_idx = cruce.set_index(\"ID_temp\")\n\n    # ── REGLA 1: Registros con `canton == provincia` que caen en otro cantón de su provincia ──\n    ids_en_cruce = gdf[\"ID_temp\"].isin(cruce_idx.index)\n    gdf_cruce = gdf[ids_en_cruce].copy()\n    prov_mapa_serie = gdf_cruce[\"ID_temp\"].map(cruce_idx[\"DPA_DESPRO\"])\n    canton_mapa_serie = gdf_cruce[\"ID_temp\"].map(cruce_idx[\"CANTON_MAPA\"])\n\n    mascara_regla1 = (\n        (gdf_cruce[\"canton\"] == gdf_cruce[\"provincia\"])\n        & (gdf_cruce[\"provincia\"] == prov_mapa_serie)\n        & (gdf_cruce[\"canton\"] != canton_mapa_serie)\n    )\n    ids_regla1 = set(gdf_cruce.loc[mascara_regla1, \"ID_temp\"])\n\n    if ids_regla1:\n        print(\"        \" + \"-\" * 86)\n        print(\n            f\"        [4.3b-1] CORRECCIÓN POINT-IN-POLYGON POR CANTÓN == PROVINCIA ({len(ids_regla1)} casos):\"\n        )\n        print(\n            f\"        {'Caso':<10} | {'Año':<4} | {'Provincia':<10} | \"\n            f\"{'Cantón erróneo → Cantón polígono GPS':<38} | {'Coordenadas (lat, lon)'}\"\n        )\n        print(\"        \" + \"-\" * 86)\n        for idx in gdf.index[gdf[\"ID_temp\"].isin(ids_regla1)]:\n            id_t = int(gdf.loc[idx, \"ID_temp\"])\n            nuevo_canton = str(cruce_idx.loc[id_t, \"CANTON_MAPA\"])\n            caso = str(gdf.loc[idx, \"codigo_caso\"]) if \"codigo_caso\" in gdf.columns else str(id_t)\n            anio = str(gdf.loc[idx, \"anio_hecho\"]) if \"anio_hecho\" in gdf.columns else \"N/A\"\n            prov = str(gdf.loc[idx, \"provincia\"])\n            ant_canton = str(gdf.loc[idx, \"canton\"])\n            coords = f\"({gdf.loc[idx, 'lat_num']:.5f}, {gdf.loc[idx, 'lon_num']:.5f})\"\n            trans = f\"{ant_canton} -> {nuevo_canton}\"\n            print(f\"        {caso:<10} | {anio:<4} | {prov:<10} | {trans:<38} | {coords}\")\n            # Actualizamos el cantón al polígono donde cayó físicamente el punto.\n            gdf.loc[idx, \"canton\"] = nuevo_canton\n\n    # ── REGLA 2: Registros dentro de polígonos ex-Zonas No Delimitadas (Código DPA 90) ──\n    if \"DPA_CANTON\" in cruce_idx.columns:\n        cod_dpa_serie = gdf_cruce[\"ID_temp\"].map(cruce_idx[\"DPA_CANTON\"].astype(str))\n        # Polígonos 9001 (Las Golondrinas), 9003 (Manga del Cura) y 9004 (El Piedrero).\n        mascara_regla2 = (\n            cod_dpa_serie.isin([\"9001\", \"9003\", \"9004\"])\n            & (\n                (gdf_cruce[\"canton\"] != canton_mapa_serie)\n                | (gdf_cruce[\"provincia\"] != prov_mapa_serie)\n            )\n        )\n        ids_regla2 = set(gdf_cruce.loc[mascara_regla2, \"ID_temp\"])\n\n        if ids_regla2:\n            print(\"        \" + \"-\" * 86)\n            print(\n                f\"        [4.3b-2] CORRECCIÓN JURISDICCIONAL EN POLÍGONOS EX-ZND ({len(ids_regla2)} casos):\"\n            )\n            print(\n                f\"        {'Caso':<10} | {'Año':<4} | {'Polígono ZND':<10} | \"\n                f\"{'Antes (Prov - Cantón) → Después (Legal)':<42} | {'Coordenadas'}\"\n            )\n            print(\"        \" + \"-\" * 86)\n            for idx in gdf.index[gdf[\"ID_temp\"].isin(ids_regla2)]:\n                id_t = int(gdf.loc[idx, \"ID_temp\"])\n                nueva_prov = str(cruce_idx.loc[id_t, \"DPA_DESPRO\"])\n                nuevo_canton = str(cruce_idx.loc[id_t, \"CANTON_MAPA\"])\n                cod_znd = str(cruce_idx.loc[id_t, \"DPA_CANTON\"])\n                caso = str(gdf.loc[idx, \"codigo_caso\"]) if \"codigo_caso\" in gdf.columns else str(id_t)\n                anio = str(gdf.loc[idx, \"anio_hecho\"]) if \"anio_hecho\" in gdf.columns else \"N/A\"\n                ant_prov = str(gdf.loc[idx, \"provincia\"])\n                ant_canton = str(gdf.loc[idx, \"canton\"])\n                coords = f\"({gdf.loc[idx, 'lat_num']:.5f}, {gdf.loc[idx, 'lon_num']:.5f})\"\n                trans = f\"{ant_prov}/{ant_canton} -> {nueva_prov}/{nuevo_canton}\"\n                print(f\"        {caso:<10} | {anio:<4} | {cod_znd:<10} | {trans:<42} | {coords}\")\n                gdf.loc[idx, \"provincia\"] = nueva_prov\n                gdf.loc[idx, \"canton\"] = nuevo_canton\n            print(\"        \" + \"-\" * 86)\n\n    return gdf\n\n\n# =========================================================================\n# PASO 4.4 — Primera Auditoría Topológica (sjoin vectorizado)\n# =========================================================================","Target":"# =========================================================================\n# PASO 4.4 — Primera Auditoría Topológica (sjoin vectorizado)\n# ========================================================================="}}]}
