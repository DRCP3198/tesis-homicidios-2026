ords\n354:             lat_str=\"21894\",\n355:             lon_str=\"-79.8891\",\n356:             lat_num=-2.1894,\n357:             lon_num=-79.8891,\n358:         )\n359:         df_prueba[\"limpia_lat\"] = _limpiar_cadena_lat(pd.Series\n<truncated 1043 bytes>\n     {\n380:                 \"canton\": \"GUAYAQUIL\", \"latitud_original\": \"21894\",\n381:                 \"longitud_original\": \"-79.8891\", \"lat_num\": -2.1894,\n382:                 \"lon_num\": -79.8891, \"ID_temp\": 1,\n383:             },\n384:             {\n385:                 \"canton\": \"CUENCA\", \"latitud_original\": \"28970\",\n386:                 \"longitud_original\": \"-79.0045\", \"lat_num\": -2.8970,\n387:                 \"lon_num\": -79.0045, \"ID_temp\": 2,\n388:             },\n389:             # Escenario 4: negativo ecuatorial\n390:             {\n391:                 \"canton\": \"QUITO\", \"latitud_original\": \"1807\",\n392:                 \"longitud_original\": \"-78.4678\", \"lat_num\": -0.1807,\n393:                 \"lon_num\": -78.4678, \"ID_temp\": 3,\n394:             },\n395:         ]\n396:         df = pd.DataFrame(rows)\n397:         # Agregar campos textuales mínimos\n398:         for col in [\"codigo_caso\", \"tipo_delito\", \"provincia\"]:\n399:             df[col] = \"TEST\"\n400:         df[\"limpia_lat\"] = _limpiar_cadena_lat(df[\"latitud_original\"])\n401:         return df\n402: \n403:     def test_rescata_registros_corruptos(self, mapa_cantonal):\n404:         \"\"\"Verifica que el orquestador rescata al menos un registro corrupto.\"\"\"\n405:         df_corruptos = self._make_pool_corruptos()\n406:         esc1, esc2, esc3, esc4, no_rep = reparar_coordenadas_corruptas(\n407:             df_corruptos, mapa_cantonal\n408:         )\n409:         total_rescatados = sum(len(d) for d in [esc1, esc2, esc3, esc4])\n410:         assert total_rescatados > 0, (\n411:             \"El algoritmo no rescató ningún registro corrupto.\"\n412:         )\n413: \n414:     def test_escenario3_domina_sur(self, mapa_cantonal):\n415:         \"\"\"Verifica que el Escenario 3 rescata registros del hemisferio sur.\"\"\"\n416:         df_corruptos = self._make_pool_corruptos()\n417:         esc1, esc2, esc3, esc4, no_rep = reparar_coordenadas_corruptas(\n418:             df_corruptos, mapa_cantonal\n419:         )\n420:         # Guayaquil y Cuenca son del Hemisferio Sur → deben estar en esc3","truncated_fields":["content"]}
