lizar_texto(\"ÁÉÍÓÚ\") == \"AEIOU\"\n38: \n39:     def test_elimina_ene(self):\n40:         \"\"\"Verifica que la eñe se convierta a N.\"\"\"\n41:         assert normalizar_texto(\"Ñuño\") == \"NUNO\"\n42:         \n<truncated 9461 bytes>\ndf_simulado.shape\n212: \n213:     def test_error_columna_faltante(self):\n214:         \"\"\"Verifica que lance KeyError si falta una columna de texto.\"\"\"\n215:         df_incompleto = pd.DataFrame({\"codigo_caso\": [\"ABC\"]})\n216:         # `with pytest.raises(TipoDeError, match=\"texto\"):` → esta prueba PASA\n217:         # solo si el código de adentro efectivamente lanza ese error y su mensaje\n218:         # contiene \"Columnas de texto no encontradas\". Si NO lanzara error, fallaría.\n219:         with pytest.raises(KeyError, match=\"Columnas de texto no encontradas\"):\n220:             normalizar_todas_columnas(df_incompleto)\n221: \n222: \n223: # =========================================================================\n224: # TESTS DE AUDITORÍA: auditar_caracteres_especiales()\n225: # =========================================================================\n226: class TestAuditoriaCaracteres:\n227:     \"\"\"Tests de la función de auditoría de caracteres especiales.\"\"\"\n228: \n229:     def test_datos_sucios_detectados(self):\n230:         \"\"\"Verifica que se detecten tildes en datos NO normalizados.\"\"\"\n231:         df = pd.DataFrame({\n232:             \"canton\": [\"Guayaquíl\", \"Quito\", \"Cuenca\"],\n233:             \"provincia\": [\"GUAYAS\", \"PICHINCHA\", \"AZUAY\"],\n234:         })\n235:         reporte = auditar_caracteres_especiales(\n236:             df, columnas=[\"canton\", \"provincia\"]\n237:         )\n238:         # Accedemos a los atributos del objeto `ReporteAuditoria` con punto \".\"\n239:         assert not reporte.limpio\n240:         assert reporte.columnas_con_problemas == 1\n241:         assert reporte.hallazgos[0].columna == \"canton\"\n242: \n243:     def test_datos_limpios_ok(self):\n244:         \"\"\"Verifica que datos ya normalizados pasen la auditoría.\"\"\"\n245:         df = pd.DataFrame({\n246:             \"canton\": [\"GUAYAQUIL\", \"QUITO\", \"CUENCA\"],\n247:             \"provincia\": [\"GUAYAS\", \"PICHINCHA\", \"AZUAY\"],\n248:         })\n249:         reporte = auditar_caracteres_especiales(\n250:             df, columnas=[\"canton\", \"provincia\"]","truncated_fields":["content"]}
