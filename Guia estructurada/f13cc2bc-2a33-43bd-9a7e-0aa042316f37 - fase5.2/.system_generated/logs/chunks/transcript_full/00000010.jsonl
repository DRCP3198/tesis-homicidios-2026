{"step_index":261,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T00:54:07Z","content":"Created At: 2026-11-09T19:54:07-05:00\nCompleted At: 2026-11-09T19:54:07-05:00\nShowing lines 50-193 of 193\n50: # ── Imports Fase 4: Validación Geoespacial ──\n51: # Importa los módulos del pipeline geoespacial completo:\n52: # cartografía, creación de puntos, auditoría topológica,\n53: # algoritmo reparador (4 escenarios) y ensamblaje final.\n54: from src.validacion_geo.cartografia import cargar_mapa_cantonal\n55: from src.validacion_geo.ensamblaje import (\n56:     ensamblar_base_final,\n57:     guardar_artefactos_geo,\n58:     imprimir_reporte_geo,\n59: )\n60: from src.validacion_geo.geometrias import (\n61:     auditar_punto_en_poligono,\n62:     crear_geodataframe_puntos,\n63:     separar_por_formato,\n64: )\n65: from src.validacion_geo.reparacion import reparar_coordenadas_corruptas\n66: \n67: #pipeline = proceso general que coordina las etapas de preprocesamiento.\n68: #ingesta = módulo encargado de cargar los datos originales.\n69: \n70: \n71: def main():\n72:     \"\"\"Función principal encargada de ejecutar el pipeline de preprocesamiento.\"\"\"\n73: \n74:     # ── FASE 1: Ingesta y Renombrado ──\n75:     # Carga los datos originales de homicidios y guarda\n76:     # una versión intermedia con las columnas renombradas.\n77:     df = cargar_homicidios_raw()         # Lee el CSV crudo y renombra las 21 columnas.\n78:     guardar_intermedio_renombrado(df)    # Guarda data/interim/homi_renombrado.parquet.\n79: \n80:     # ── FASE 2: Limpieza y Normalización Textual ──\n81:     # Aplica strip() + upper() + unidecode() a las 13 columnas de texto.\n82:     # Equivale al bloque mutate() con iconv() + str_trim() + str_to_upper() del R.\n83:     df = normalizar_todas_columnas(df)   # MAYÚSCULAS + sin tildes/eñes + sin espacios extra.\n84:     auditar_caracteres_especiales(df)    # Verifica con regex que no haya quedado ni una tilde.\n85:     guardar_intermedio_normalizado(df)   # Guarda data/interim/homi_normalizado.parquet.\n86: \n87:     # ── FASE 3: Filtrado temporal y geográfico ──\n88:     # Aplica los filtros de año (<=2024) y excluye cantones insulares.\n89:     # Equivale al bloque filter() del R (líneas 132-150).\n90:     print(\"=\" * 60)\n91:     print(\"  FASE 3: FILTRADO TEMPORAL Y GEOGRÁFICO\")\n92:     print(\"=\" * 60)\n93: \n94:     # Guardamos una \"foto\" (.copy()) de la tabla antes de cada paso, para que\n95:     # al final `imprimir_conteos` pueda comparar cuántos registros había en cada etapa.\n96:     df_entrada_fase3 = df.copy()\n97: \n98:     # Paso 3.1: Conversión de anio_hecho a entero\n99:     df = convertir_anio_a_entero(df)\n100:     df_post_conversion = df.copy()\n101: \n102:     # Paso 3.2: Filtro temporal (anio_hecho <= 2024)\n103:     df = filtrar_anio(df)\n104:     df_post_filtro_anio = df.copy()\n105: \n106:     # Pasos 3.3 y 3.4: Exclusión de Galápagos + separación insular\n107:     # `excluir_galapagos` devuelve 2 tablas a la vez; las recibimos separadas por coma.\n108:     df_continental, df_insular = excluir_galapagos(df)\n109:     guardar_insular(df_insular)  # Guarda los insulares aparte para no perder trazabilidad.\n110: \n111:     # Paso 3.5: Reporte de conteos (auditoría de integridad)\n112:     # Comprueba que: originales == eliminados + insulares + continentales.\n113:     imprimir_conteos(\n114:         df_original=df_entrada_fase3,\n115:         df_post_conversion=df_post_conversion,\n116:         df_post_filtro_anio=df_post_filtro_anio,\n117:         df_continental=df_continental,\n118:         df_insular=df_insular,\n119:     )\n120: \n121:     # Paso 3.6: Guardar intermedio continental filtrado\n122:     guardar_intermedio_filtrado(df_continental)  # data/interim/homi_filtrado_2024.parquet\n123: \n124:     # ── FASE 4: Validación Geoespacial Completa ──\n125:     # Corresponde a las Fases R 5-9 (líneas 206-484).\n126:     print(\"=\" * 60)\n127:     print(\"  FASE 4: VALIDACIÓN GEOESPACIAL COMPLETA\")\n128:     print(\"=\" * 60)\n129: \n130:     # Pasos 4.1–4.2: Carga y homologación del mapa cantonal\n131:     # Abre nxcantones.shp, pasa a WGS84, repara polígonos y quita Galápagos.\n132:     mapa = cargar_mapa_cantonal()\n133: \n134:     # Paso 4.3: Crear GeoDataFrame de puntos desde coordenadas\n135:     # Convierte latitud/longitud en objetos geométricos Point y asigna ID_temp.\n136:     gdf_puntos = crear_geodataframe_puntos(df_continental)\n137:     n_entrada_fase4 = len(gdf_puntos)  # Total de puntos que entraron a validarse.\n138: \n139:     # Paso 4.4: Primera auditoría topológica (sjoin vectorizado)\n140:     # Separa los que caen DENTRO de su cantón (geo_correctos) vs. FUERA (geo_corregir).\n141:     geo_correctos, geo_corregir = auditar_punto_en_poligono(gdf_puntos, mapa)\n142: \n143:     # Paso 4.5: Separar por formato decimal\n144:     # De los que cayeron fuera: ¿tienen punto decimal (limbo) o les falta (a reparar)?\n145:     limbo_formato_correcto, geo_corregir_decimales = separar_por_formato(\n146:         geo_corregir\n147:     )\n148: \n149:     # Paso 4.6: Algoritmo reparador de coordenadas corruptas (4 escenarios)\n150:     # Prueba en orden: X.XXX → 0.XXX → -X.XXX → -0.XXX y valida cada intento con sjoin.\n151:     esc1, esc2, esc3, esc4, no_reparados = reparar_coordenadas_corruptas(\n152:         geo_corregir_decimales, mapa\n153:     )\n154:     # Suma total de casos rescatados entre los 4 escenarios.\n155:     n_reparados_total = sum(len(d) for d in [esc1, esc2, esc3, esc4])\n156: \n157:     # Paso 4.7: Ensamblaje y limpieza final\n158:     # Une correctos + reparados + limbo, borra columnas auxiliares y filtra NaN.\n159:     df_georreferenciado = ensamblar_base_final(\n160:         geo_correctos=geo_correctos,\n161:         reparados_esc1=esc1,\n162:         reparados_esc2=esc2,\n163:         reparados_esc3=esc3,\n164:         reparados_esc4=esc4,\n165:         limbo_formato_correcto=limbo_formato_correcto,\n166:         no_reparados=no_reparados,\n167:     )\n168: \n169:     # Paso 4.8: Exportar artefactos Parquet\n170:     # Guarda geo_correctos.parquet (interim) y homi_georreferenciado.parquet (processed).\n171:     guardar_artefactos_geo(geo_correctos, df_georreferenciado)\n172: \n173:     # Reporte estadístico de la Fase 4\n174:     imprimir_reporte_geo(\n175:         n_procesados=n_entrada_fase4,\n176:         n_correctos=len(geo_correctos),\n177:         n_reparados_total=n_reparados_total,\n178:         n_limbo=len(limbo_formato_correcto),\n179:         n_no_reparados=len(no_reparados),\n180:         n_final=len(df_georreferenciado),\n181:     )\n182: \n183:     # ── FASE 5: Etiquetado y exportación final ──\n184:     # TODO: Sesión 7\n185: \n186:     print(\"\\n[OK] Pipeline Fases 1-4 completado exitosamente.\")\n187: \n188: \n189: # Punto de entrada del programa:\n190: # Cuando ejecutas `python main.py` en la terminal, Python pone \"__main__\" en\n191: # la variable especial `__name__` y entra aquí llamando a main().\n192: if __name__ == \"__main__\":\n193:     main()"}
