{"step_index":95,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-06T15:58:36Z","content":"Created At: 2026-11-06T10:58:36-05:00\nCompleted At: 2026-11-06T10:58:37-05:00\nShowing lines 1-107 of 107\n1: \"\"\"\r\n2: main.py — Orquestador del pipeline de preprocesamiento.\r\n3: \r\n4: Ejecuta todas las fases en secuencia. Cada fase se activa\r\n5: progresivamente a medida que se implementan los módulos.\r\n6: \r\n7: Uso:\r\n8:     python main.py\r\n9: \"\"\"\r\n10: \r\n11: # ── Imports Fase 1: Ingesta ──\r\n12: # Importa las funciones encargadas de cargar los datos originales\r\n13: # de homicidios y guardar una copia intermedia con los nombres de\r\n14: # las columnas estandarizados.\r\n15: from src.ingesta.cargar_datos import (\r\n16:     cargar_homicidios_raw,\r\n17:     guardar_intermedio_renombrado,\r\n18: )\r\n19: \r\n20: # ── Imports Fase 2: Limpieza textual ──\r\n21: # Importa las funciones de normalización de texto (strip + upper + unidecode)\r\n22: # y la auditoría de caracteres especiales (tildes, eñes, diéresis).\r\n23: from src.limpieza.normalizar_texto import (\r\n24:     normalizar_todas_columnas,\r\n25:     guardar_intermedio_normalizado,\r\n26: )\r\n27: from src.reportes.auditoria_caracteres import auditar_caracteres_especiales\r\n28: \r\n29: # ── Imports Fase 3: Filtrado temporal y geográfico ──\r\n30: # Importa las funciones de filtrado por año y exclusión de Galápagos,\r\n31: # así como el reporte de control que audita los conteos en cada paso.\r\n32: from src.limpieza.filtros import (\r\n33:     convertir_anio_a_entero,\r\n34:     filtrar_anio,\r\n35:     excluir_galapagos,\r\n36:     guardar_intermedio_filtrado,\r\n37:     guardar_insular,\r\n38: )\r\n39: from src.reportes.reporte_control import imprimir_conteos\r\n40: \r\n41: #pipeline = proceso general que coordina las etapas de preprocesamiento.\r\n42: #ingesta = módulo encargado de cargar los datos originales.\r\n43:    \r\n44: def main():\r\n45:     \"\"\"Función principal encargada de ejecutar el pipeline de preprocesamiento.\"\"\"\r\n46: \r\n47: \r\n48:     # ── FASE 1: Ingesta y Renombrado ──\r\n49:     # Carga los datos originales de homicidios y guarda\r\n50:     # una versión intermedia con las columnas renombradas.\r\n51:     df = cargar_homicidios_raw()\r\n52:     guardar_intermedio_renombrado(df)\r\n53: \r\n54:     # ── FASE 2: Limpieza y Normalización Textual ──\r\n55:     # Aplica strip() + upper() + unidecode() a las 13 columnas de texto.\r\n56:     # Equivale al bloque mutate() con iconv() + str_trim() + str_to_upper() del R.\r\n57:     df = normalizar_todas_columnas(df)\r\n58:     auditar_caracteres_especiales(df)\r\n59:     guardar_intermedio_normalizado(df)\r\n60: \r\n61:     # ── FASE 3: Filtrado temporal y geográfico ──\r\n62:     # Aplica los filtros de año (≤2024) y excluye cantones insulares.\r\n63:     # Equivale al bloque filter() del R (líneas 132-150).\r\n64:     print(\"=\" * 60)\r\n65:     print(\"  FASE 3: FILTRADO TEMPORAL Y GEOGRÁFICO\")\r\n66:     print(\"=\" * 60)\r\n67: \r\n68:     # Guardamos referencia al df original para el reporte de control\r\n69:     df_entrada_fase3 = df.copy()\r\n70: \r\n71:     # Paso 3.1: Conversión de anio_hecho a entero\r\n72:     df = convertir_anio_a_entero(df)\r\n73:     df_post_conversion = df.copy()\r\n74: \r\n75:     # Paso 3.2: Filtro temporal (anio_hecho <= 2024)\r\n76:     df = filtrar_anio(df)\r\n77:     df_post_filtro_anio = df.copy()\r\n78: \r\n79:     # Pasos 3.3 y 3.4: Exclusión de Galápagos + separación insular\r\n80:     df_continental, df_insular = excluir_galapagos(df)\r\n81: \r\n82:     # Paso 3.4: Guardar registros insulares para trazabilidad\r\n83:     guardar_insular(df_insular)\r\n84: \r\n85:     # Paso 3.5: Reporte de conteos (auditoría de integridad)\r\n86:     imprimir_conteos(\r\n87:         df_original=df_entrada_fase3,\r\n88:         df_post_conversion=df_post_conversion,\r\n89:         df_post_filtro_anio=df_post_filtro_anio,\r\n90:         df_continental=df_continental,\r\n91:         df_insular=df_insular,\r\n92:     )\r\n93: \r\n94:     # Paso 3.6: Guardar intermedio continental filtrado\r\n95:     guardar_intermedio_filtrado(df_continental)\r\n96: \r\n97:     # ── FASE 4: Validación geoespacial ──\r\n98:     # TODO: Sesiones 5-6\r\n99: \r\n100:     # ── FASE 5: Etiquetado y exportación final ──\r\n101:     # TODO: Sesión 7\r\n102: \r\n103:     print(\"\\n[OK] Pipeline Fases 1-3 completado exitosamente.\")\r\n104: \r\n105: \r\n106: if __name__ == \"__main__\":\r\n107:     main()\r"}
{"step_index":96,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-06T15:58:37Z","input_tokens":2042,"cache_read_tokens":140827,"output_tokens":1302,"tool_calls":[{"name":"edit_file","args":{"Path":"D:\\Tesis\\main.py","Replacement":"    # ── FASE 4: Validación Geoespacial Completa ──\n    # Corresponde a las Fases R 5-9 (líneas 206-484).\n    # Implementa la carga cartográfica, auditoría topológica sjoin,\n    # el algoritmo reparador de coordenadas decimales corruptas (4 escenarios)\n    # y el ensamblaje final de la base georreferenciada.\n    print(\"=\" * 60)\n    print(\"  FASE 4: VALIDACIÓN GEOESPACIAL COMPLETA\")\n    print(\"=\" * 60)\n\n    # Paso 4.1–4.2: Carga y homologación del mapa cantonal\n    # Equivale a: read_sf() + st_transform(crs=4326) + st_make_valid() + mutate(CANTON_MAPA)\n    mapa = cargar_mapa_cantonal()\n\n    # Paso 4.3: Crear GeoDataFrame de puntos desde coordenadas\n    # Equivale a: st_as_sf(coords=c(\"x\",\"y\"), crs=st_crs(Provincia))\n    gdf_puntos = crear_geodataframe_puntos(df_continental)\n    n_entrada_fase4 = len(gdf_puntos)\n\n    # Paso 4.4: Primera auditoría topológica (sjoin vectorizado)\n    # Reemplaza el bucle R for(j in 1:length(cantones)) con un único sjoin\n    geo_correctos, geo_corregir = auditar_punto_en_poligono(gdf_puntos, mapa)\n\n    # Paso 4.5: Separar por formato decimal\n    # Equivale a: filter(grepl(\"\\\\.\", lat.new)) vs. filter(!grepl(...))\n    limbo_formato_correcto, geo_corregir_decimales = separar_por_formato(geo_corregir)\n\n    # Paso 4.6: Algoritmo reparador de coordenadas corruptas (4 escenarios)\n    # Equivale a: Fase R 8 (líneas 300-457) — el for(i in 1:10)\n    esc1, esc2, esc3, esc4, no_reparados = reparar_coordenadas_corruptas(\n        geo_corregir_decimales, mapa\n    )\n    n_reparados_total = sum(len(d) for d in [esc1, esc2, esc3, esc4])\n\n    # Guardar geo_correctos como artefacto intermedio antes del ensamblaje\n    guardar_artefactos_geo(geo_correctos, geo_correctos)  # placeholder; real below\n\n    # Paso 4.7: Ensamblaje y limpieza final\n    # Equivale a: rbind(geo_correctos, reparados, limbo) + filter(!is.na(lat/lon))\n    df_georreferenciado = ensamblar_base_final(\n        geo_correctos=geo_correctos,\n        reparados_esc1=esc1,\n        reparados_esc2=esc2,\n        reparados_esc3=esc3,\n        reparados_esc4=esc4,\n        limbo_formato_correcto=limbo_formato_correcto,\n        no_reparados=no_reparados,\n    )\n\n    # Paso 4.8: Exportar artefactos Parquet\n    # Equivale a: saveRDS() + write.csv() del R Fase 10\n    guardar_artefactos_geo(geo_correctos, df_georreferenciado)\n\n    # Reporte estadístico de la Fase 4 (equivale a R Fase 11)\n    imprimir_reporte_geo(\n        n_procesados=n_entrada_fase4,\n        n_correctos=len(geo_correctos),\n        n_reparados_total=n_reparados_total,\n        n_limbo=len(limbo_formato_correcto),\n        n_no_reparados=len(no_reparados),\n        n_final=len(df_georreferenciado),\n    )\n\n    # ── FASE 5: Etiquetado y exportación final ──\n    # TODO: Sesión 7\n\n    print(\"\\n[OK] Pipeline Fases 1-4 completado exitosamente.\")","Target":"    # ── FASE 4: Validación geoespacial ──\n    # TODO: Sesiones 5-6\n\n    # ── FASE 5: Etiquetado y exportación final ──\n    # TODO: Sesión 7\n\n    print(\"\\n[OK] Pipeline Fases 1-3 completado exitosamente.\")"}}]}
