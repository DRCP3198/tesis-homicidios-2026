{"step_index":80,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-11-06T15:38:11Z","input_tokens":6236,"cache_read_tokens":115657,"output_tokens":3411,"tool_calls":[{"name":"invoke_subagent","args":{"Prompt":"Create the file `D:\\Tesis\\src\\validacion_geo\\ensamblaje.py` with the following complete content. Write this EXACTLY as provided:\n\n```python\n\"\"\"\nensamblaje.py — Ensamblaje final de la base georreferenciada.\n\nCorresponde a la Fase R 9 (líneas 460-484) del código original:\n    listo.corrcion.casos.posibles <- rbind(geo.corregir.1a, ..., geo.corregir.1g)\n    listo.corrcion.casos.posibles$lat.new <- as.numeric(lat.final)\n    listo.corrcion.casos.posibles <- select(-any_of(c(...)))\n    homi_Nueva <- rbind(geo_correctos, listo.corrcion.casos.posibles, limbo)\n    homi_Nueva <- filter(!is.na(lat.new) & !is.na(lon.new))\n\nFunciones principales:\n    - ensamblar_base_final(): Concatena todos los conjuntos y limpia (Paso 4.7)\n    - guardar_artefactos_geo(): Exporta Parquet (Paso 4.8)\n\"\"\"\nimport pandas as pd\n\nfrom src.ingesta.config import (\n    INTERIM_DIR,\n    INTERIM_GEO_CORRECTOS,  # data/interim/geo_correctos.parquet\n    PROCESSED_DIR,\n)\n\n\n# Columnas auxiliares creadas durante la validación geo que deben eliminarse\n_COLUMNAS_AUXILIARES = [\n    \"latitud_original\",\n    \"longitud_original\",\n    \"limpia_lat\",\n    \"lat_1\",\n    \"lat_2\",\n    \"lat_leng\",\n    \"lat_final\",\n    \"geometry\",          # Si quedó como columna tras drop de GeoDataFrame\n    \"index_right\",       # Creada por sjoin\n    \"CANTON_MAPA\",       # Creada por sjoin\n    \"_coincide\",         # Creada por auditoría\n    \"_PROV_NORM\",        # Creada por homologación\n]\n\n\n# =========================================================================\n# PASO 4.7 — Ensamblaje y limpieza final\n# =========================================================================\ndef ensamblar_base_final(\n    geo_correctos: pd.DataFrame,\n    reparados_esc1: pd.DataFrame,\n    reparados_esc2: pd.DataFrame,\n    reparados_esc3: pd.DataFrame,\n    reparados_esc4: pd.DataFrame,\n    limbo_formato_correcto: pd.DataFrame,\n    no_reparados: pd.DataFrame | None = None,\n) -> pd.DataFrame:\n    \"\"\"\n    Consolida todos los conjuntos de datos en una base georreferenciada final.\n\n    Equivalencia R (líneas 466-484):\n        listo.corrcion.casos.posibles <- rbind(geo.corregir.1a, geo.corregir.1b,\n                                                geo.corregir.1f, geo.corregir.1g)\n        listo.corrcion.casos.posibles$lat.new <- as.numeric(lat.final)\n        listo.corrcion.casos.posibles <- select(-any_of(c(\"limpia.lat\", ...)))\n        homi_Nueva <- rbind(geo_correctos, listo.corrcion.casos.posibles,\n                            limbo_formato_correcto)\n        homi_Nueva <- mutate(lat.new = as.numeric(lat.new), ...) %>%\n            filter(!is.na(lat.new) & !is.na(lon.new))\n\n    Mapeo R → Python:\n        rbind(a, b, c, ...)      →  pd.concat([a, b, c, ...])\n        select(-any_of(cols))    →  df.drop(columns=cols, errors='ignore')\n        filter(!is.na(lat/lon))  →  df.dropna(subset=['lat_num', 'lon_num'])\n\n    Parameters\n    ----------\n    geo_correctos : pd.DataFrame\n        Registros correctos de la primera auditoría (Paso 4.4).\n    reparados_esc1..4 : pd.DataFrame\n        Registros reparados por cada escenario del algoritmo (Paso 4.6).\n    limbo_formato_correcto : pd.DataFrame\n        Registros con punto decimal que cayeron fuera de su cantón (Paso 4.5).\n    no_reparados : pd.DataFrame or None\n        Registros que no se pudieron reparar (para reporte, no se incluyen).\n\n    Returns\n    -------\n    pd.DataFrame\n        Base consolidada y limpia, lista para exportación.\n    \"\"\"\n    print(\"  [4.7] Ensamblaje y limpieza final\")\n\n    # ── Concatenar todos los conjuntos (≡ rbind()) ──\n    partes = [\n        geo_correctos,\n        reparados_esc1,\n        reparados_esc2,\n        reparados_esc3,\n        reparados_esc4,\n        limbo_formato_correcto,\n    ]\n\n    # Filtrar DataFrames vacíos para evitar warnings de concat\n    partes_no_vacias = [p for p in partes if len(p) > 0]\n\n    if len(partes_no_vacias) == 0:\n        raise ValueError(\n            \"Todos los DataFrames de entrada están vacíos. \"\n            \"No hay registros para ensamblar.\"\n        )\n\n    df_ensamblado = pd.concat(partes_no_vacias, ignore_index=True)\n\n    print(f\"        Correctos iniciales:    {len(geo_correctos):,}\")\n    print(f\"        Reparados escenario 1:  {len(reparados_esc1):,}\")\n    print(f\"        Reparados escenario 2:  {len(reparados_esc2):,}\")\n    print(f\"        Reparados escenario 3:  {len(reparados_esc3):,}\")\n    print(f\"        Reparados escenario 4:  {len(reparados_esc4):,}\")\n    print(f\"        Limbo formato correcto: {len(limbo_formato_correcto):,}\")\n    if no_reparados is not None:\n        print(f\"        No reparados (excl.):   {len(no_reparados):,}\")\n    print(f\"        Total ensamblado:       {len(df_ensamblado):,}\")\n\n    # ── Limpiar columnas auxiliares ──\n    # Equivale a: select(-any_of(c(\"limpia.lat\", \"lat.1\", \"lat.leng\", ...)))\n    cols_a_eliminar = [c for c in _COLUMNAS_AUXILIARES if c in df_ensamblado.columns]\n    if cols_a_eliminar:\n        df_ensamblado = df_ensamblado.drop(columns=cols_a_eliminar)\n        print(f\"        Columnas auxiliares eliminadas: {cols_a_eliminar}\")\n\n    # ── Asegurar tipos numéricos en lat/lon ──\n    # Equivale a: mutate(lat.new = as.numeric(lat.new), lon.new = as.numeric(lon.new))\n    df_ensamblado[\"lat_num\"] = pd.to_numeric(\n        df_ensamblado[\"lat_num\"], errors=\"coerce\"\n    )\n    df_ensamblado[\"lon_num\"] = pd.to_numeric(\n        df_ensamblado[\"lon_num\"], errors=\"coerce\"\n    )\n\n    # ── Filtro de integridad final ──\n    # Equivale a: filter(!is.na(lat.new) & !is.na(lon.new))\n    n_antes = len(df_ensamblado)\n    df_ensamblado = df_ensamblado.dropna(subset=[\"lat_num\", \"lon_num\"])\n    n_despues = len(df_ensamblado)\n    n_eliminados = n_antes - n_despues\n\n    if n_eliminados > 0:\n        print(f\"        Eliminados por NaN lat/lon: {n_eliminados:,}\")\n\n    print(f\"        REGISTROS GEORREFERENCIADOS FINALES: {n_despues:,}\")\n\n    return df_ensamblado\n\n\n# =========================================================================\n# PASO 4.8 — Exportación de artefactos geoespaciales\n# =========================================================================\ndef guardar_artefactos_geo(\n    geo_correctos: pd.DataFrame,\n    df_final: pd.DataFrame,\n) -> None:\n    \"\"\"\n    Exporta los artefactos de la Fase 4 en formato Parquet.\n\n    Genera:\n      - data/interim/geo_correctos.parquet (registros correctos iniciales)\n      - data/processed/homi_georreferenciado.parquet (base final consolidada)\n\n    Parameters\n    ----------\n    geo_correctos : pd.DataFrame\n        Registros correctos de la primera auditoría.\n    df_final : pd.DataFrame\n        Base consolidada final post-ensamblaje.\n    \"\"\"\n    print(\"  [4.8] Exportación de artefactos geoespaciales\")\n\n    # ── geo_correctos.parquet ──\n    INTERIM_GEO_CORRECTOS.parent.mkdir(parents=True, exist_ok=True)\n    geo_correctos.to_parquet(INTERIM_GEO_CORRECTOS, index=False, engine=\"pyarrow\")\n    tamanio_kb = INTERIM_GEO_CORRECTOS.stat().st_size / 1024\n    print(f\"        Guardado: {INTERIM_GEO_CORRECTOS}\")\n    print(f\"        Tamaño: {tamanio_kb:.1f} KB ({len(geo_correctos):,} registros)\")\n\n    # ── homi_georreferenciado.parquet ──\n    ruta_final = PROCESSED_DIR / \"homi_georreferenciado.parquet\"\n    PROCESSED_DIR.mkdir(parents=True, exist_ok=True)\n    df_final.to_parquet(ruta_final, index=False, engine=\"pyarrow\")\n    tamanio_kb = ruta_final.stat().st_size / 1024\n    print(f\"        Guardado: {ruta_final}\")\n    print(f\"        Tamaño: {tamanio_kb:.1f} KB ({len(df_final):,} registros)\")\n\n\ndef imprimir_reporte_geo(\n    n_procesados: int,\n    n_correctos: int,\n    n_reparados_total: int,\n    n_limbo: int,\n    n_no_reparados: int,\n    n_final: int,\n) -> None:\n    \"\"\"\n    Imprime el reporte estadístico de la Fase 4 (equivale a Fase R 11).\n\n    Equivalencia R (líneas 510-519):\n        print(paste(\"-> Homicidios procesados:\", nrow(homi_2010_2024)))\n        print(paste(\"-> Total rescatados perfectos:\", nrow(geo_correctos)))\n        print(paste(\"-> Total rescatados por algoritmo:\", nrow(reparados)))\n        ...\n\n    Parameters\n    ----------\n    n_procesados : int\n        Total de registros que entraron a la Fase 4.\n    n_correctos : int\n        Registros correctos en la primera auditoría.\n    n_reparados_total : int\n        Total de registros reparados por el algoritmo.\n    n_limbo : int\n        Registros en limbo con formato correcto.\n    n_no_reparados : int\n        Registros que no pudieron ser reparados.\n    n_final : int\n        Total de registros georreferenciados finales.\n    \"\"\"\n    efectividad = (n_final / n_procesados * 100) if n_procesados > 0 else 0\n\n    print(\"=\" * 60)\n    print(\"  REPORTE DE VERIFICACIÓN — FASE 4: VALIDACIÓN GEO\")\n    print(\"=\" * 60)\n    print(f\"  Homicidios procesados (entrada):       {n_procesados:>8,}\")\n    print(f\"  Rescatados perfectos (1ra auditoría):  {n_correctos:>8,}\")\n    print(f\"  Rescatados por algoritmo de texto:     {n_reparados_total:>8,}\")\n    print(f\"  Limbo con coordenadas retenidos:       {n_limbo:>8,}\")\n    print(f\"  No reparados (excluidos):              {n_no_reparados:>8,}\")\n    print(f\"  {'─' * 50}\")\n    print(f\"  TOTAL GEORREFERENCIADOS:               {n_final:>8,}\")\n    print(f\"  Efectividad total: {efectividad:.2f}%\")\n    print(\"=\" * 60)\n```\n\nWrite this file now.","Role":"Ensamblaje Module Writer","TypeName":"geo_module_writer"}}]}
