{"step_index":453,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-11-10T16:03:37Z","content":"Created At: 2026-11-10T11:03:37-05:00\nCompleted At: 2026-11-10T11:03:37-05:00\nShowing lines 121-350 of 638\n121:         \"lat_num\": lat_num,\n122:         \"lon_num\": lon_num,\n123:         \"ID_temp\": 1,\n124:     }])\n125: \n126: \n127: # =========================================================================\n128: # TESTS UNITARIOS: Funciones de reconstrucción decimal (puras)\n129: # =========================================================================\n130: # Estas 4 clases prueban únicamente la manipulación del texto de la latitud\n131: # (no tocan el mapa), por eso corren en milisegundos.\n132: class TestReconstruccionEscenario1:\n133:     \"\"\"Tests del Escenario 1: X.XXXXXX (latitud positiva norte).\"\"\"\n134: \n135:     def test_formato_basico(self):\n136:         \"\"\"Verifica la inserción de punto decimal en formato X.XXXXXX.\"\"\"\n137:         s = pd.Series([\"136965\"])     # Norte de Ecuador: 1.36965\n138:         resultado = reconstruir_escenario_1(s)\n139:         assert resultado.iloc[0] == \"1.36965\"\n140: \n141:     def test_multiples_valores(self):\n142:         \"\"\"Verifica la reconstrucción de múltiples registros.\"\"\"\n143:         s = pd.Series([\"3516\", \"9592\", \"123456\"])\n144:         resultado = reconstruir_escenario_1(s)\n145:         assert resultado.iloc[0] == \"3.516\"\n146:         assert resultado.iloc[1] == \"9.592\"\n147:         assert resultado.iloc[2] == \"1.23456\"\n148: \n149:     def test_cadena_corta(self):\n150:         \"\"\"Verifica comportamiento con cadena de un solo dígito.\"\"\"\n151:         s = pd.Series([\"1\"])\n152:         resultado = reconstruir_escenario_1(s)\n153:         assert resultado.iloc[0] == \"1.\"\n154: \n155:     def test_resultado_es_string(self):\n156:         \"\"\"Verifica que el resultado sea una Serie de strings.\"\"\"\n157:         s = pd.Series([\"123456\"])\n158:         resultado = reconstruir_escenario_1(s)\n159:         # En pandas clásico las columnas de texto tienen dtype `object`.\n160:         assert resultado.dtype == object  # dtype string en pandas\n161: \n162: \n163: class TestReconstruccionEscenario2:\n164:     \"\"\"Tests del Escenario 2: 0.XXXXXX (positivo cerca del ecuador).\"\"\"\n165: \n166:     def test_formato_basico(self):\n167:         \"\"\"Verifica la inserción de '0.' como prefijo.\"\"\"\n168:         s = pd.Series([\"9592\"])     # Esmeraldas: 0.9592\n169:         resultado = reconstruir_escenario_2(s)\n170:         assert resultado.iloc[0] == \"0.9592\"\n171: \n172:     def test_quito_norte_ecuatorial(self):\n173:         \"\"\"Verifica coordenada positiva muy cercana al ecuador.\"\"\"\n174:         s = pd.Series([\"01807\"])    # +0.01807 cerca de la línea\n175:         resultado = reconstruir_escenario_2(s)\n176:         assert resultado.iloc[0] == \"0.01807\"\n177: \n178:     def test_multiples_valores(self):\n179:         \"\"\"Verifica múltiples registros simultáneamente.\"\"\"\n180:         s = pd.Series([\"5000\", \"1234\"])\n181:         resultado = reconstruir_escenario_2(s)\n182:         assert resultado.iloc[0] == \"0.5000\"\n183:         assert resultado.iloc[1] == \"0.1234\"\n184: \n185: \n186: class TestReconstruccionEscenario3:\n187:     \"\"\"Tests del Escenario 3: -X.XXXXXX (latitud negativa sur) ← CRÍTICO.\"\"\"\n188: \n189:     def test_guayaquil(self):\n190:         \"\"\"Verifica la reconstrucción para Guayaquil (-2.1894).\"\"\"\n191:         s = pd.Series([\"21894\"])\n192:         resultado = reconstruir_escenario_3(s)\n193:         assert resultado.iloc[0] == \"-2.1894\"\n194: \n195:     def test_cuenca(self):\n196:         \"\"\"Verifica la reconstrucción para Cuenca (-2.8970).\"\"\"\n197:         s = pd.Series([\"28970\"])\n198:         resultado = reconstruir_escenario_3(s)\n199:         assert resultado.iloc[0] == \"-2.8970\"\n200: \n201:     def test_inserta_signo_negativo(self):\n202:         \"\"\"Verifica que el signo negativo se inserte correctamente.\"\"\"\n203:         s = pd.Series([\"123456\"])\n204:         resultado = reconstruir_escenario_3(s)\n205:         # .startswith(\"-\") → True si empieza con signo menos; `\".\" in texto` → True si contiene punto.\n206:         assert resultado.iloc[0].startswith(\"-\")\n207:         assert \".\" in resultado.iloc[0]\n208: \n209:     def test_formato_completo(self):\n210:         \"\"\"Verifica la estructura completa '-X.XXXXXX'.\"\"\"\n211:         s = pd.Series([\"497407\"])\n212:         resultado = reconstruir_escenario_3(s)\n213:         assert resultado.iloc[0] == \"-4.97407\"\n214: \n215:     def test_multiples_valores(self):\n216:         \"\"\"Verifica múltiples registros del hemisferio sur.\"\"\"\n217:         s = pd.Series([\"28278\", \"901871\", \"890014\"])\n218:         resultado = reconstruir_escenario_3(s)\n219:         assert resultado.iloc[0] == \"-2.8278\"\n220:         assert resultado.iloc[1] == \"-9.01871\"\n221:         assert resultado.iloc[2] == \"-8.90014\"\n222: \n223: \n224: class TestReconstruccionEscenario4:\n225:     \"\"\"Tests del Escenario 4: -0.XXXXXX (negativo cercano al ecuador).\"\"\"\n226: \n227:     def test_quito_sur_ecuatorial(self):\n228:         \"\"\"Verifica la reconstrucción para cantones cerca de Quito sur.\"\"\"\n229:         s = pd.Series([\"1807\"])     # -0.1807 aproximado\n230:         resultado = reconstruir_escenario_4(s)\n231:         assert resultado.iloc[0] == \"-0.1807\"\n232: \n233:     def test_inserta_prefijo_negativo(self):\n234:         \"\"\"Verifica que '-0.' se inserte como prefijo.\"\"\"\n235:         s = pd.Series([\"2345\"])\n236:         resultado = reconstruir_escenario_4(s)\n237:         assert resultado.iloc[0] == \"-0.2345\"\n238: \n239:     def test_multiples_valores(self):\n240:         \"\"\"Verifica múltiples registros negativos ecuatoriales.\"\"\"\n241:         s = pd.Series([\"5000\", \"999