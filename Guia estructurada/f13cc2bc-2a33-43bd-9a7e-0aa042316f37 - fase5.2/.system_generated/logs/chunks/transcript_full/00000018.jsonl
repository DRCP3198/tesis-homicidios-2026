Scripts\\python.exe -c \"\nimport pandas as pd, geopandas as gpd\ndf = pd.read_parquet('data/interim/homi_filtrado_2024.parquet')\nshp = gpd.read_file('data/raw/cartografia/nxcantones.shp').to_crs(epsg=4326)\nshp.geometry = shp.make_valid()\nznd = shp[shp['DPA_DESPRO'] == 'ZONA NO DELIMITADA']\ngdf = gpd.GeoDataFrame(df, geometry=gpd.points_from_xy(pd.to_numeric(df['longitud'], errors='coerce'), pd.to_numeric(df['latitud'], errors='coerce')), crs='EPSG:4326')\nsj = gpd.sjoin(gdf, znd[['DPA_DESCAN', 'geometry']], how='inner', predicate='intersects')\nprint(sj[sj['DPA_DESCAN'] == 'LAS GOLONDRINAS'][['codigo_caso', 'fecha_hecho', 'anio_hecho', 'provincia', 'canton', 'latitud', 'longitud']].to_string())\nprint('\\nCantones de IMBABURA en todo el CSV:')\nprint(df[df['provincia'] == 'IMBABURA']['canton'].value_counts())\n\"","WaitMsBeforeAsync":8000,"toolSummary":"Inspect Las Golondrinas records in Imbabura"}}]}
