repositorio_carto <- "D:/R/preprocesamiento_datos_limpio/preprocesamiento_datos/datos_homicidios/HOMICIDIOS-2025/Provincias_Cantones_Parroquias"
## Variables asignadas a columnas e ingresos
# Centralizamos los nombres de los archivos y las columnas crudas de la base de datos original.
# Si el proveedor de los datos cambia el nombre de la columna "X133" en el futuro, solo se corrige aquí una vez.
nombre_archibo_original_rds <- "base_homi_2010_2025_original.rds"
COLUMNA_CANTON <- "X133" # Nombre técnico de la columna de texto que contiene originalmente los Cantones.
COLUMNA_ANIO <- "anio"      # Nombre de la columna de texto que contiene el año del registro.
## Fijar directorio principal
# setwd() le dice a R cuál es tu carpeta de trabajo por defecto. Toda lectura o guardado de archivos
